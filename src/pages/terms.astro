---
import Footer from '../components/Footer.astro';
import { type SupportedLanguage } from '../utils/i18n';

import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout lang={lang} 
  title="Terms & Conditions | DevSubnet – Free IP Subnet Calculator Utility"
  description="Terms of service and acceptable use policy for DevSubnet's free IP subnet calculator and CIDR tools. Complete rules for utility usage, AdSense disclosures, DMCA takedown procedures, and liability disclaimers."
>
  <div class="app-shell">
    <NavBar lang={lang} path='terms' />

    <main class="page-main">
      <div class="content-container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={lang === 'en' ? '/' : `/${lang}/`}>Home</a> <span class="sep">/</span> <strong>Terms & Conditions</strong>
        </nav>

        <section class="page-header">
          <div class="eyebrow">TERMS OF SERVICE</div>
          <h1>Terms & Conditions</h1>
          <p class="lede">
            Last updated: September 2, 2026. Fair and transparent terms governing the use of devsubnet.com.
          </p>
        </section>

        <section class="page-body">
          <div class="policy-block">
            <h2>1. Acceptance of Terms</h2>
            <p>
              By accessing, browsing, or utilizing devsubnet.com ("the Website"), you acknowledge that you have read, understood, and agree to be bound by these Terms & Conditions. If you do not accept these terms in their entirety, you must cease using the Website immediately.
            </p>
          </div>

          <div class="policy-block">
            <h2>2. Permitted & Acceptable Use</h2>
            <p>
              devsubnet.com provides web-based calculation tools, visual subnet splitters, CIDR calculators, Kubernetes Pod density planners, and Infrastructure as Code (IaC) configuration generators for educational, personal, and professional networking purposes.
            </p>
            <ul class="policy-list">
              <li><strong>Permitted Use:</strong> You may freely perform network calculations, export generated HCL/YAML code snippets, and link to our calculators in technical documentation or courses.</li>
              <li><strong>Prohibited Conduct:</strong> You agree not to perform automated scraping, launch denial-of-service (DDoS) attacks, inject malicious payloads, or attempt to bypass site infrastructure rate limits or security controls.</li>
            </ul>
          </div>

          <div class="policy-block">
            <h2>3. Third-Party Advertisements & Google AdSense</h2>
            <p>
              devsubnet.com is funded through advertisements served by <strong>Google AdSense</strong> and authorized ad exchanges.
            </p>
            <ul class="policy-list">
              <li>Advertisements are delivered by third-party ad networks and do not represent an endorsement, guarantee, or warranty by devsubnet.com.</li>
              <li>Interacting with third-party ads or external links directs you to third-party domains governed by their respective privacy policies and terms of service.</li>
              <li>We hold no responsibility for products, software, or services promoted by third-party ad providers.</li>
            </ul>
          </div>

          <div class="policy-block">
            <h2>4. Intellectual Property & Open Source Licensing</h2>
            <p>
              The devsubnet.com web interface design, visual branding, domain name, logos, and custom web components are protected by copyright and intellectual property laws. The core calculation algorithms and open-source codebase are hosted on GitHub. You may inspect, report issues, or contribute under the terms of the repository's open-source license.
            </p>
          </div>

          <div class="policy-block">
            <h2>5. Trademarks & Non-Affiliation Disclaimer</h2>
            <p>
              Amazon Web Services (AWS), Microsoft Azure, Google Cloud Platform (GCP), Kubernetes, Terraform, Cilium, and Calico are registered trademarks of their respective owners. devsubnet.com is an independent developer utility and is not affiliated with, endorsed by, sponsored by, or associated with Amazon.com Inc., Microsoft Corporation, Google LLC, The Linux Foundation, or HashiCorp Inc.
            </p>
          </div>

          <div class="policy-block">
            <h2>6. Disclaimer of Warranties & Production Verification</h2>
            <p>
              devsubnet.com is provided strictly on an "AS IS" and "AS AVAILABLE" basis without warranties of any kind, whether express, implied, or statutory.
            </p>
            <ul class="policy-list">
              <li>While we maintain rigorous test suites based on IETF RFC standards, we do not warrant that calculations will be error-free or uninterrupted.</li>
              <li><strong>Production Network Caution:</strong> Users are solely responsible for double-checking subnet ranges, CIDR masks, and IaC blocks prior to applying them in live cloud or physical enterprise networks.</li>
            </ul>
          </div>

          <div class="policy-block">
            <h2>7. Limitation of Liability</h2>
            <p>
              To the fullest extent permitted by applicable law, devsubnet.com, its developers, operators, and contributors shall not be liable for any direct, indirect, incidental, special, or consequential damages (including, but not limited to, misallocated IP blocks, cloud routing errors, network downtime, lost profits, or data loss) resulting from the use of or inability to use our tools.
            </p>
          </div>

          <div class="policy-block">
            <h2>8. DMCA & Copyright Takedown Policy</h2>
            <p>
              We respect the intellectual property of others. If you believe any content on devsubnet.com infringes upon your copyright, please submit a formal DMCA Takedown Notice to <a href="mailto:legal@devsubnet.com">legal@devsubnet.com</a> or <a href="mailto:support@devsubnet.com">support@devsubnet.com</a> with the following details:
            </p>
            <ul class="policy-list">
              <li>Identification of the copyrighted work claimed to have been infringed.</li>
              <li>Exact URL or description of the location of the allegedly infringing material.</li>
              <li>Your contact details (name, email address, physical address).</li>
              <li>A statement of good-faith belief that the use is not authorized by the copyright owner.</li>
            </ul>
          </div>

          <div class="policy-block">
            <h2>9. Updates to Terms & Governing Law</h2>
            <p>
              We reserve the right to amend these Terms & Conditions at any time. Revisions become effective immediately upon being published on this page. Your continued use of devsubnet.com constitutes acceptance of all updated terms. For legal inquiries, contact <a href="mailto:legal@devsubnet.com">legal@devsubnet.com</a> or use our <a href="/contact">Contact Page</a>.
            </p>
          </div>
        </section>

        <div class="page-cta">
          <a href="/" class="btn-return">← Return to Calculator</a>
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<style>
  .page-main {
    flex: 1;
    padding: 3rem 1.5rem 5rem;
  }

  .content-container {
    max-width: 54rem;
    margin: 0 auto;
    text-align: left;
  }

  .breadcrumb {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }

  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb .sep { color: var(--text-secondary); }

  .page-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2.5rem;
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .page-header .lede {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 40rem;
    margin: 0;
  }

  .page-header .eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .page-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .policy-block h2 {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
    color: var(--text-primary);
  }

  .policy-block p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
  }

  .policy-block a {
    color: var(--accent);
    text-decoration: none;
  }

  .policy-block a:hover {
    text-decoration: underline;
  }

  .policy-list {
    margin: 0.75rem 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .policy-list li {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .policy-list strong {
    color: var(--text-primary);
  }

  .page-cta {
    margin-top: 3.5rem;
  }

  .btn-return {
    display: inline-block;
    background: var(--text-primary);
    color: var(--bg-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .btn-return:hover { opacity: 0.85; }

  /* Theme Toggle */
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .theme-toggle:hover {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
  }

  .theme-toggle .sun { display: none; width: 1.25rem; height: 1.25rem; }
  .theme-toggle .moon { display: block; width: 1.25rem; height: 1.25rem; }

  :root[data-theme="light"] .theme-toggle .sun  { display: block; }
  :root[data-theme="light"] .theme-toggle .moon { display: none; }
</style>

<script>
  const themeBtn = document.getElementById('theme-btn');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const doc = document.documentElement;
      const next = doc.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      doc.setAttribute('data-theme', next);
      localStorage.setItem('devsubnet-theme', next);
    });
  }
</script>
