---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
---

<Layout 
  title="Contact DevSubnet – Feedback & Support"
  description="Contact the DevSubnet team with questions, feedback, or feature suggestions about our free IP subnet calculator and CIDR planning tools. We'd love to hear from you."
>
  <div class="app-shell">
    <NavBar path='contact' />

    <main class="page-main">
      <div class="content-container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span class="sep">/</span> <strong>Contact Us</strong>
        </nav>

        <section class="page-header">
          <div class="eyebrow">GET IN TOUCH</div>
          <h1>Contact Us</h1>
          <p class="lede">
            Have feedback, bug reports, or feature requests? Drop us a line below.
          </p>
        </section>

        <section class="page-body">
          <div class="contact-grid">
            <div class="contact-info">
              <h2>Other Ways to Reach Us</h2>
              <p>
                We welcome suggestions for new calculators, IaC integrations (like Ansible or Terraform templates), or interface improvements.
              </p>
                <div class="info-list">
                  <div class="info-item">
                    <strong>Email:</strong>
                    <span>support@devsubnet.com</span>
                  </div>
                <div class="info-item">
                  <strong>GitHub:</strong>
                  <a href="https://github.com/ammyskamble/devsubnet" target="_blank" rel="noopener noreferrer">ammyskamble/devsubnet</a>
                </div>
              </div>
            </div>

            <div class="form-container">
              <form id="contact-form">
                <div class="form-group">
                  <label for="name">Name</label>
                  <input type="text" id="name" required placeholder="Your name" />
                </div>
                
                <div class="form-group">
                  <label for="email">Email</label>
                  <input type="email" id="email" required placeholder="Your email address" />
                </div>

                <div class="form-group">
                  <label for="subject">Subject</label>
                  <select id="subject">
                    <option>General Feedback</option>
                    <option>Feature Request</option>
                    <option>Bug Report</option>
                    <option>Other</option>
                  </select>
                </div>

                <div class="form-group">
                  <label for="message">Message</label>
                  <textarea id="message" rows="5" required placeholder="Tell us how we can help..."></textarea>
                </div>

                <button type="submit" class="btn-submit">Send Message</button>
                <div id="form-status" class="form-status"></div>
              </form>
            </div>
          </div>
        </section>

        <div class="page-cta">
          <a href="/" class="btn-return">← Return to Calculator</a>
        </div>
      </div>
    </main>

    <footer>
      <span>DEVSUBNET.COM / ENGINEERED FOR CLEAR NETWORKS</span>
      <div class="footer-links">
        <a href="/about">About Us</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms & Conditions</a>
        <a href="/faq">FAQ</a>
      </div>
      <span>NO DATA LEAVES YOUR DEVICE</span>
    </footer>
  </div>
</Layout>

<style>
  .page-main {
    flex: 1;
    padding: 3rem 1.5rem 5rem;
  }

  .content-container {
    max-width: 54rem;
    margin: 0 auto;
    text-align: left;
  }

  .breadcrumb {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }

  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb .sep { color: var(--text-secondary); }

  .page-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2.5rem;
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .page-header .lede {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 40rem;
    margin: 0;
  }

  .page-header .eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
  }

  .contact-info h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 1rem;
    color: var(--text-primary);
  }

  .contact-info p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-item {
    font-size: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .info-item strong {
    color: var(--text-primary);
  }

  .info-item span, .info-item a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .info-item a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .form-container {
    background-color: var(--card-bg, rgba(255, 255, 255, 0.02));
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-group input, .form-group select, .form-group textarea {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(var(--hsl-accent), 0.15);
  }

  .btn-submit {
    width: 100%;
    background-color: var(--text-primary);
    color: var(--bg-primary);
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }

  .btn-submit:hover {
    opacity: 0.9;
  }

  .form-status {
    margin-top: 1rem;
    font-size: 0.85rem;
    text-align: center;
    font-family: var(--font-mono);
  }

  .form-status.success {
    color: var(--accent-success, #10b981);
  }

  .page-cta {
    margin-top: 3.5rem;
  }

  .btn-return {
    display: inline-block;
    background: var(--text-primary);
    color: var(--bg-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .btn-return:hover { opacity: 0.85; }

  /* Theme Toggle */
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .theme-toggle:hover {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
  }

  .theme-toggle .sun { display: none; width: 1.25rem; height: 1.25rem; }
  .theme-toggle .moon { display: block; width: 1.25rem; height: 1.25rem; }

  :root[data-theme="light"] .theme-toggle .sun  { display: block; }
  :root[data-theme="light"] .theme-toggle .moon { display: none; }
</style>

<script>
  // Contact form submission visual handler
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  if (form && status) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      status.className = 'form-status success';
      status.textContent = 'Message sent successfully! (Local simulation)';
      form.reset();
    });
  }

  // Theme toggle
  const themeBtn = document.getElementById('theme-btn');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const doc = document.documentElement;
      const next = doc.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      doc.setAttribute('data-theme', next);
      localStorage.setItem('devsubnet-theme', next);
    });
  }
</script>
