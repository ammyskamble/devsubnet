    // Helper functions for categorization
    function getCategory(urlStr: string): string {
      const lower = urlStr.toLowerCase();
      // Assets / Media
      if (
        lower.endsWith('.png') || lower.endsWith('.jpg') || lower.endsWith('.jpeg') ||
        lower.endsWith('.webp') || lower.endsWith('.svg') || lower.endsWith('.gif') ||
        lower.endsWith('.css') || lower.endsWith('.js') || lower.endsWith('.woff') ||
        lower.endsWith('.woff2') || lower.endsWith('.ttf') || lower.endsWith('.pdf') ||
        lower.endsWith('.zip') || lower.includes('/assets/')
      ) {
        return 'assets';
      }
      
      // API / Query / Dynamic
      if (lower.includes('/api/') || lower.includes('/graphql') || lower.includes('?')) {
        return 'api';
      }

      // Blog
      if (lower.includes('/blog') || lower.includes('/post') || lower.includes('/article') || lower.includes('/news')) {
        return 'blog';
      }

      // Products
      if (lower.includes('/product') || lower.includes('/shop') || lower.includes('/store') || lower.includes('/item') || lower.includes('/pricing')) {
        return 'products';
      }

      // Docs
      if (lower.includes('/docs') || lower.includes('/guide') || lower.includes('/wiki') || lower.includes('/help') || lower.includes('/faq')) {
        return 'docs';
      }

      // Static & Legal
      if (
        lower.includes('/about') || lower.includes('/contact') || lower.includes('/privacy') ||
        lower.includes('/terms') || lower.includes('/legal') || lower.includes('/team') ||
        lower.includes('/career') || lower.includes('/tos')
      ) {
        return 'legal';
      }

      return 'general';
    }

    function extractUrls(): string[] {
      let urls: string[] = [];
      const text = inputArea.value;

      if (currentMode === 'sitemap') {
        const locRegex = new RegExp('\\x3cloc\\x3e(https?:\\/\\/[^\\s\\x3c]+)\\x3c\\/loc\\x3e', 'gi');
        let match;
        while ((match = locRegex.exec(text)) !== null) {
          urls.push(match[1]);
        }
      } else if (currentMode === 'list') {
        urls = text.split('\n')
          .map(line => line.trim())
          .filter(line => line.length > 0);
      } else if (currentMode === 'html') {
        // Extract href from links/anchors
        const hrefRegex = new RegExp('href=["\'](https?:\\/\\/[^"\']+|\\/[^"\']*)["\']', 'gi');
        let match;
        while ((match = hrefRegex.exec(text)) !== null) {
          urls.push(match[1]);
        }
        // Extract src from script/images
        const srcRegex = new RegExp('src=["\'](https?:\\/\\/[^"\']+|\\/[^"\']*)["\']', 'gi');
        while ((match = srcRegex.exec(text)) !== null) {
          urls.push(match[1]);
        }
      }
      return urls;
    }

    function runAnalysis(rawUrls: string[]) {
      if (rawUrls.length === 0) {
        alert('No URLs found to analyze. Please check your inputs or click "Load Demo Example" to load mock data.');
        return;
      }

      analyzedData = [];
      categories = {
        blog: [],
        products: [],
        docs: [],
        legal: [],
        assets: [],
        api: [],
        general: []
      };
      auditIssues = [];

      // Clean and normalize URLs
      const uniqueRaw = Array.from(new Set(rawUrls));
      const baseDomain = detectBaseDomain(uniqueRaw);

      uniqueRaw.forEach(rawUrl => {
        let normalized = rawUrl.trim();
        // Resolve relative paths if possible
        if (normalized.startsWith('/')) {
          normalized = (baseDomain ? baseDomain : 'https://example.com') + normalized;
        }

        try {
          const parsed = new URL(normalized);
          const path = parsed.pathname;
          
          // Folder depth
          const cleanPath = path.replace(/\/$/, '').replace(/^\//, '');
          const depth = cleanPath ? cleanPath.split('/').length : 0;

          const category = getCategory(normalized);

          const item: URLData = {
            url: normalized,
            normalized: normalized,
            path: path,
            category: category,
            depth: depth,
            issues: []
          };

          analyzedData.push(item);
          if (categories[category]) {
            categories[category].push(item);
          } else {
            categories.general.push(item);
          }
        } catch (e) {
          // Fallback if not a valid absolute URL
          const depth = rawUrl.replace(/\/$/, '').replace(/^\//, '').split('/').length;
          const category = getCategory(rawUrl);
          const item: URLData = {
            url: rawUrl,
            normalized: rawUrl,
            path: rawUrl,
            category: category,
            depth: depth,
            issues: []
          };
          analyzedData.push(item);
          if (categories[category]) {
            categories[category].push(item);
          } else {
            categories.general.push(item);
          }
        }
      });

      // Analyze Audit Issues
      let healthScore = 100;
      let mixedTrailingSlashesCount = 0;
      const htmlTrailingSlashes = new Set<boolean>();

      analyzedData.forEach(item => {
        // Critical: HTTP links
        if (item.url.startsWith('http://')) {
          item.issues.push('Unsecure HTTP Connection');
          auditIssues.push({
            type: 'critical',
            title: 'Unsecure HTTP Protocol',
            desc: 'The URL uses unsecure http:// protocol, exposing traffic to interception.',
            rec: 'Redirect to HTTPS, and update all database sitemaps to reference https:// URLs.',
            url: item.url
          });
          healthScore -= 10;
        }

        // Critical: Secrets leak in query params
        if (item.url.includes('?')) {
          const lower = item.url.toLowerCase();
          if (
            lower.includes('api_key') || lower.includes('apikey') || lower.includes('token') ||
            lower.includes('secret') || lower.includes('auth') || lower.includes('password')
          ) {
            item.issues.push('Sensitive Token Exposed in URL');
            auditIssues.push({
              type: 'critical',
              title: 'Credential Exposure in Query Params',
              desc: 'Sensitive keys, secrets, or API tokens were detected in the query parameters. URLs are logged in plain-text across routing hops, browser history, and CDN nodes.',
              rec: 'Pass credentials via HTTP Authorization headers or POST bodies, never via URL query parameters.',
              url: item.url
            });
            healthScore -= 15;
          }
        }

        // Warning: Deep nesting
        if (item.depth > 4) {
          item.issues.push('Excessive Directory Nesting');
          auditIssues.push({
            type: 'warning',
            title: 'Deep Nesting (>4 folders)',
            desc: `This URL is nested ${item.depth} folders deep. Search engine crawl budgets penalize overly nested paths, reducing organic discovery speed.`,
            rec: 'Refactor URL rewrite logic to keep important page routes shallow (under 4 folders deep).',
            url: item.url
          });
          healthScore -= 5;
        }

        // Warning: Extremely Long URLs
        if (item.url.length > 75) {
          item.issues.push('Extremely Long URL (>75 characters)');
          auditIssues.push({
            type: 'warning',
            title: 'Excessive URL Length',
            desc: `This URL is ${item.url.length} characters long. Search engines prefer clean, human-readable URLs.`,
            rec: 'Shorten category structures and slug lengths to keep URLs concise and semantic.',
            url: item.url
          });
          healthScore -= 3;
        }

        // Warning: Old media format
        const lowerUrl = item.url.toLowerCase();
        if (
          (lowerUrl.endsWith('.png') || lowerUrl.endsWith('.jpg') || lowerUrl.endsWith('.jpeg')) &&
          !lowerUrl.includes('/logo') // Skip logo
        ) {
          item.issues.push('Legacy Image Format (PNG/JPG)');
          auditIssues.push({
            type: 'warning',
            title: 'Uncompressed Image Asset (PNG/JPG)',
            desc: 'The website references traditional PNG or JPG image formats. This increases payload sizes and load latency.',
            rec: 'Compress assets and convert images to WebP or AVIF formats. Update the sitemap/HTML links to reference WebP/AVIF equivalents.',
            url: item.url
          });
          healthScore -= 3;
        }

        // Info: Unminified Asset
        if (
          (lowerUrl.endsWith('.js') && !lowerUrl.endsWith('.min.js')) ||
          (lowerUrl.endsWith('.css') && !lowerUrl.endsWith('.min.css'))
        ) {
          item.issues.push('Unminified Static Asset');
          auditIssues.push({
            type: 'info',
            title: 'Unminified Code Asset',
            desc: 'The website references unminified JS or CSS files. This increases payload size.',
            rec: 'Integrate compression or minification steps in your build/bundling pipeline (e.g. using Esbuild/Terser) to output min.js / min.css files.',
            url: item.url
          });
          healthScore -= 1;
        }

        // Check for mixed trailing slashes
        if (item.category !== 'assets' && item.category !== 'api') {
          const pathOnly = item.path.split('?')[0];
          if (pathOnly && pathOnly !== '/') {
            const hasTrailing = pathOnly.endsWith('/');
            htmlTrailingSlashes.add(hasTrailing);
          }
        }
      });

      // Warning: Mixed Trailing Slashes
      if (htmlTrailingSlashes.size > 1) {
        auditIssues.push({
          type: 'warning',
          title: 'Mixed Slashes (SEO Duplicate Page Risk)',
          desc: 'The URL set contains a mix of paths ending in a trailing slash and paths without it. Search engines treat /about/ and /about as distinct pages, risking duplicate content penalties.',
          rec: 'Configure your web server (Nginx/Cloudflare Page Rules) to strictly enforce either trailing slashes or no slashes domain-wide.'
        });
        healthScore -= 5;
      }

      // Keep health score between 0 and 100
      healthScore = Math.max(0, Math.min(100, healthScore));

      // 1. Hide placeholder and show dashboard
      if (placeholder) placeholder.style.display = 'none';
      if (resultsContainer) resultsContainer.style.display = 'flex';

      // 2. Render KPIs
      if (totalLinksEl) totalLinksEl.textContent = String(analyzedData.length);
      const maxDepth = analyzedData.reduce((max, item) => Math.max(max, item.depth), 0);
      if (maxDepthEl) maxDepthEl.textContent = String(maxDepth);
      if (issuesCountEl) {
        issuesCountEl.textContent = String(auditIssues.length);
        if (auditIssues.length > 0) {
          issuesCountEl.className = 'stat-num text-warning';
        } else {
          issuesCountEl.className = 'stat-num text-success';
        }
      }
      if (healthScoreEl) {
        healthScoreEl.textContent = `${healthScore}%`;
        if (healthScore >= 90) healthScoreEl.className = 'stat-num text-success';
        else if (healthScore >= 70) healthScoreEl.className = 'stat-num text-warning';
        else healthScoreEl.className = 'stat-num text-danger';
      }

      // 3. Render Categorical Distribution Chart
      renderDistributionChart();

      // 4. Render Segregated Groups Lists
      renderCategorizedList();

      // 5. Render Audit Issues List
      renderAuditIssues();

      // 6. Render Directory Tree
      renderDirectoryTree();
    }

    function detectBaseDomain(urls: string[]): string {
      for (const u of urls) {
        if (u.startsWith('http://') || u.startsWith('https://')) {
          try {
            const parsed = new URL(u);
            return parsed.origin;
          } catch(e) {}
        }
      }
      return '';
    }

    function renderDistributionChart() {
      if (!distBar || !distLegend) return;
      distBar.innerHTML = '';
      distLegend.innerHTML = '';

      const total = analyzedData.length;
      if (total === 0) return;

      const catMeta: Record<string, { label: string; class: string; color: string }> = {
        blog: { label: 'Blog / Content', class: 'dist-blog', color: '#34d399' },
        products: { label: 'Products', class: 'dist-product', color: '#fb923c' },
        docs: { label: 'Docs / Guides', class: 'dist-docs', color: '#60a5fa' },
        legal: { label: 'Static / Legal', class: 'dist-legal', color: '#a78bfa' },
        assets: { label: 'Assets', class: 'dist-asset', color: '#e879f9' },
        api: { label: 'API / Dynamic', class: 'dist-api', color: '#f43f5e' },
        general: { label: 'General Pages', class: 'dist-general', color: '#9ca3af' }
      };

      Object.keys(categories).forEach(catKey => {
        const count = categories[catKey].length;
        if (count === 0) return;

        const pct = (count / total) * 100;

        // Add segment to bar
        const segment = document.createElement('div');
        segment.className = `dist-segment ${catMeta[catKey].class}`;
        segment.style.width = `${pct}%`;
        segment.title = `${catMeta[catKey].label}: ${count} URLs (${pct.toFixed(1)}%)`;
        distBar.appendChild(segment);

        // Add legend item
        const legendItem = document.createElement('div');
        legendItem.className = 'legend-item';
        legendItem.innerHTML = `
          <span class="legend-color" style="background-color: ${catMeta[catKey].color};"></span>
          <span>${catMeta[catKey].label} (${count})</span>
        `;
        distLegend.appendChild(legendItem);
      });
    }

    function renderCategorizedList() {
      if (!categoriesContainer) return;
      categoriesContainer.innerHTML = '';

      const catMeta: Record<string, { label: string; badge: string }> = {
        blog: { label: 'Blog & Editorial', badge: 'blog-badge' },
        products: { label: 'Products & Services', badge: 'product-badge' },
        docs: { label: 'Documentation & Guides', badge: 'docs-badge' },
        legal: { label: 'Static & Legal Pages', badge: 'legal-badge' },
        assets: { label: 'Assets & Media files', badge: 'asset-badge' },
        api: { label: 'API & Query Endpoints', badge: 'api-badge' },
        general: { label: 'Uncategorized General Pages', badge: 'general-badge' }
      };

      Object.keys(categories).forEach((catKey, index) => {
        const items = categories[catKey];
        if (items.length === 0) return;

        const group = document.createElement('div');
        group.className = 'cat-group' + (index === 0 ? ' open' : '');

        group.innerHTML = `
          <button class="cat-header" type="button" aria-expanded="${index === 0 ? 'true' : 'false'}">
            <span class="cat-header-title">
              <span class="badge ${catMeta[catKey].badge}">${catKey}</span>
              <span>${catMeta[catKey].label}</span>
            </span>
            <span class="cat-header-meta">
              <span>${items.length} URL${items.length > 1 ? 's' : ''}</span>
              <svg class="cat-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </span>
          </button>
          <div class="cat-body">
            <table class="url-table">
              <thead>
                <tr>
                  <th>URL Path / Path</th>
                  <th>Folder Slashes</th>
                  <th>Status / Issues</th>
                </tr>
              </thead>
              <tbody>
                ${items.map(item => `
                  <tr>
                    <td class="url-cell">${item.url}</td>
                    <td style="font-family: var(--font-mono); color: var(--text-secondary); text-align: center;">${item.depth}</td>
                    <td>
                      ${item.issues.length > 0 
                        ? `<span style="color: #fb923c; font-weight:600; display: inline-flex; gap: 0.2rem; align-items:center;">
                             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                             ${item.issues.length} Alert${item.issues.length > 1 ? 's' : ''}
                           </span>` 
                        : '<span style="color: #34d399; font-weight:600;">✓ Healthy</span>'
                      }
                    </td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        `;

        // Toggle handler
        const header = group.querySelector('.cat-header');
        header?.addEventListener('click', () => {
          const isOpen = group.classList.toggle('open');
          header.setAttribute('aria-expanded', String(isOpen));
        });

        categoriesContainer.appendChild(group);
      });
    }

    function renderAuditIssues() {
      if (!auditContainer) return;
      auditContainer.innerHTML = '';

      if (auditIssues.length === 0) {
        auditContainer.innerHTML = `
          <div class="no-issues-banner">
            <h4>Awesome! Zero Issues Detected</h4>
            <p>Your sitemap and path structure comply with clean URL, secure protocol, and SEO folder nesting practices.</p>
          </div>
        `;
        return;
      }

      auditIssues.forEach(issue => {
        const card = document.createElement('div');
        card.className = `issue-card issue-${issue.type}`;

        let iconMarkup = '';
        if (issue.type === 'critical') {
          iconMarkup = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`;
        } else if (issue.type === 'warning') {
          iconMarkup = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`;
        } else {
          iconMarkup = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`;
        }

        card.innerHTML = `
          <div class="issue-icon">${iconMarkup}</div>
          <div class="issue-details">
            <h4>${issue.title}</h4>
            <p>${issue.desc}</p>
            <div class="issue-rec"><strong>Optimization recommendation:</strong> ${issue.rec}</div>
            ${issue.url ? `<div class="issue-url">${issue.url}</div>` : ''}
          </div>
        `;

        auditContainer.appendChild(card);
      });
    }

    function renderDirectoryTree() {
      if (!treeContainer) return;
      treeContainer.innerHTML = '';

      // Build tree object from paths
      const rootNode: URLNode = {};

      analyzedData.forEach(item => {
        let cleanPath = item.path;
        // Parse the path
        if (cleanPath.startsWith('http://') || cleanPath.startsWith('https://')) {
          try {
            const p = new URL(cleanPath);
            cleanPath = p.pathname;
          } catch(e) {}
        }
        
        const parts = cleanPath.split('/').map(p => p.trim()).filter(p => p.length > 0);
        
        let currentNode = rootNode;
        parts.forEach((part, i) => {
          if (i === parts.length - 1) {
            // It is a leaf page
            if (!currentNode._files) {
              currentNode._files = [];
            }
            if (!currentNode._files.includes(part)) {
              currentNode._files.push(part);
            }
          } else {
            // It is a directory node
            if (!currentNode[part]) {
              currentNode[part] = {};
            }
            currentNode = currentNode[part];
          }
        });
      });

      // Recursive tree builder
      function buildHTMLTree(node: URLNode, name: string): string {
        let html = '';
        const keys = Object.keys(node).filter(k => k !== '_files');
        const files = node._files || [];

        const folderIcon = `<svg class="tree-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" style="color: var(--accent-network);"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>`;
        const fileIcon = `<svg class="tree-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" style="color: var(--text-secondary);"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg>`;

        if (name) {
          html += `<details class="tree-folder" open>
            <summary>${folderIcon} ${name}</summary>`;
        }

        // Render sub-folders first
        keys.forEach(k => {
          html += buildHTMLTree(node[k], k);
        });

        // Render files inside folder
        files.forEach(f => {
          html += `<span class="tree-file">${fileIcon} ${f || '/'}</span>`;
        });

        if (name) {
          html += `</details>`;
        }
        return html;
      }

      const rootHTML = buildHTMLTree(rootNode, '/ (root domain)');
      treeContainer.innerHTML = rootHTML;
    }

    if (runBtn) {
      runBtn.addEventListener('click', async () => {
        if (currentMode === 'scan') {
          const urlVal = urlInput ? urlInput.value.trim() : '';
          if (!urlVal) {
            alert('Please enter a website URL.');
            return;
          }

          // Use CORS proxy via Allorigins
          const proxyUrl = `https://api.allorigins.win/raw?url=${encodeURIComponent(urlVal)}`;
          
          runBtn.disabled = true;
          runBtn.textContent = 'Crawling sitemap...';

          try {
            const resp = await fetch(proxyUrl);
            if (!resp.ok) throw new Error('Proxy crawl failed');
            const dataStr = await resp.text();
            
            // Check if XML sitemap
            const locRegex = new RegExp('\\x3cloc\\x3e(https?:\\/\\/[^\\s\\x3c]+)\\x3c\\/loc\\x3e', 'gi');
            const matches = [];
            let m;
            while ((m = locRegex.exec(dataStr)) !== null) {
              matches.push(m[1]);
            }

            if (matches.length > 0) {
              // It is a sitemap
              runAnalysis(matches);
            } else {
              // Parse links in HTML
              const hrefRegex = new RegExp('href=["\'](https?:\\/\\/[^"\']+|\\/[^"\']*)["\']', 'gi');
              const htmlMatches = [];
              while ((m = hrefRegex.exec(dataStr)) !== null) {
                htmlMatches.push(m[1]);
              }
              
              if (htmlMatches.length > 0) {
                runAnalysis(htmlMatches);
              } else {
                throw new Error('No links or sitemaps detected in URL payload.');
              }
            }
          } catch (e: any) {
            console.error(e);
            alert(`CORS request failed or blocked: ${e.message}. \n\nSecurity policies often restrict scraping from browsers. Please select 'Sitemap XML' or 'HTML Source' mode, copy-paste the code manually, and try again.`);
          } finally {
            runBtn.disabled = false;
            runBtn.textContent = 'Analyze Website';
          }
        } else {
          // Paste modes
          const extracted = extractUrls();
          runAnalysis(extracted);
        }
      });
    }

    // Export downloads
    const dlBtns = document.querySelectorAll('.dl-btn');
    dlBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const format = target.dataset.format;
        if (analyzedData.length === 0) return;

        let content = '';
        let filename = `devsubnet-website-analysis.${format}`;
        let mimeType = 'text/plain';

        if (format === 'json') {
          mimeType = 'application/json';
          content = JSON.stringify({
            total_urls: analyzedData.length,
            categories: Object.keys(categories).reduce((acc, key) => {
              acc[key] = categories[key].map(item => item.url);
              return acc;
            }, {} as Record<string, string[]>),
            audit_issues: auditIssues
          }, null, 2);
        } else if (format === 'csv') {
          mimeType = 'text/csv';
          content = 'URL,Category,Folder Depth,Length,Issues\n' + 
            analyzedData.map(item => {
              const issuesStr = item.issues.join(' | ');
              return `"${item.url}","${item.category}",${item.depth},${item.url.length},"${issuesStr}"`;
            }).join('\n');
        } else {
          // txt file
          content = analyzedData.map(item => item.url).join('\n');
        }

        const blob = new Blob([content], { type: mimeType });
        const dlUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = dlUrl;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(dlUrl);
      });
    });

    // Tab switcher logic
    const tabBtns = document.querySelectorAll('.export-tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        tabBtns.forEach(b => b.classList.remove('active'));
        tabContents.forEach(c => (c as HTMLElement).style.display = 'none');

        const target = e.currentTarget as HTMLButtonElement;
        target.classList.add('active');
        const tabId = target.dataset.tab;
        
        const contentEl = document.getElementById(`tab-${tabId}`);
        if (contentEl) {
          contentEl.style.display = 'block';
        }
      });
    });
  }

  // Bind init functions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWebsiteAnalyzer);
  } else {
    initWebsiteAnalyzer();
  }
  document.addEventListener('astro:page-load', initWebsiteAnalyzer);
</script>
