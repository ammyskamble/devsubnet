---
import Footer from '../components/Footer.astro';
import { type SupportedLanguage } from '../utils/i18n';

import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout lang={lang} 
  title="Privacy Policy | DevSubnet – Client-Side Privacy & Data Protection"
  description="DevSubnet's privacy policy. Learn about our zero server-side network calculation processing, HTML5 local storage usage, Google AdSense third-party cookie disclosures, GDPR/CCPA rights, and privacy controls."
>
  <div class="app-shell">
    <NavBar lang={lang} path='privacy' />

    <main class="page-main">
      <div class="content-container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={lang === 'en' ? '/' : `/${lang}/`}>Home</a> <span class="sep">/</span> <strong>Privacy Policy</strong>
        </nav>

        <section class="page-header">
          <div class="eyebrow">DATA PROTECTION & PRIVACY</div>
          <h1>Privacy Policy</h1>
          <p class="lede">
            Last updated: September 2, 2026. Your network privacy, calculation security, and data transparency are our highest priorities.
          </p>
        </section>

        <section class="page-body">
          <div class="policy-block">
            <h2>1. Zero Server-Side Network Payload Processing</h2>
            <p>
              devsubnet.com is engineered as a client-side web application. All calculations — including IPv4 and IPv6 subnet masking, CIDR conversions, wildcard boundaries, Kubernetes Pod IP density planning, and cloud VPC allocations — occur locally inside your browser's JavaScript engine. We do not collect, transmit, log, or store your IP ranges, subnet blocks, or network configuration payloads on any external server.
            </p>
          </div>

          <div class="policy-block">
            <h2>2. Browser Local Storage Usage</h2>
            <p>
              We do not use persistent tracking cookies for user profiling. We utilize HTML5 <code>localStorage</code> solely to persist user interface settings across sessions:
            </p>
            <ul class="policy-list">
              <li><code>devsubnet-theme</code>: Remembers your preferred color theme (<code>light</code> or <code>dark</code> mode) so your choice is maintained when returning to the site.</li>
            </ul>
          </div>

          <div class="policy-block">
            <h2>3. Google AdSense & Third-Party Advertising Cookies</h2>
            <p>
              To maintain devsubnet.com as a free utility for sysadmins, DevOps engineers, and students worldwide, we partner with <strong>Google AdSense</strong> to display advertisements.
            </p>
            <p style="margin-top: 0.75rem;">
              <strong>Google DART & DoubleClick Cookie Disclosure:</strong> Third-party vendors, including Google, use cookies (such as the DoubleClick cookie) to serve advertisements based on your prior visits to devsubnet.com or other websites across the Internet. Google's use of advertising cookies enables it and its advertising partners to serve ads based on your browsing history.
            </p>
            <p style="margin-top: 0.75rem;">
              <strong>Opting Out of Personalized Advertising:</strong>
            </p>
            <ul class="policy-list">
              <li>You can opt out of personalized Google advertising by visiting <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer">Google Ads Settings</a>.</li>
              <li>You can opt out of third-party vendors' cookies for interest-based advertising by visiting <a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer">AboutAds.info Choices</a> or the <a href="http://www.networkadvertising.org/choices/" target="_blank" rel="noopener noreferrer">Network Advertising Initiative (NAI) Opt-Out Page</a>.</li>
              <li>European users may also visit the <a href="https://www.youronlinechoices.eu/" target="_blank" rel="noopener noreferrer">EDAA Your Online Choices</a> portal to manage ad preferences.</li>
              <li>For more details on cookie management, read our dedicated <a href="/cookie-policy">Cookie Policy</a>.</li>
            </ul>
          </div>

          <div class="policy-block">
            <h2>4. Web Server Access Logs & CDN Diagnostics</h2>
            <p>
              Our web hosting and Content Delivery Network (CDN) providers (e.g., Cloudflare, Vercel) collect standard server access logs when pages are fetched. These technical logs contain basic metrics such as your IP address, browser user-agent string, referring URL, and access timestamp. These logs are used strictly for security monitoring, DDoS prevention, and system diagnostic health, and are never linked to your subnet calculations.
            </p>
          </div>

          <div class="policy-block">
            <h2>5. European General Data Protection Regulation (GDPR / EEA)</h2>
            <p>
              If you reside in the European Economic Area (EEA), United Kingdom, or Switzerland, you possess specific data privacy rights under the GDPR:
            </p>
            <ul class="policy-list">
              <li><strong>Right of Access & Erasure:</strong> You may request access to or deletion of any technical log data maintained by our infrastructure.</li>
              <li><strong>Right to Object & Restrict:</strong> You may object to data processing or withdraw consent for personalized advertising cookies at any time.</li>
              <li><strong>Data Officer Contact:</strong> To exercise your GDPR rights, contact our privacy compliance team at <a href="mailto:privacy@devsubnet.com">privacy@devsubnet.com</a>.</li>
            </ul>
          </div>

          <div class="policy-block">
            <h2>6. California Consumer Privacy Rights (CCPA / CPRA)</h2>
            <p>
              Under the California Consumer Privacy Act (CCPA) and California Privacy Rights Act (CPRA):
            </p>
            <ul class="policy-list">
              <li><strong>No Sale or Sharing of Personal Data:</strong> devsubnet.com does not sell, rent, or trade your personal information or network calculation payloads to third parties.</li>
              <li><strong>Right to Know & Delete:</strong> California residents have the right to request details on personal information collected via analytics or logging and request its erasure.</li>
            </ul>
          </div>

          <div class="policy-block">
            <h2>7. Children's Online Privacy Protection (COPPA)</h2>
            <p>
              devsubnet.com is a technical utility intended for IT professionals, network engineers, sysadmins, and computer science students. We do not knowingly collect personal information from children under 13 years of age. If you believe a child has provided us with personal data, contact us immediately for prompt deletion.
            </p>
          </div>

          <div class="policy-block">
            <h2>8. Trademarks & Non-Affiliation Disclaimer</h2>
            <p>
              devsubnet.com is an independent developer utility tool. Amazon Web Services (AWS), Microsoft Azure, Google Cloud Platform (GCP), Kubernetes, Terraform, Cilium, and Calico are registered trademarks of their respective owners. devsubnet.com is not affiliated with, endorsed by, or sponsored by Amazon.com Inc., Microsoft Corporation, Google LLC, The Linux Foundation, or HashiCorp Inc.
            </p>
          </div>

          <div class="policy-block">
            <h2>9. Privacy Policy Updates & Contact</h2>
            <p>
              We may revise this Privacy Policy periodically to reflect legal, technical, or operational updates. All changes will be published directly on this page. If you have questions regarding this policy, please email us at <a href="mailto:privacy@devsubnet.com">privacy@devsubnet.com</a> or <a href="mailto:support@devsubnet.com">support@devsubnet.com</a>.
            </p>
          </div>
        </section>

        <div class="page-cta">
          <a href="/" class="btn-return">← Return to Calculator</a>
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<style>
  .page-main {
    flex: 1;
    padding: 3rem 1.5rem 5rem;
  }

  .content-container {
    max-width: 54rem;
    margin: 0 auto;
    text-align: left;
  }

  .breadcrumb {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }

  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb .sep { color: var(--text-secondary); }

  .page-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2.5rem;
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .page-header .lede {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 40rem;
    margin: 0;
  }

  .page-header .eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .page-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .policy-block h2 {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
    color: var(--text-primary);
  }

  .policy-block p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
  }

  .policy-block a {
    color: var(--accent);
    text-decoration: none;
  }

  .policy-block a:hover {
    text-decoration: underline;
  }

  .policy-list {
    margin: 0.75rem 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .policy-list li {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .policy-list strong {
    color: var(--text-primary);
  }

  .policy-block code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.85rem;
    background: var(--bg-secondary);
    padding: 0.1em 0.3em;
    border-radius: 4px;
    color: var(--accent);
  }

  .page-cta {
    margin-top: 3.5rem;
  }

  .btn-return {
    display: inline-block;
    background: var(--text-primary);
    color: var(--bg-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .btn-return:hover { opacity: 0.85; }

  /* Theme Toggle */
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .theme-toggle:hover {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
  }

  .theme-toggle .sun { display: none; width: 1.25rem; height: 1.25rem; }
  .theme-toggle .moon { display: block; width: 1.25rem; height: 1.25rem; }

  :root[data-theme="light"] .theme-toggle .sun  { display: block; }
  :root[data-theme="light"] .theme-toggle .moon { display: none; }
</style>

<script>
  const themeBtn = document.getElementById('theme-btn');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const doc = document.documentElement;
      const next = doc.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      doc.setAttribute('data-theme', next);
      localStorage.setItem('devsubnet-theme', next);
    });
  }
</script>
