---
import IPv4Calculator from './IPv4Calculator.astro';
import VisualSplitter from './VisualSplitter.astro';
import KubernetesPlanner from './KubernetesPlanner.astro';
import IPv6Calculator from './IPv6Calculator.astro';
import SubnetGuide from './SubnetGuide.astro';
import NavBar from './NavBar.astro';
import Footer from './Footer.astro';
import { translations, type SupportedLanguage } from '../utils/i18n';
import { toolsI18n } from '../utils/tools-i18n';

interface Props {
  activeTab: 'ipv4' | 'splitter' | 'k8s' | 'ipv6';
  defaultCloud?: 'standard' | 'aws' | 'azure' | 'gcp';
  navPath?: string;
  lang?: SupportedLanguage;
}

const { 
  activeTab, 
  defaultCloud = "standard",
  navPath = activeTab,
  lang = "en"
} = Astro.props;

const t = translations[lang] || translations.en;
const tTools = toolsI18n[lang] || toolsI18n.en;

let introData = t.intro[activeTab] || t.intro.ipv4;
if (navPath === 'aws' || defaultCloud === 'aws') {
  introData = tTools.cloudIntros.aws;
} else if (navPath === 'azure' || defaultCloud === 'azure') {
  introData = tTools.cloudIntros.azure;
} else if (navPath === 'gcp' || defaultCloud === 'gcp') {
  introData = tTools.cloudIntros.gcp;
}
---

<div class="app-shell">
  <!-- Top Bar navigation -->
  <NavBar path={navPath} lang={lang} />

  <!-- Main section -->
  <main>
    <!-- Heading section -->
    <section class="intro" aria-labelledby="page-title">
      <div class="eyebrow">{introData.eyebrow}</div>
      <h1 id="page-title">{introData.title}</h1>
      <p class="lede">{introData.lede}</p>
    </section>

    <!-- Content panels -->
    <section aria-label="Subnet utility workspace">
      {activeTab === 'ipv4' && <IPv4Calculator lang={lang} defaultCloud={defaultCloud} />}
      {activeTab === 'splitter' && <VisualSplitter lang={lang} />}
      {activeTab === 'k8s' && <KubernetesPlanner lang={lang} />}
      {activeTab === 'ipv6' && <IPv6Calculator lang={lang} />}
    </section>

    <!-- General detailed guide content -->
    <SubnetGuide lang={lang} />
    <slot />
  </main>

  <!-- Reoptimized Footer -->
  <Footer lang={lang} />
</div>
