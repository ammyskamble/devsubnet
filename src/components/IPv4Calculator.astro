---
import { calculateSubnet, getBinaryBits, calculateExamMath } from '../utils/subnetMath';
import { type SupportedLanguage } from '../utils/i18n';
import { calcTranslations } from '../utils/calc-i18n';

interface Props {
  defaultIp?: string;
  defaultCidr?: number;
  defaultCloud?: 'standard' | 'aws' | 'azure' | 'gcp';
  lang?: SupportedLanguage;
}

const { 
  defaultIp = "192.168.1.0", 
  defaultCidr = 24, 
  defaultCloud = "standard",
  lang = "en"
} = Astro.props;

// Calculate initial values for Server-Side Rendering (SEO & Instant first load)
const initialResult = calculateSubnet(defaultIp, defaultCidr, defaultCloud);
const initialBits = getBinaryBits(defaultIp, defaultCidr);
const initialExam = calculateExamMath(defaultIp, defaultCidr);
const calc = calcTranslations[lang] || calcTranslations.en;
---

<div class="calculator-layout" id="ipv4-calc-container" data-lang={lang} data-calc={JSON.stringify(calc)}>
  <!-- Left Column: Input and Details -->
  <div class="calculator-panel">
    <div class="panel-heading">
      <div>
        <span class="step">{calc.step1}</span>
        <h2>{calc.networkParamsTitle}</h2>
      </div>
      <span class="live-label">{calc.liveLabel}</span>
    </div>

    <!-- Grouped Inputs Card -->
    <div class="core-inputs-card">
      <!-- Inputs Row with Reverse Netmask/Wildcard support -->
      <div class="input-grid-3">
        <div class="input-row">
          <label for="ip-address" class="tooltip-trigger" data-tooltip={calc.ipAddressTooltip}>{calc.ipAddressLabel}</label>
          <div class="ip-input">
            <input 
              type="text" 
              id="ip-address" 
              value={defaultIp} 
              placeholder={calc.ipPlaceholder} 
              inputmode="decimal" 
              autocomplete="off" 
              maxlength="35"
            />
          </div>
        </div>

        <div class="input-row">
          <label for="cidr" class="tooltip-trigger" data-tooltip={calc.cidrTooltip}>{calc.cidrLabel}</label>
          <div class="ip-input">
            <span class="slash">/</span>
            <input 
              type="number" 
              id="cidr" 
              value={defaultCidr} 
              min="0" 
              max="32"
            />
          </div>
        </div>

        <div class="input-row">
          <label for="netmask-input" class="tooltip-trigger" data-tooltip={calc.maskOrWildcardTooltip || "Enter dotted netmask (e.g. 255.255.255.240) or wildcard (0.0.0.15) for instant reverse lookup"}>{calc.maskOrWildcardLabel || "Mask / Wildcard"}</label>
          <div class="ip-input">
            <input 
              type="text" 
              id="netmask-input" 
              value={initialResult.netmask} 
              placeholder={calc.maskPlaceholder || "255.255.255.0 or 0.0.0.255"} 
              inputmode="decimal" 
              autocomplete="off" 
              maxlength="15"
            />
          </div>
        </div>
      </div>

      <!-- Slider -->
      <div class="slider-container">
        <input 
          type="range" 
          id="cidr-slider" 
          value={defaultCidr} 
          min="0" 
          max="32"
          aria-label="CIDR prefix slider"
        />
      </div>

      <!-- Cloud Selector -->
      <div class="input-row">
        <label for="cloud-provider" class="tooltip-trigger" data-tooltip={calc.cloudTooltip}>{calc.cloudLabel}</label>
        <div class="select-wrapper">
          <select id="cloud-provider">
            <option value="standard" selected={defaultCloud === 'standard'}>{calc.cloudStandard}</option>
            <option value="aws" selected={defaultCloud === 'aws'}>{calc.cloudAws}</option>
            <option value="azure" selected={defaultCloud === 'azure'}>{calc.cloudAzure}</option>
            <option value="gcp" selected={defaultCloud === 'gcp'}>{calc.cloudGcp}</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Presets -->
    <div class="quick-row">
      <span>{calc.commonBlocks}</span>
      <button type="button" data-fill="10.0.0.0/8">10.0.0.0/8</button>
      <button type="button" data-fill="172.16.0.0/12">172.16.0.0/12</button>
      <button type="button" data-fill="192.168.0.0/16">192.168.0.0/16</button>
      <button type="button" data-fill="192.168.1.0/24">192.168.1.0/24</button>
    </div>

    <!-- Next / Previous Subnet Navigation Bar -->
    <div class="subnet-stepper-bar">
      <div class="stepper-meta">
        <span class="stepper-title">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-network);"><polyline points="13 17 18 12 13 7"></polyline><polyline points="6 17 11 12 6 7"></polyline></svg>
          {calc.stepperLabel || "Subnet Stepper"}:
        </span>
        <span class="stepper-current-badge" id="stepper-current-badge">{initialResult.network}/{defaultCidr}</span>
        <span class="stepper-delta-badge" id="stepper-delta-badge">Step: ±{initialResult.totalHosts.toLocaleString()} IPs</span>
      </div>
      <div class="stepper-controls">
        <button type="button" class="stepper-btn" id="btn-prev-subnet" title="Step backward by 1 consecutive subnet block">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          <span>{calc.prevSubnetLabel || "< Prev Subnet"}</span>
        </button>
        <button type="button" class="stepper-btn" id="btn-next-subnet" title="Step forward to next consecutive subnet block">
          <span>{calc.nextSubnetLabel || "Next Subnet >"}</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>

    <div class="error-banner" id="ip-error" role="alert">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <span>{calc.invalidIp}</span>
    </div>

    <!-- Binary visualization: cidr.xyz Interactive Grid -->
    <div class="binary-section">
      <div class="binary-heading">
        <div class="binary-title-wrap">
          <span class="tooltip-trigger" data-tooltip={calc.binaryTooltip}>{calc.binaryTitle}</span>
          <span class="binary-live-tag">Interactive Bit Grid</span>
        </div>
        <div class="binary-header-actions">
          <div class="binary-mode-switch" role="group" aria-label="Binary interactive mode">
            <button type="button" class="binary-mode-btn active" id="mode-prefix-btn" title="Click any bit to instantly set the CIDR prefix length">
              <span class="mode-icon">🎯</span> {calc.bitPrefixMode || 'Set Prefix'}
            </button>
            <button type="button" class="binary-mode-btn" id="mode-flip-btn" title="Click any bit to flip its value (0 ↔ 1) and recalculate the IP">
              <span class="mode-icon">🔄</span> {calc.bitFlipMode || 'Flip Bit (0 ↔ 1)'}
            </button>
          </div>
          <div class="binary-legend">
            <div class="legend-item"><span class="legend-color net"></span> {calc.networkBit}</div>
            <div class="legend-item"><span class="legend-color host"></span> {calc.hostBit}</div>
          </div>
        </div>
      </div>
      <div class="binary-grid-wrapper" id="binary-grid">
        {Array.from({ length: 4 }).map((_, octetIdx) => (
          <div class="binary-octet-col">
            <div class="binary-bit-weights">
              <span>128</span><span>64</span><span>32</span><span>16</span><span>8</span><span>4</span><span>2</span><span>1</span>
            </div>
            <div class="binary-octet" data-octet={octetIdx + 1}>
              {initialBits.slice(octetIdx * 8, (octetIdx + 1) * 8).map((bit, bitIdx) => {
                const globalBitIdx = octetIdx * 8 + bitIdx;
                const isBoundary = globalBitIdx + 1 === defaultCidr;
                return (
                  <button 
                    type="button"
                    class={`binary-bit ${bit.type} ${isBoundary ? 'boundary-bit' : ''}`} 
                    data-bit-idx={globalBitIdx}
                    data-bit-val={bit.val}
                    data-octet-idx={bit.octetIndex}
                    title={`Bit ${globalBitIdx + 1} (Octet ${bit.octetIndex}, Bit ${bit.bitIndex + 1}): Weight ${Math.pow(2, 7 - bit.bitIndex)} - ${bit.type === 'net' ? 'Network' : 'Host'} Bit. Click to adjust.`}
                    aria-label={`Bit ${globalBitIdx + 1}, value ${bit.val}, ${bit.type === 'net' ? 'network' : 'host'} bit`}
                  >
                    {bit.val}
                  </button>
                );
              })}
            </div>
            <div class="binary-octet-footer">
              Octet {octetIdx + 1}: <strong class="octet-dec-val">{defaultIp.split('.')[octetIdx] || '0'}</strong>
            </div>
          </div>
        ))}
      </div>
      <div class="binary-guidance-note">
        <span class="note-icon">💡</span>
        <span id="binary-mode-instruction">Click any bit above to set the CIDR prefix boundary directly, or switch to <strong>Flip Bit (0 ↔ 1)</strong> mode to modify the IP address bit-by-bit.</span>
      </div>
    </div>

    <!-- Result List -->
    <div class="result-heading">
      <div>
        <span class="step">{calc.step2}</span>
        <h2>{calc.subnetMetricsTitle}</h2>
      </div>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button class="copy-button" type="button" id="copy-ipv4-json">{calc.copyJson}</button>
        <button class="copy-button" type="button" id="copy-ipv4-csv">{calc.copyCsv}</button>
        <button class="copy-button" type="button" id="copy-ipv4-markdown">{calc.copyMd}</button>
        <button class="copy-button" type="button" id="share-link-btn" style="border-color: var(--accent-highlight); color: var(--accent-highlight); display: inline-flex; align-items: center; gap: 0.25rem;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>
          <span>{calc.shareLink}</span>
        </button>
      </div>
    </div>

    <div class="summary-grid">
      <div class="summary-item primary">
        <span class="tooltip-trigger" data-tooltip={calc.networkRangeTooltip}>{calc.networkRange}</span>
        <strong id="res-network">{initialResult.network}/{defaultCidr}</strong>
      </div>
      <div class="summary-item highlight-usable">
        <span class="tooltip-trigger" data-tooltip={calc.usableHostsTooltip}>{calc.usableHosts}</span>
        <strong id="res-host-range">{initialResult.firstUsable} - {initialResult.lastUsable}</strong>
      </div>
      <div class="summary-item">
        <span class="tooltip-trigger" data-tooltip={calc.subnetMaskTooltip}>{calc.subnetMask}</span>
        <strong id="res-mask">{initialResult.netmask}</strong>
      </div>
      <div class="summary-item">
        <span class="tooltip-trigger" data-tooltip={calc.wildcardMaskTooltip}>{calc.wildcardMask}</span>
        <strong id="res-wildcard">{initialResult.wildcard}</strong>
      </div>
      <div class="summary-item">
        <span class="tooltip-trigger" data-tooltip={calc.broadcastTooltip}>{calc.broadcast}</span>
        <strong id="res-broadcast">{initialResult.broadcast}</strong>
      </div>
      <div class="summary-item">
        <span class="tooltip-trigger" data-tooltip={calc.totalCapacityTooltip}>{calc.totalCapacity}</span>
        <strong id="res-total-hosts">{initialResult.totalHosts.toLocaleString()}</strong>
      </div>
    </div>

    <!-- Lab CLI Quick Copy Bar -->
    <div class="cli-quick-copy-card">
      <div class="cli-quick-header">
        <span class="cli-quick-title">⚡ CCNA & Lab CLI Quick Copy</span>
        <span class="cli-quick-desc">Instant 1-click syntax for Packet Tracer, GNS3, and EVE-NG</span>
      </div>
      <div class="cli-buttons-row">
        <button type="button" class="cli-copy-btn" id="quick-copy-cisco-ip" title="Copy Cisco IOS IP address command">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span>Cisco IOS IP</span>
        </button>
        <button type="button" class="cli-copy-btn" id="quick-copy-cisco-acl" title="Copy Cisco ACL Wildcard syntax">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span>Cisco ACL Wildcard</span>
        </button>
        <button type="button" class="cli-copy-btn" id="quick-copy-linux-ip" title="Copy Linux iproute2 command">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span>Linux iproute2</span>
        </button>
        <button type="button" class="cli-copy-btn" id="quick-copy-cisco-route" title="Copy Cisco Static Route command">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span>Cisco Route</span>
        </button>
      </div>
    </div>

    <!-- Exam Mode: Step-by-Step Math Derivation -->
    <div class="exam-mode-card" id="exam-mode-section">
      <div class="exam-mode-header">
        <div class="exam-mode-badge-wrap">
          <span class="exam-pill">🎓 {calc.examModeBadge || 'CCNA / CCNP EXAM MODE'}</span>
          <h3 class="exam-title">{calc.examModeTitle || 'Step-by-Step Subnet Math Derivation'}</h3>
        </div>
        <button type="button" class="exam-toggle-switch" id="exam-mode-toggle" aria-expanded="true">
          <span class="switch-indicator"></span>
          <span id="exam-toggle-label">{calc.hideMathLabel || 'Hide Step-by-Step Math'}</span>
        </button>
      </div>

      <div class="exam-mode-content" id="exam-mode-content">
        <div class="exam-grid">
          <!-- Card 1: Subnet & Host Bit Calculations -->
          <div class="exam-step-card">
            <div class="step-num-badge">STEP 1</div>
            <h4>Bit Allocation (2<sup>s</sup> & 2<sup>h</sup> &minus; 2)</h4>
            <div class="formula-box">
              <div class="formula-line">
                <span class="f-label">Subnets Created:</span>
                <code>2<sup>s</sup> = 2<sup>{initialExam.borrowedBits}</sup> = {initialExam.subnetsCreated.toLocaleString()}</code>
              </div>
              <div class="formula-line">
                <span class="f-label">Usable Host IPs:</span>
                <code>2<sup>h</sup> &minus; 2 = 2<sup>{initialExam.hostBits}</sup> &minus; 2 = {initialExam.usableHosts.toLocaleString()}</code>
              </div>
            </div>
            <p class="exam-step-desc">
              IP is Class <strong>{initialExam.ipClass}</strong> (default /{initialExam.defaultClassCidr}). Borrowing <strong>{initialExam.borrowedBits}</strong> bits creates <strong>{initialExam.subnetsCreated.toLocaleString()}</strong> subnets with <strong>{initialExam.hostBits}</strong> host bits remaining.
            </p>
          </div>

          <!-- Card 2: Magic Number & Block Size -->
          <div class="exam-step-card highlight">
            <div class="step-num-badge">STEP 2</div>
            <h4>Magic Number & Block Size</h4>
            <div class="formula-box">
              <div class="formula-line">
                <span class="f-label">Interesting Octet:</span>
                <code>{initialExam.interestingOctetName} (Mask: {initialExam.maskOctetValue})</code>
              </div>
              <div class="formula-line">
                <span class="f-label">Magic Number:</span>
                <code class="highlight-magic">256 &minus; {initialExam.maskOctetValue} = {initialExam.magicNumber}</code>
              </div>
            </div>
            <p class="exam-step-desc">
              The subnet boundary falls in the <strong>{initialExam.interestingOctetName}</strong>. Subnet blocks increment by multiples of <strong>{initialExam.magicNumber}</strong>.
            </p>
          </div>

          <!-- Card 3: Boundary Hops & Range Identification -->
          <div class="exam-step-card">
            <div class="step-num-badge">STEP 3</div>
            <h4>Boundary Hops & Range Identification</h4>
            <div class="hops-ribbon">
              {initialExam.multiples.slice(0, 8).map(m => {
                const isActive = m === initialExam.lowerBoundary;
                return (
                  <span class={`hop-badge ${isActive ? 'active-hop' : ''}`}>
                    .{m}
                  </span>
                );
              })}
              {initialExam.multiples.length > 8 && <span class="hop-badge">...</span>}
            </div>
            <p class="exam-step-desc">
              Octet value is <strong>{initialExam.ipOctetValue}</strong>. It falls between <strong>.{initialExam.lowerBoundary}</strong> and <strong>.{initialExam.broadcastOctet}</strong>.
            </p>
            <div class="exam-summary-strip">
              <span><strong>Net ID:</strong> {initialExam.networkIp}</span>
              <span><strong>Usable:</strong> {initialExam.firstUsableIp} - {initialExam.lastUsableIp}</span>
              <span><strong>Broadcast:</strong> {initialExam.broadcastIp}</span>
            </div>
          </div>

          <!-- Card 4: Bitwise AND Verification -->
          <div class="exam-step-card">
            <div class="step-num-badge">STEP 4</div>
            <h4>Bitwise AND Verification</h4>
            <div class="and-table">
              <div class="and-row"><span class="and-lbl">IP ({initialExam.ipOctetValue}):</span><code class="and-bits">{initialExam.andOperation.ipOctetBin}</code></div>
              <div class="and-row"><span class="and-lbl">Mask ({initialExam.maskOctetValue}):</span><code class="and-bits">{initialExam.andOperation.maskOctetBin}</code></div>
              <div class="and-row and-result"><span class="and-lbl">AND Result:</span><code class="and-bits">{initialExam.andOperation.andResultBin} (={initialExam.andOperation.resultDec})</code></div>
            </div>
            <p class="exam-step-desc">
              Bitwise AND produces <strong>{initialExam.andOperation.resultDec}</strong>, validating the Network ID.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Reserved IPs Detail list -->
    <div style="background-color: var(--bg-secondary); border-radius: var(--radius-md); padding: 1.25rem; border: 1px solid var(--border-color);">
      <h3 style="font-size: 0.9rem; text-transform: uppercase; font-family: var(--font-display); color: var(--text-secondary); margin-bottom: 0.75rem;">{calc.addressReservations}</h3>
      <ul id="res-details" style="font-family: var(--font-mono); font-size: 0.8rem; list-style-type: none; display: flex; flex-direction: column; gap: 0.35rem;">
        {initialResult.reservedDetails.map(detail => (
          <li style="color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;">
            <span style="color: var(--accent-host); font-weight: bold;">•</span> {detail}
          </li>
        ))}
      </ul>
    </div>

    <!-- Explanatory Reserved IPs breakdown -->
    <details class="reserved-info-details" style="border: 1px dashed var(--border-color); border-radius: var(--radius-md); background: rgba(255,255,255,0.01);">
      <summary style="font-size: 0.8rem; font-weight: 600; padding: 0.75rem; cursor: pointer; color: var(--accent-highlight); outline: none; user-select: none; display: flex; align-items: center; gap: 0.25rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        {calc.compareCloudTitle}
      </summary>
      <div style="padding: 0.75rem; font-size: 0.8rem; border-top: 1px dashed var(--border-color); display: flex; flex-direction: column; gap: 0.75rem; color: var(--text-secondary); line-height: 1.4;">
        <p>{calc.compareCloudIntro}</p>
        <div style="display: grid; grid-template-columns: 1fr; gap: 0.5rem;">
          <div style="border-left: 3px solid var(--text-muted); padding-left: 0.5rem;">
            {calc.stdRfcRule}
          </div>
          <div style="border-left: 3px solid var(--accent-network); padding-left: 0.5rem;">
            {calc.awsRule}
          </div>
          <div style="border-left: 3px solid var(--accent-host); padding-left: 0.5rem;">
            {calc.azureRule}
          </div>
          <div style="border-left: 3px solid var(--accent-highlight); padding-left: 0.5rem;">
            {calc.gcpRule}
          </div>
        </div>
      </div>
    </details>

    <!-- Inline Subnet Splitter -->
    <div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem; margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
      <div class="panel-heading" style="padding-bottom: 0.5rem; border-bottom: none;">
        <div>
          <span class="step" style="background: rgba(var(--hsl-host), 0.15); color: var(--accent-host);">{calc.step3Splitter}</span>
          <h2 class="tooltip-trigger" data-tooltip={calc.splitterTooltip}>{calc.splitterTitle}</h2>
        </div>
        <span class="live-label" style="background: rgba(var(--hsl-network), 0.12); color: var(--accent-network);">{calc.allocationsLabel}</span>
      </div>

      <p class="aside-copy" style="font-size: 0.9rem; margin-bottom: 0.5rem;">
        {calc.splitterDescPre} <strong><span id="inline-splitter-base-display" style="color: var(--accent-network); font-family: var(--font-mono);">{defaultIp}/{defaultCidr}</span></strong> {calc.splitterDescPost}
      </p>

      <div class="splitter-visual-root" style="margin-top: 0.25rem;">
        <div class="subnet-block-row" id="inline-splitter-grid" style="min-height: 80px;">
          <!-- Rendered dynamically -->
        </div>
      </div>

      <div class="guide-table-wrapper" style="margin-top: 0.5rem; max-height: 250px; overflow-y: auto;">
        <table class="guide-table" style="font-size: 0.85rem;">
          <thead>
            <tr>
              <th>{calc.thLabel}</th>
              <th>{calc.thCidr}</th>
              <th>{calc.thUsable}</th>
              <th>{calc.thHosts}</th>
              <th>{calc.thAction}</th>
            </tr>
          </thead>
          <tbody id="inline-splitter-table-body">
            <!-- Rendered dynamically -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Right Column: Interactive Side Panel -->
  <div class="insight-panel">
    <div class="calculator-panel" style="gap: 1.5rem;">
      <div>
        <span class="aside-kicker">{calc.infraPlanning}</span>
        <h2 id="res-aside-title">{calc.yourSubnetTitle.replace('{cidr}', String(defaultCidr))}</h2>
      </div>
      <p class="aside-copy" id="res-aside-desc">
        {calc.asideDescPre} {initialResult.netmask} {calc.asideDescMid} {initialResult.usableHosts.toLocaleString()} {calc.asideDescPost}
      </p>

      <div class="capacity highlighted">
        <div>
          <span>{calc.usableCapacityLabel}</span>
