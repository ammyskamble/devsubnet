---
import { toolsI18n } from '../utils/tools-i18n';
import type { SupportedLanguage } from '../utils/i18n';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const ov = (toolsI18n[lang] || toolsI18n.en).overlap;
---
<div class="calculator-layout" data-overlap-i18n={JSON.stringify(ov)}>
  <!-- Left Column: Input and Mode Selection -->
  <div class="calculator-panel">
    <div class="panel-heading">
      <div>
        <span class="step">{ov.step1}</span>
        <h2>{ov.title}</h2>
      </div>
      <span class="live-label">{ov.badge}</span>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="subtool-tabs" style="display: flex; gap: 0.5rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
      <button type="button" id="tab-mode-list" class="export-tab-btn active" style="flex: 1;">{ov.tabSingle}</button>
      <button type="button" id="tab-mode-groups" class="export-tab-btn" style="flex: 1;">{ov.tabGroups}</button>
    </div>

    <!-- Mode 1: Single List Input -->
    <div id="container-mode-list" class="input-row">
      <label for="overlap-input">{ov.inputLabel}</label>
      <textarea id="overlap-input" rows="7" style="background-color: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem 1rem; font-family: var(--font-mono); font-size: 0.9rem; color: var(--text-primary); outline: none; resize: vertical; width: 100%;">10.0.0.0/24
10.0.0.128/25
172.16.0.0/16
2001:db8:abc::/48
2001:db8:abc:123::/64
10.0.1.0/24</textarea>
    </div>

    <!-- Mode 2: Two Groups Input -->
    <div id="container-mode-groups" class="input-row" style="display: none; flex-direction: column; gap: 1rem;">
      <div>
        <label for="overlap-group-a" style="margin-bottom: 0.35rem; display: block;">{ov.groupALabel}</label>
        <textarea id="overlap-group-a" rows="4" style="background-color: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem 1rem; font-family: var(--font-mono); font-size: 0.9rem; color: var(--text-primary); outline: none; resize: vertical; width: 100%;">10.0.0.0/24
172.16.0.0/16
2001:db8:fefe::/48</textarea>
      </div>
      <div>
        <label for="overlap-group-b" style="margin-bottom: 0.35rem; display: block;">{ov.groupBLabel}</label>
        <textarea id="overlap-group-b" rows="4" style="background-color: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem 1rem; font-family: var(--font-mono); font-size: 0.9rem; color: var(--text-primary); outline: none; resize: vertical; width: 100%;">10.0.0.128/25
192.168.1.0/24
2001:db8:fefe:1::/64</textarea>
      </div>
    </div>

    <div class="quick-row" style="margin-top: 1rem;">
      <button type="button" id="btn-run-overlap" class="subtool-btn" style="border-color: var(--accent-highlight); color: var(--accent-highlight); font-weight: bold;">{ov.btnCheck}</button>
      <button type="button" id="btn-clear-overlap" class="subtool-btn">{ov.btnClear}</button>
    </div>

    <div class="error-banner" id="overlap-error" role="alert">
      <span>{ov.errorInvalid}</span>
    </div>
  </div>

  <!-- Right Column: Results -->
  <div class="insight-panel">
    <div class="calculator-panel" style="gap: 1.5rem;">
      <div>
        <span class="aside-kicker">{ov.asideKicker}</span>
        <h2>{ov.asideTitle}</h2>
      </div>
      <p class="aside-copy">
        {ov.asideDesc}
      </p>
      <div id="overlap-summary" class="overlap-summary"></div>
      
      <div class="guide-table-wrapper">
        <table class="guide-table">
          <thead>
            <tr>
              <th>{ov.thSubnetA}</th>
              <th>{ov.thSubnetB}</th>
              <th>{ov.thRelationship}</th>
            </tr>
          </thead>
          <tbody id="overlap-table-body">
            <tr><td colspan="3" style="text-align:center;color:var(--text-muted); font-family:var(--font-sans);">{ov.initialPrompt}</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  import { validateIPv4, ip2Long, long2Ip, expandIPv6, compressIPv6 } from '../utils/subnetMath';

  interface Block {
    start: bigint;
    end: bigint;
    cidr: number;
    isV6: boolean;
    label: string;
  }

  function initOverlapChecker() {
    const tabList = document.getElementById('tab-mode-list') as HTMLButtonElement;
    const tabGroups = document.getElementById('tab-mode-groups') as HTMLButtonElement;
    
    const containerList = document.getElementById('container-mode-list') as HTMLElement;
    const containerGroups = document.getElementById('container-mode-groups') as HTMLElement;

    const inputList = document.getElementById('overlap-input') as HTMLTextAreaElement;
    const inputGroupA = document.getElementById('overlap-group-a') as HTMLTextAreaElement;
    const inputGroupB = document.getElementById('overlap-group-b') as HTMLTextAreaElement;

    const runBtn = document.getElementById('btn-run-overlap') as HTMLButtonElement;
    const clearBtn = document.getElementById('btn-clear-overlap') as HTMLButtonElement;
    const tableBody = document.getElementById('overlap-table-body') as HTMLTableSectionElement;
    const summary = document.getElementById('overlap-summary') as HTMLElement;
    const errorBanner = document.getElementById('overlap-error');

    if (!runBtn || !tableBody || !inputList) return;

    const layoutContainer = document.querySelector('.calculator-layout[data-overlap-i18n]') as HTMLElement;
    let i18n = {
      noConflicts: 'No overlapping subnets found. Configuration is safe for routing and peering.',
      conflictsFound: 'Direct CIDR collisions detected! Overlapping IP address spaces will fail routing.',
      relIdentical: 'Identical Range',
      relContains: 'Subnet Contained',
      relOverlaps: 'Partial Overlap'
    };
    if (layoutContainer && layoutContainer.dataset.overlapI18n) {
      try {
        i18n = { ...i18n, ...JSON.parse(layoutContainer.dataset.overlapI18n) };
      } catch (e) {}
    }

    let mode = 'list'; // 'list' or 'groups'

    // Tab actions
    if (tabList && tabGroups) {
      tabList.onclick = () => {
        tabList.classList.add('active');
        tabGroups.classList.remove('active');
        containerList.style.display = 'block';
        containerGroups.style.display = 'none';
        mode = 'list';
      };

      tabGroups.onclick = () => {
        tabGroups.classList.add('active');
        tabList.classList.remove('active');
        containerList.style.display = 'none';
        containerGroups.style.display = 'flex';
        mode = 'groups';
      };
    }

    function validateIPv6(address: string): boolean {
      const regex = /^(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{1,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))$/;
      return regex.test(address.trim());
    }

    function parseBlock(line: string): Block | null {
      const t = line.trim();
      if (!t) return null;
      const slash = t.lastIndexOf('/');
      if (slash === -1) return null;
      const ip = t.slice(0, slash).trim();
      const cidr = parseInt(t.slice(slash + 1), 10);

      const isV6 = ip.includes(':');
      if (isV6) {
        if (!validateIPv6(ip) || isNaN(cidr) || cidr < 0 || cidr > 128) return null;
        try {
          const expanded = expandIPv6(ip);
          const parts = expanded.split(':');
          let ipVal = 0n;
          for (let i = 0; i < 8; i++) {
            ipVal = (ipVal << 16n) | BigInt(parseInt(parts[i], 16));
          }
          const mask = cidr === 0 ? 0n : (~0n << BigInt(128 - cidr)) & ((1n << 128n) - 1n);
          const start = ipVal & mask;
          const end = start + (1n << BigInt(128 - cidr)) - 1n;
          return { start, end, cidr, isV6, label: `${compressIPv6(expanded)}/${cidr}` };
        } catch {
          return null;
        }
      } else {
        if (!validateIPv4(ip) || isNaN(cidr) || cidr < 0 || cidr > 32) return null;
        const mask = cidr === 0 ? 0 : (~0 << (32 - cidr)) >>> 0;
        const start = (ip2Long(ip) & mask) >>> 0;
        const end = start + Math.pow(2, 32 - cidr) - 1;
        return { 
          start: BigInt(start), 
          end: BigInt(end), 
          cidr, 
          isV6, 
          label: `${long2Ip(start)}/${cidr}` 
        };
      }
    }

    function relationship(a: Block, b: Block): string {
      if (a.isV6 !== b.isV6) return 'Separate'; // IPv4 and IPv6 never overlap
      if (a.start === b.start && a.cidr === b.cidr) return 'Identical';
      
      const aContainsB = a.start <= b.start && a.end >= b.end;
      const bContainsA = b.start <= a.start && b.end >= a.end;
      if (aContainsB || bContainsA) return 'Contained';
      
      const overlap = a.start <= b.end && b.start <= a.end;
      if (overlap) return 'Overlapping';
      
      return 'Separate';
    }

    function run() {
      errorBanner?.classList.remove('show');
      let valid = true;

      const parseList = (val: string) => {
        const blocks: Block[] = [];
        val.split('\n').forEach(line => {
          if (!line.trim()) return;
          const b = parseBlock(line);
          if (b) blocks.push(b);
          else valid = false;
        });
        return blocks;
      };

      let html = '';
      let conflictCount = 0;
      let comparisonsCount = 0;

      if (mode === 'list') {
        const blocks = parseList(inputList.value);
        if (!valid || blocks.length < 2) {
          errorBanner?.classList.add('show');
          return;
        }

        comparisonsCount = (blocks.length * (blocks.length - 1)) / 2;

        for (let i = 0; i < blocks.length; i++) {
          for (let j = i + 1; j < blocks.length; j++) {
            const rel = relationship(blocks[i], blocks[j]);
            const isConflict = rel === 'Overlapping' || rel === 'Identical';
            if (isConflict) conflictCount++;
            
            const relText = rel === 'Identical' ? i18n.relIdentical : rel === 'Contained' ? i18n.relContains : rel === 'Overlapping' ? i18n.relOverlaps : 'Separate';
            const color = isConflict ? 'var(--accent-danger, #f43f5e)' : rel === 'Contained' ? 'var(--accent-warning, #f59e0b)' : 'var(--accent-network, #38bdf8)';
            html += `<tr>
              <td><span style="font-family:var(--font-mono); font-size:0.85rem;">${blocks[i].label}</span></td>
              <td><span style="font-family:var(--font-mono); font-size:0.85rem;">${blocks[j].label}</span></td>
              <td><span style="color:${color}; font-weight:600;">${relText}</span></td>
            </tr>`;
          }
        }
      } else {
        const blocksA = parseList(inputGroupA.value);
        const blocksB = parseList(inputGroupB.value);
        if (!valid || blocksA.length === 0 || blocksB.length === 0) {
          errorBanner?.classList.add('show');
          return;
        }

        comparisonsCount = blocksA.length * blocksB.length;

        for (let i = 0; i < blocksA.length; i++) {
          for (let j = 0; j < blocksB.length; j++) {
            const rel = relationship(blocksA[i], blocksB[j]);
            const isConflict = rel === 'Overlapping' || rel === 'Identical';
            if (isConflict) conflictCount++;

            const relText = rel === 'Identical' ? i18n.relIdentical : rel === 'Contained' ? i18n.relContains : rel === 'Overlapping' ? i18n.relOverlaps : 'Separate';
            const color = isConflict ? 'var(--accent-danger, #f43f5e)' : rel === 'Contained' ? 'var(--accent-warning, #f59e0b)' : 'var(--accent-network, #38bdf8)';
            html += `<tr>
              <td><span style="font-family:var(--font-mono); font-size:0.85rem; color:var(--accent-host);">${blocksA[i].label} (Group A)</span></td>
              <td><span style="font-family:var(--font-mono); font-size:0.85rem;">${blocksB[j].label} (Group B)</span></td>
              <td><span style="color:${color}; font-weight:600;">${relText}</span></td>
            </tr>`;
          }
        }
      }

      tableBody.innerHTML = html || '<tr><td colspan="3" style="text-align:center;color:var(--text-muted);">No relations checked.</td></tr>';
      
      if (summary) {
        const clean = conflictCount === 0;
        summary.innerHTML = `
          <div class="overlap-summary-card ${clean ? 'clean' : 'conflict'}">
            <strong>${clean ? i18n.noConflicts : i18n.conflictsFound}</strong>
            <span>(${conflictCount} conflicts across ${comparisonsCount} comparisons)</span>
          </div>`;
      }
    }

    runBtn.onclick = run;
    if (clearBtn) {
      clearBtn.onclick = () => {
        inputList.value = '';
        inputGroupA.value = '';
        inputGroupB.value = '';
        tableBody.innerHTML = '<tr><td colspan="3" style="text-align:center;color:var(--text-muted); font-family:var(--font-sans);">Enter CIDRs and click Check Conflicts.</td></tr>';
        if (summary) summary.innerHTML = '';
      };
    }
  }

  document.addEventListener('astro:page-load', initOverlapChecker);
  initOverlapChecker();
</script>

<style>
  .subtool-btn {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .subtool-btn:hover { color: var(--text-primary); background-color: var(--border-color); }
  
  .overlap-summary-card {
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    border: 1px solid;
    margin-bottom: 1rem;
  }
  .overlap-summary-card strong { font-size: 1.5rem; font-family: var(--font-mono); }
  .overlap-summary-card.clean {
    background-color: rgba(56, 189, 248, 0.05);
    border-color: rgba(56, 189, 248, 0.2);
    color: var(--accent-network, #38bdf8);
  }
  .overlap-summary-card.conflict {
    background-color: rgba(244, 63, 94, 0.05);
    border-color: rgba(244, 63, 94, 0.2);
    color: var(--accent-danger, #f43f5e);
  }
  .overlap-summary-card span { color: var(--text-secondary); }
</style>
