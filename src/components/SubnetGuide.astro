---
import { translations, type SupportedLanguage } from '../utils/i18n';
import { guideTranslations } from '../utils/guide-i18n';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = "en" } = Astro.props;
const t = translations[lang] || translations.en;
const guide = t.guide;
const guideData = guideTranslations[lang] || guideTranslations.en;
const langPrefix = lang === 'en' ? '' : `/${lang}`;

const prefixTableRows = [
  { prefix: "/32", mask: "255.255.255.255", wildcard: "0.0.0.0", count: "1", unit: guideData.units.host },
  { prefix: "/31", mask: "255.255.255.254", wildcard: "0.0.0.1", count: "2", unit: guideData.units.pointToPoint },
  { prefix: "/30", mask: "255.255.255.252", wildcard: "0.0.0.3", count: "2", unit: guideData.units.hosts },
  { prefix: "/29", mask: "255.255.255.248", wildcard: "0.0.0.7", count: "6", unit: guideData.units.hosts },
  { prefix: "/28", mask: "255.255.255.240", wildcard: "0.0.0.15", count: "14", unit: guideData.units.hosts },
  { prefix: "/27", mask: "255.255.255.224", wildcard: "0.0.0.31", count: "30", unit: guideData.units.hosts },
  { prefix: "/26", mask: "255.255.255.192", wildcard: "0.0.0.63", count: "62", unit: guideData.units.hosts },
  { prefix: "/25", mask: "255.255.255.128", wildcard: "0.0.0.127", count: "126", unit: guideData.units.hosts },
  { prefix: "/24", mask: "255.255.255.0", wildcard: "0.0.0.255", count: "254", unit: guideData.units.hosts },
  { prefix: "/23", mask: "255.255.254.0", wildcard: "0.0.1.255", count: "510", unit: guideData.units.hosts },
  { prefix: "/22", mask: "255.255.252.0", wildcard: "0.0.3.255", count: "1,022", unit: guideData.units.hosts },
  { prefix: "/20", mask: "255.255.240.0", wildcard: "0.0.15.255", count: "4,094", unit: guideData.units.hosts },
  { prefix: "/16", mask: "255.255.0.0", wildcard: "0.0.255.255", count: "65,534", unit: guideData.units.hosts },
  { prefix: "/8", mask: "255.0.0.0", wildcard: "0.255.255.255", count: "16,777,214", unit: guideData.units.hosts },
];
---

<section class="seo-netsudoku-section" aria-labelledby="seo-section-title">
  <div class="seo-netsudoku-container">
    <!-- Header Title & Lead Paragraph -->
    <h2 id="seo-section-title">{guide.title}</h2>
    <p class="lead">{guide.lead}</p>

    <!-- Card Grid for SEO Topics -->
    <h3 style="margin-top: 0;">{guide.exploreTitle}</h3>
    <div class="seo-netsudoku-grid">
      {guide.cards.map((card) => (
        <div class="seo-netsudoku-card">
          <div>
            <h4>{card.title}</h4>
            <p>{card.desc}</p>
          </div>
          <a href={card.href} class="card-link">
            {card.linkText}
          </a>
        </div>
      ))}
    </div>

    <!-- Additional Rich Content Section -->
    <h3>{guide.prefixTableTitle}</h3>
    <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.5rem;">
      {guide.prefixTableDesc}
    </p>
    <div class="guide-table-wrapper" style="margin-bottom: 3rem;">
      <table class="guide-table">
        <thead>
          <tr>
            <th>{guideData.prefixTableHeaders.cidr}</th>
            <th>{guideData.prefixTableHeaders.mask}</th>
            <th>{guideData.prefixTableHeaders.wildcard}</th>
            <th>{guideData.prefixTableHeaders.usable}</th>
          </tr>
        </thead>
        <tbody>
          {prefixTableRows.map(row => (
            <tr>
              <td>{row.prefix}</td>
              <td>{row.mask}</td>
              <td>{row.wildcard}</td>
              <td>{row.count} {row.unit}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Comparison Table Section -->
    <h3>{guide.comparisonTitle}</h3>
    <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.5rem;">
      {guide.comparisonDesc}
    </p>
    <div class="guide-table-wrapper" style="margin-bottom: 3rem;">
      <table class="guide-table">
        <thead>
          <tr>
            <th>{guideData.compHeaders.feature}</th>
            <th>{guideData.compHeaders.devsubnet}</th>
            <th>{guideData.compHeaders.basic}</th>
          </tr>
        </thead>
        <tbody>
          {guideData.compRows.map((row) => (
            <tr>
              <td>{row.feature}</td>
              <td style="color: var(--accent-highlight); font-weight: 600;">{row.devsubnet}</td>
              <td style="color: var(--text-muted);">{row.basic}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Dedicated SEO Content: Online IP Subnet Calculator & CIDR Calculator -->
    <h3>{guideData.whyTitle}</h3>
    <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.7; margin-bottom: 1.5rem;">
      {guideData.whyIntro}
    </p>
    <div class="seo-netsudoku-grid" style="margin-bottom: 3rem;">
      {guideData.whyCards.map((card) => (
        <div class="seo-netsudoku-card">
          <div>
            <h4 style="font-size: 1.05rem;">{card.title}</h4>
            <p style="font-size: 0.85rem; color: var(--text-secondary);">
              {card.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- FAQ Section -->
    <h3 id="faq-section-title">{guide.faqTitle}</h3>
    <div class="seo-netsudoku-grid" style="margin-bottom: 2rem;">
      {guideData.faqs.map((faq) => (
        <div class="seo-netsudoku-card">
          <div>
            <h4 style="font-size: 1.05rem;">{faq.q}</h4>
            <p style="font-size: 0.85rem; color: var(--text-secondary);">
              {faq.a}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Link to FAQ page -->
    <div style="margin-bottom: 3.5rem;">
      <a href={`${langPrefix}/faq`} class="btn-seo-primary" style="display: inline-block;">{guide.faqViewAll}</a>
    </div>

    <!-- CTA Buttons Row -->
    <div class="seo-netsudoku-ctas">
      <a href={`${langPrefix}/`} class="btn-seo-primary">{guide.ctaPrimary}</a>
      <a href={`${langPrefix}/visual-subnet-splitter`} class="btn-seo-secondary">{guide.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .seo-netsudoku-section {
    border-top: 1px solid var(--border-color);
    padding: 5rem 1.5rem;
    position: relative;
    background-color: rgba(var(--bg-secondary), 0.1);
    content-visibility: auto;
    contain-intrinsic-size: 1px 1200px;
  }
  
  .seo-netsudoku-container {
    max-width: 56rem;
    margin: 0 auto;
    text-align: left;
  }
  
  .seo-netsudoku-container h2 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }
  
  .seo-netsudoku-container p.lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .seo-netsudoku-container h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 3.5rem;
    margin-bottom: 1.5rem;
  }
  
  .seo-netsudoku-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .seo-netsudoku-card {
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    background-color: var(--bg-surface);
    backdrop-filter: blur(var(--glass-blur));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .seo-netsudoku-card:hover {
    border-color: var(--accent-network);
    transform: translateY(-2px);
  }
  
  .seo-netsudoku-card h4 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  
  .seo-netsudoku-card p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .seo-netsudoku-card .card-link {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-network);
    text-decoration: none;
    margin-top: 1.25rem;
    display: inline-block;
  }

  .seo-netsudoku-card .card-link:hover {
    text-decoration: underline;
  }

  .guide-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }

  .guide-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  .guide-table th {
    background: rgba(255,255,255,0.03);
    padding: 0.85rem 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
  }

  .guide-table td {
    padding: 0.75rem 1.2rem;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  /* Button CTA Row */
  .seo-netsudoku-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .btn-seo-primary {
    background-color: var(--text-primary);
    color: var(--bg-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .btn-seo-primary:hover {
    opacity: 0.9;
  }

  .btn-seo-secondary {
    border: 1px solid var(--border-color);
    background-color: transparent;
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .btn-seo-secondary:hover {
    background-color: var(--bg-secondary);
  }

  @media (max-width: 768px) {
    .seo-netsudoku-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
