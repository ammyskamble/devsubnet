---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import { type SupportedLanguage } from '../utils/i18n';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout 
  lang={lang} 
  noindex={true}
  title="400 – Bad Request / Malformed CIDR | DevSubnet"
  description="The server could not parse your request due to invalid query parameters or malformed CIDR notation. Return to DevSubnet to calculate valid subnets."
>
  <div class="app-shell">
    <NavBar lang={lang} path="error" />

    <main class="error-main">
      <div class="error-container">
        <!-- Diagnostic Status Pill -->
        <div class="status-badge" role="status">
          <span class="warning-icon">⚠️</span>
          <span class="badge-code">ERR_400_MALFORMED_SYNTAX</span>
        </div>

        <h1 class="error-title">
          <span class="code-number">400</span>
          <span class="title-text">Malformed Network Request</span>
        </h1>

        <p class="error-description">
          The routing parser could not interpret your request. The provided query string or parameters contained invalid characters, out-of-range IP octets, or illegal CIDR prefix lengths.
        </p>

        <!-- Malformed Packet Diagnostic Frame -->
        <div class="packet-frame-card" aria-hidden="true">
          <div class="frame-header">
            <span class="frame-label">PARSER DIAGNOSTIC DECODE</span>
            <span class="frame-status">SYNTAX_ERROR</span>
          </div>
          
          <div class="packet-chunks">
            <div class="chunk invalid">
              <span class="chunk-val">256.300</span>
              <span class="chunk-tip">Octet &gt; 255</span>
            </div>
            <span class="dot">.</span>
            <div class="chunk invalid">
              <span class="chunk-val">1.0</span>
              <span class="chunk-tip">Corrupt Byte</span>
            </div>
            <span class="slash">/</span>
            <div class="chunk invalid">
              <span class="chunk-val">35</span>
              <span class="chunk-tip">Prefix &gt; 32</span>
            </div>
          </div>

          <div class="syntax-guide">
            <div class="guide-item">
              <span class="guide-tag valid">VALID IPV4</span>
              <code>0.0.0.0/0</code> to <code>255.255.255.255/32</code>
            </div>
            <div class="guide-item">
              <span class="guide-tag valid">VALID IPV6</span>
              <code>::/0</code> to <code>ffff:ffff:.../128</code>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
          <a href="/" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Reset Query &amp; Return Home
          </a>
          <button type="button" id="back-btn" class="btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            Go Back
          </button>
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<style>
  .error-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3.5rem 1.5rem 5rem;
    min-height: calc(100vh - 180px);
  }

  .error-container {
    max-width: 44rem;
    width: 100%;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Status Badge */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .warning-icon {
    font-size: 0.95rem;
    line-height: 1;
  }

  /* Error Heading */
  .error-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .code-number {
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 9vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    background: linear-gradient(135deg, #fbbf24 0%, #a855f7 50%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .title-text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .error-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 34rem;
    margin: 0 0 2.25rem;
  }

  /* Packet Frame Diagnostic Card */
  .packet-frame-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem 2rem;
    width: 100%;
    margin-bottom: 2.5rem;
    backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-md);
    text-align: left;
  }

  .frame-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .frame-label {
    color: var(--text-muted);
    font-weight: 600;
  }

  .frame-status {
    color: #f87171;
    font-weight: 700;
  }

  .packet-chunks {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    margin: 1.25rem 0 1.75rem;
    flex-wrap: wrap;
  }

  .chunk.invalid {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(239, 68, 68, 0.12);
    border: 1px dashed #ef4444;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .chunk-val {
    color: #f87171;
    font-weight: 700;
  }

  .chunk-tip {
    font-size: 0.65rem;
    color: #ef4444;
    margin-top: 0.2rem;
    font-weight: 600;
  }

  .dot, .slash {
    color: var(--text-muted);
    font-weight: 700;
  }

  .syntax-guide {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    font-size: 0.85rem;
  }

  .guide-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .guide-tag.valid {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: #34d399;
    background: rgba(16, 185, 129, 0.12);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-full);
  }

  .guide-item code {
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  /* Actions */
  .action-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    color: #ffffff;
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .btn-secondary:hover {
    background: var(--bg-secondary);
    border-color: rgba(161, 66, 244, 0.4);
  }
</style>

<script>
  const backBtn = document.getElementById('back-btn');
  if (backBtn) {
    backBtn.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/';
      }
    });
  }
</script>
