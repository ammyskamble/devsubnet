---
interface Props {
  defaultIp?: string;
  defaultPrefix?: number;
}

const {
  defaultIp = "2001:db8::",
  defaultPrefix = 32
} = Astro.props;
---

<div class="calculator-layout">
  <!-- Left Column: Inputs and Details -->
  <div class="calculator-panel">
    <div class="panel-heading">
      <div>
        <span class="step">01</span>
        <h2>IPv6 Address Parameters</h2>
      </div>
      <span class="live-label" style="background-color:rgba(235, 80, 145, 0.12); color:var(--accent-host);">IPv6 STACK</span>
    </div>

    <!-- Inputs Row -->
    <div class="input-grid-2-1">
      <div class="input-row">
        <label for="v6-ip-address">IPv6 Address</label>
        <div class="ip-input">
          <input 
            type="text" 
            id="v6-ip-address" 
            value={defaultIp} 
            placeholder="e.g., 2001:db8::" 
            autocomplete="off"
          />
        </div>
      </div>

      <div class="input-row">
        <label for="v6-prefix">Prefix Length</label>
        <div class="ip-input">
          <span class="slash">/</span>
          <input 
            type="number" 
            id="v6-prefix" 
            value={defaultPrefix} 
            min="0" 
            max="128"
          />
        </div>
      </div>
    </div>

    <!-- Slider -->
    <div class="slider-container">
      <input 
        type="range" 
        id="v6-prefix-slider" 
        value={defaultPrefix} 
        min="0" 
        max="128"
        step="4"
        aria-label="IPv6 prefix length slider"
      />
    </div>

    <div class="error-banner" id="v6-ip-error" role="alert">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <span>Invalid IPv6 address format. Enter valid hexadecimal blocks separated by colons.</span>
    </div>

    <!-- Result List -->
    <div class="result-heading">
      <div>
        <span class="step">02</span>
        <h2>Subnet Range Details</h2>
      </div>
      <button class="copy-button" type="button" id="copy-ipv6-json">Copy JSON</button>
    </div>

    <div class="summary-grid">
      <div class="summary-item primary">
        <span>Compressed IPv6 Address</span>
        <strong id="v6-res-compressed">2001:db8::/32</strong>
      </div>
      <div class="summary-item">
        <span>Address Range Bounds</span>
        <strong id="v6-res-range" style="font-size: 0.95rem;">2001:db8:: - 2001:db8:ffff:ffff:ffff:ffff:ffff:ffff</strong>
      </div>
      <div class="summary-item">
        <span>Address Type Classification</span>
        <strong id="v6-res-type">Global Unicast</strong>
      </div>
      <div class="summary-item">
        <span>Total Address Capacity</span>
        <strong id="v6-res-hosts" style="font-size: 1.1rem;">7.92e+28 IPs</strong>
      </div>
      <div class="summary-item" style="grid-column: span 2;">
        <span>Expanded (Uncompressed) IPv6 Form</span>
        <strong id="v6-res-expanded" style="font-size: 1.05rem; letter-spacing: 0.02em;">2001:0db8:0000:0000:0000:0000:0000:0000</strong>
      </div>
    </div>
  </div>

  <!-- Right Column: Subnet delegation tools -->
  <div class="insight-panel">
    <div class="calculator-panel" style="gap: 1.5rem;">
      <div>
        <span class="aside-kicker">PREFIX DELEGATION PLANNER</span>
        <h2>Delegated Blocks</h2>
      </div>
      <p class="aside-copy">
        Split your IPv6 block into smaller standard prefixes (like <code>/48</code>, <code>/56</code>, or <code>/64</code>) for sub-allocation.
      </p>

      <div class="input-row">
        <label for="v6-delegator-prefix">Target Prefix Length</label>
        <div class="select-wrapper">
          <select id="v6-delegator-prefix">
            <option value="48">/48 (Large Organization Sites)</option>
            <option value="56">/56 (Medium Enterprise / Customer sites)</option>
            <option value="64" selected>/64 (Standard Local Subnet)</option>
            <option value="128">/128 (Single Host Allocations)</option>
          </select>
        </div>
      </div>

      <div class="capacity">
        <div>
          <span>TOTAL DELEGATED BLOCKS</span>
          <strong id="v6-delegated-count">4,294,967,296</strong>
        </div>
        <span class="capacity-unit">Subnets</span>
      </div>

      <div style="background-color: var(--bg-secondary); border-radius: var(--radius-md); padding: 1rem; border: 1px solid var(--border-color);">
        <span style="display:block; font-size: 0.75rem; text-transform: uppercase; font-family: var(--font-display); color: var(--text-muted); margin-bottom: 0.5rem;">First Subnet Ranges</span>
        <ul id="v6-delegated-list" style="font-family: var(--font-mono); font-size: 0.75rem; display: flex; flex-direction: column; gap: 0.35rem; list-style-type: none;">
          <!-- Rendered client side -->
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  import { expandIPv6, compressIPv6, classifyIPv6, splitIPv6Range } from '../utils/subnetMath';

  function initIPv6Calculator() {
    // DOM
    const v6IpInput = document.getElementById('v6-ip-address') as HTMLInputElement;
    const v6PrefixInput = document.getElementById('v6-prefix') as HTMLInputElement;
    const v6PrefixSlider = document.getElementById('v6-prefix-slider') as HTMLInputElement;
    const errorBanner = document.getElementById('v6-ip-error');
    const targetPrefixSelect = document.getElementById('v6-delegator-prefix') as HTMLSelectElement;

    if (!v6IpInput || !v6PrefixInput || !v6PrefixSlider || !targetPrefixSelect) return;

    // Outputs
    const compOutput = document.getElementById('v6-res-compressed');
    const expOutput = document.getElementById('v6-res-expanded');
    const typeOutput = document.getElementById('v6-res-type');
    const rangeOutput = document.getElementById('v6-res-range');
    const hostsOutput = document.getElementById('v6-res-hosts');
    
    const delegatedCount = document.getElementById('v6-delegated-count');
    const delegatedList = document.getElementById('v6-delegated-list');
    const copyBtn = document.getElementById('copy-ipv6-json');

    function validateIPv6(address: string): boolean {
      const regex = /^(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{1,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))$/;
      return regex.test(address.trim());
    }

    function getIPv6SubnetBounds(expanded: string, prefix: number): { start: string; end: string } {
      const fields = expanded.split(':').map(val => parseInt(val, 16));
      const startFields = [...fields];
      const endFields = [...fields];

      for (let i = 0; i < 8; i++) {
        const fieldStartBit = i * 16;
        const fieldEndBit = (i + 1) * 16;

        if (prefix <= fieldStartBit) {
          startFields[i] = 0x0000;
          endFields[i] = 0xFFFF;
        } else if (prefix < fieldEndBit) {
          const fieldBits = prefix - fieldStartBit;
          const mask = (~0 << (16 - fieldBits)) & 0xFFFF;
          
          startFields[i] = (fields[i] & mask) & 0xFFFF;
          endFields[i] = (fields[i] | (~mask & 0xFFFF)) & 0xFFFF;
        }
      }

      const startHex = startFields.map(v => v.toString(16).padStart(4, '0')).join(':');
      const endHex = endFields.map(v => v.toString(16).padStart(4, '0')).join(':');

      return {
        start: compressIPv6(startHex),
        end: compressIPv6(endHex)
      };
    }

    function calculateIPv6() {
      const ip = v6IpInput.value.trim();
      const prefix = parseInt(v6PrefixInput.value, 10);
      const targetPrefix = parseInt(targetPrefixSelect.value, 10);

      if (!validateIPv6(ip)) {
        errorBanner?.classList.add('show');
        return;
      } else {
        errorBanner?.classList.remove('show');
      }

      const expanded = expandIPv6(ip);
      const compressed = compressIPv6(expanded);
      const classification = classifyIPv6(expanded);
      const bounds = getIPv6SubnetBounds(expanded, prefix);
      
      // Address Capacity
      const hostBits = 128 - prefix;
      let hostsDisplay = "";
      if (hostBits >= 53) {
        const log10 = hostBits * Math.log10(2);
        const exponent = Math.floor(log10);
        const mantissa = Math.pow(10, log10 - exponent);
        hostsDisplay = `${mantissa.toFixed(3)}e+${exponent} IPs`;
      } else {
        hostsDisplay = `${Math.pow(2, hostBits).toLocaleString()} IPs`;
      }

      // Update fields
      if (compOutput) compOutput.innerText = `${compressed}/${prefix}`;
      if (expOutput) expOutput.innerText = expanded;
      if (typeOutput) typeOutput.innerText = classification.type;
      if (rangeOutput) rangeOutput.innerText = `${bounds.start} - ${bounds.end}`;
      if (hostsOutput) hostsOutput.innerText = hostsDisplay;

      // Delegations calculations
      if (targetPrefix < prefix) {
        const nextBound = Math.min(128, prefix + 8 - (prefix % 8 || 8));
        targetPrefixSelect.value = nextBound.toString();
        calculateIPv6();
        return;
      }

      const difference = targetPrefix - prefix;
      let subnetsCountDisplay = "";
      if (difference >= 53) {
        const log10 = difference * Math.log10(2);
        const exponent = Math.floor(log10);
        const mantissa = Math.pow(10, log10 - exponent);
        subnetsCountDisplay = `${mantissa.toFixed(2)}e+${exponent}`;
      } else {
        subnetsCountDisplay = Math.pow(2, difference).toLocaleString();
      }

      if (delegatedCount) delegatedCount.innerText = subnetsCountDisplay;

      // Split ranges to list
      const rangesList = splitIPv6Range(compressed, prefix, targetPrefix);
      if (delegatedList) {
        delegatedList.innerHTML = rangesList.map(item => `
          <li style="color:var(--text-secondary); padding: 0.15rem 0; border-bottom:1px solid var(--border-color); display:flex; justify-content:space-between;">
            <span>${item}</span>
          </li>
        `).join('');
      }
    }

    // Bind Listeners
    v6IpInput.oninput = calculateIPv6;
    v6PrefixInput.oninput = (e) => {
      const val = parseInt((e.target as HTMLInputElement).value, 10);
      if (!isNaN(val) && val >= 0 && val <= 128) {
        v6PrefixSlider.value = val.toString();
        calculateIPv6();
      }
    };

    v6PrefixSlider.oninput = (e) => {
      const val = (e.target as HTMLInputElement).value;
      v6PrefixInput.value = val;
      calculateIPv6();
    };

    targetPrefixSelect.onchange = calculateIPv6;

    // Copy JSON
    if (copyBtn) {
      copyBtn.onclick = async () => {
        const ip = v6IpInput.value.trim();
        const prefix = parseInt(v6PrefixInput.value, 10);
        if (!validateIPv6(ip)) return;
        
        const exp = expandIPv6(ip);
        const bounds = getIPv6SubnetBounds(exp, prefix);
        const classification = classifyIPv6(exp);

        const data = {
          ipv6_address: ip,
          prefix_length: prefix,
          expanded: exp,
          compressed: compressIPv6(exp),
          type: classification.type,
          description: classification.description,
          range: bounds
        };

        await navigator.clipboard.writeText(JSON.stringify(data, null, 2));
        copyBtn.innerText = 'Copied!';
        copyBtn.classList.add('copied');
        setTimeout(() => {
          copyBtn.innerText = 'Copy JSON';
          copyBtn.classList.remove('copied');
        }, 2000);
      };
    }

    // Check URL params on mount
    const params = new URLSearchParams(window.location.search);
    const v6Ip = params.get('v6_ip');
    const v6Prefix = params.get('v6_prefix');

    if (v6Ip && validateIPv6(v6Ip)) v6IpInput.value = v6Ip;
    if (v6Prefix) {
      const pNum = parseInt(v6Prefix, 10);
      if (pNum >= 0 && pNum <= 128) {
        v6PrefixInput.value = pNum.toString();
        v6PrefixSlider.value = pNum.toString();
      }
    }
    
    calculateIPv6();
  }

  document.addEventListener('astro:page-load', initIPv6Calculator);
  initIPv6Calculator();
</script>
