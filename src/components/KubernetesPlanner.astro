---
interface Props {
  defaultPodCidr?: string;
  defaultPodCidrPrefix?: number;
  defaultNodes?: number;
  defaultPodsPerNode?: number;
}

const {
  defaultPodCidr = "10.244.0.0",
  defaultPodCidrPrefix = 16,
  defaultNodes = 100,
  defaultPodsPerNode = 110
} = Astro.props;
---

<div class="calculator-layout">
  <!-- Left Column: Inputs and Stats -->
  <div class="calculator-panel">
    <div class="panel-heading">
      <div>
        <span class="step">01</span>
        <h2>Kubernetes Cluster Parameters</h2>
      </div>
      <span class="live-label" style="background-color:rgba(145, 80, 245, 0.12); color:var(--accent-host);">K8s PRE-FLIGHT</span>
    </div>

    <!-- Pod network range inputs -->
    <div class="input-grid-2-1">
      <div class="input-row">
        <label for="k8s-pod-cidr">Pod Network CIDR Block</label>
        <div class="ip-input">
          <input 
            type="text" 
            id="k8s-pod-cidr" 
            value={defaultPodCidr} 
            placeholder="e.g., 10.244.0.0" 
            inputmode="decimal" 
          />
          <span class="slash">/</span>
          <input 
            type="number" 
            id="k8s-pod-cidr-prefix" 
            value={defaultPodCidrPrefix} 
            min="8" 
            max="28"
          />
        </div>
      </div>

      <div class="input-row">
        <label for="k8s-pods-per-node">Max Pods / Node</label>
        <div class="select-wrapper">
          <select id="k8s-pods-per-node">
            <option value="110" selected={defaultPodsPerNode === 110}>110 (Standard Default)</option>
            <option value="64" selected={defaultPodsPerNode === 64}>64 (Azure Default)</option>
            <option value="30" selected={defaultPodsPerNode === 30}>30 (GCP Default / Small VMs)</option>
            <option value="250" selected={defaultPodsPerNode === 250}>250 (High Density Cluster)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Expected Node Scale -->
    <div class="input-row">
      <div style="display:flex; justify-content:space-between;">
        <label for="k8s-nodes-count">Target Node Capacity Scale</label>
        <span id="k8s-nodes-label" style="font-family:var(--font-mono); font-weight:600; color:var(--accent-network);">{defaultNodes} Nodes</span>
      </div>
      <div class="slider-container">
        <input 
          type="range" 
          id="k8s-nodes-count" 
          min="5" 
          max="1000" 
          step="5"
          value={defaultNodes} 
          aria-label="Expected node scale slider"
        />
      </div>
    </div>

    <!-- Service CIDR range check -->
    <div class="input-row">
      <label for="k8s-service-cidr">Service CIDR Range (ClusterIPs)</label>
      <div class="ip-input">
        <input 
          type="text" 
          id="k8s-service-cidr" 
          value="10.96.0.0" 
          placeholder="e.g., 10.96.0.0" 
          inputmode="decimal" 
        />
        <span class="slash">/</span>
        <input 
          type="number" 
          id="k8s-service-cidr-prefix" 
          value="12" 
          min="8" 
          max="28"
        />
      </div>
    </div>

    <!-- Cluster Utilization Warning Banner -->
    <div class="k8s-warning-panel" id="k8s-warning-box">
      <!-- Generated Client-side -->
    </div>

    <!-- Results Display -->
    <div class="result-heading">
      <div>
        <span class="step">02</span>
        <h2>Cluster Allocation Capacity</h2>
      </div>
      <button class="copy-button" type="button" id="copy-k8s-json">Copy JSON</button>
    </div>

    <div class="k8s-metrics-row">
      <div class="metric-card">
        <span>Node IP Allocation</span>
        <strong id="k8s-res-node-block">/24</strong>
        <small style="color:var(--text-muted);" id="k8s-res-node-ips">256 IPs per Node</small>
      </div>

      <div class="metric-card">
        <span>Max Node Capacity</span>
        <strong id="k8s-res-max-nodes">256</strong>
        <span class="status-indicator safe" id="k8s-res-nodes-status">Supported</span>
      </div>

      <div class="metric-card">
        <span>Max Pod Scale</span>
        <strong id="k8s-res-max-pods">11,000</strong>
        <small style="color:var(--text-muted);">Total usable pod IPs</small>
      </div>
    </div>
  </div>

  <!-- Right Column: Visual Analysis -->
  <div class="insight-panel">
    <div class="calculator-panel" style="gap: 1.5rem;">
      <div>
        <span class="aside-kicker">KUBERNETES ANALYSIS</span>
        <h2>IP Allocation Grid</h2>
      </div>
      <p class="aside-copy">
        Visualization of the cluster Pod CIDR range usage. A higher utilisation block indicates potential scaling problems.
      </p>

      <div class="capacity">
        <div>
          <span>TOTAL CIDR IP CAPACITY</span>
          <strong id="k8s-total-ips">65,536</strong>
        </div>
        <span class="capacity-unit">Addresses total</span>
      </div>

      <div class="capacity" style="background-color:rgba(145, 80, 245, 0.03); border-color:rgba(145, 80, 245, 0.1);">
        <div>
          <span>CLUSTER IP UTILISATION</span>
          <strong id="k8s-util-pct" style="color:var(--accent-host);">16.7%</strong>
        </div>
        <span class="capacity-unit" id="k8s-util-status">Safe</span>
      </div>

      <div class="scale-visualizer">
        <div class="scale-fill" id="k8s-scale-fill" style="width: 16.7%; background: linear-gradient(90deg, var(--accent-network), var(--accent-host));"></div>
        <span class="scale-label" id="k8s-scale-label">Utilisation: 16.7%</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { validateIPv4, ip2Long } from '../utils/subnetMath';

  function initK8sPlanner() {
    // DOM elements
    const podCidrInput = document.getElementById('k8s-pod-cidr') as HTMLInputElement;
    const podPrefixInput = document.getElementById('k8s-pod-cidr-prefix') as HTMLInputElement;
    const podsPerNodeSelect = document.getElementById('k8s-pods-per-node') as HTMLSelectElement;
    const nodesInput = document.getElementById('k8s-nodes-count') as HTMLInputElement;
    const nodesLabel = document.getElementById('k8s-nodes-label');
    
    const svcIpInput = document.getElementById('k8s-service-cidr') as HTMLInputElement;
    const svcPrefixInput = document.getElementById('k8s-service-cidr-prefix') as HTMLInputElement;

    if (!podCidrInput || !podPrefixInput || !podsPerNodeSelect || !nodesInput || !svcIpInput || !svcPrefixInput) return;
    
    // Display elements
    const nodeBlockDisplay = document.getElementById('k8s-res-node-block');
    const nodeIpsDisplay = document.getElementById('k8s-res-node-ips');
    const maxNodesDisplay = document.getElementById('k8s-res-max-nodes');
    const nodesStatusDisplay = document.getElementById('k8s-res-nodes-status');
    const maxPodsDisplay = document.getElementById('k8s-res-max-pods');
    const warningBox = document.getElementById('k8s-warning-box');
    
    const totalIpsDisplay = document.getElementById('k8s-total-ips');
    const utilPctDisplay = document.getElementById('k8s-util-pct');
    const utilStatusDisplay = document.getElementById('k8s-util-status');
    const scaleFill = document.getElementById('k8s-scale-fill');
    const scaleLabel = document.getElementById('k8s-scale-label');
    const copyBtn = document.getElementById('copy-k8s-json');

    function checkCidrOverlap(ip1: string, prefix1: number, ip2: string, prefix2: number): boolean {
      if (!validateIPv4(ip1) || !validateIPv4(ip2)) return false;
      
      const long1 = ip2Long(ip1);
      const long2 = ip2Long(ip2);
      
      const minPrefix = Math.min(prefix1, prefix2);
      const minMask = minPrefix === 0 ? 0 : (~0 << (32 - minPrefix)) >>> 0;
      
      return (long1 & minMask) === (long2 & minMask);
    }

    function calculateK8sPlanner() {
      const podIp = podCidrInput.value.trim();
      const podPrefix = parseInt(podPrefixInput.value, 10);
      const podsPerNode = parseInt(podsPerNodeSelect.value, 10);
      const expectedNodes = parseInt(nodesInput.value, 10);
      
      const svcIp = svcIpInput.value.trim();
      const svcPrefix = parseInt(svcPrefixInput.value, 10);

      // Dynamic slider label update
      if (nodesLabel) nodesLabel.innerText = `${expectedNodes} Nodes`;

      // Validate inputs
      if (!validateIPv4(podIp) || isNaN(podPrefix)) {
        if (warningBox) {
          warningBox.className = 'k8s-warning-panel danger';
          warningBox.innerHTML = '<strong>Error:</strong> Invalid Pod Network Address or CIDR.';
        }
        return;
      }

      let nodeSubnetPrefix = 24;
      if (podsPerNode <= 30) nodeSubnetPrefix = 26;
      else if (podsPerNode <= 64) nodeSubnetPrefix = 25;
      else if (podsPerNode <= 110) nodeSubnetPrefix = 24;
      else if (podsPerNode <= 250) nodeSubnetPrefix = 23;

      // Calculations
      const totalPodIps = Math.pow(2, 32 - podPrefix);
      const ipsPerNode = Math.pow(2, 32 - nodeSubnetPrefix);
      const maxNodesSupported = Math.floor(totalPodIps / ipsPerNode);
      const maxPodsSupported = expectedNodes * podsPerNode;
      
      // Utilization
      const utilizedIps = expectedNodes * ipsPerNode;
      const utilizationRate = Math.min(100, (utilizedIps / totalPodIps) * 100);
      
      // Update simple outputs
      if (nodeBlockDisplay) nodeBlockDisplay.innerText = `/${nodeSubnetPrefix}`;
      if (nodeIpsDisplay) nodeIpsDisplay.innerText = `${ipsPerNode} IPs per Node`;
      if (maxNodesDisplay) maxNodesDisplay.innerText = maxNodesSupported.toLocaleString();
      if (maxPodsDisplay) maxPodsDisplay.innerText = maxPodsSupported.toLocaleString();
      if (totalIpsDisplay) totalIpsDisplay.innerText = totalPodIps.toLocaleString();
      if (utilPctDisplay) utilPctDisplay.innerText = `${utilizationRate.toFixed(1)}%`;
      
      if (scaleFill) scaleFill.style.width = `${utilizationRate}%`;
      if (scaleLabel) scaleLabel.innerText = `IP Utilization: ${utilizationRate.toFixed(1)}%`;

      // Warnings and overlapping validations
      let overlaps = false;
      if (validateIPv4(svcIp) && !isNaN(svcPrefix)) {
        overlaps = checkCidrOverlap(podIp, podPrefix, svcIp, svcPrefix);
      }

      let warningHtml = '';
      let statusClass = 'safe';
      let statusText = 'Supported';

      if (expectedNodes > maxNodesSupported) {
        statusClass = 'danger';
        statusText = 'IP Exhaustion';
        warningHtml += `<p style="margin-bottom: 0.5rem;">🚨 <strong>IP Exhaustion Warning:</strong> Your expected cluster node scale (${expectedNodes} nodes) exceeds the maximum nodes supported (${maxNodesSupported}) by a <code>/${podPrefix}</code> pod network block. Expand the CIDR block or reduce max pods per node.</p>`;
      } else if (utilizationRate > 80) {
        statusClass = 'warn';
        statusText = 'Tight Capacity';
        warningHtml += `<p style="margin-bottom: 0.5rem;">⚠️ <strong>High Utilization:</strong> Cluster is utilizing ${utilizationRate.toFixed(1)}% of available IP space. Minimal headroom left for auto-scaling.</p>`;
      }

      if (overlaps) {
        warningHtml += `<p>🚫 <strong>Critical Overlap:</strong> Pod Network (<code>${podIp}/${podPrefix}</code>) overlaps with Service CIDR (<code>${svcIp}/${svcPrefix}</code>). This will cause routing failures in the cluster.</p>`;
        statusClass = 'danger';
      }

      if (warningHtml === '') {
        warningHtml = '<p>✅ <strong>Cluster Configuration Safe:</strong> Pod network has sufficient IP allocation capacity for expected scaling and node density rules.</p>';
      }

      if (warningBox) {
        warningBox.className = `k8s-warning-panel ${statusClass === 'danger' ? 'danger' : 'safe'}`;
        warningBox.innerHTML = warningHtml;
      }

      if (nodesStatusDisplay) {
        nodesStatusDisplay.innerText = statusText;
        nodesStatusDisplay.className = `status-indicator ${statusClass}`;
      }

      if (utilStatusDisplay) {
        utilStatusDisplay.innerText = statusText;
        utilStatusDisplay.className = `capacity-unit status-indicator ${statusClass}`;
      }
    }

    // Bind Listeners
    podCidrInput.oninput = calculateK8sPlanner;
    podPrefixInput.oninput = calculateK8sPlanner;
    podsPerNodeSelect.onchange = calculateK8sPlanner;
    nodesInput.oninput = calculateK8sPlanner;
    svcIpInput.oninput = calculateK8sPlanner;
    svcPrefixInput.oninput = calculateK8sPlanner;

    // Copy JSON
    if (copyBtn) {
      copyBtn.onclick = async () => {
        const podIp = podCidrInput.value.trim();
        const podPrefix = parseInt(podPrefixInput.value, 10);
        const podsPerNode = parseInt(podsPerNodeSelect.value, 10);
        const expectedNodes = parseInt(nodesInput.value, 10);
        
        let nodeSubnetPrefix = 24;
        if (podsPerNode <= 30) nodeSubnetPrefix = 26;
        else if (podsPerNode <= 64) nodeSubnetPrefix = 25;
        else if (podsPerNode <= 110) nodeSubnetPrefix = 24;
        else if (podsPerNode <= 250) nodeSubnetPrefix = 23;

        const data = {
          pod_cidr: `${podIp}/${podPrefix}`,
          pods_per_node: podsPerNode,
          node_subnet_size: `/${nodeSubnetPrefix}`,
          expected_nodes: expectedNodes,
          max_nodes_supported: Math.floor(Math.pow(2, 32 - podPrefix) / Math.pow(2, 32 - nodeSubnetPrefix)),
          total_cluster_pod_ips_capacity: expectedNodes * podsPerNode,
          utilization_rate: `${((expectedNodes * Math.pow(2, 32 - nodeSubnetPrefix)) / Math.pow(2, 32 - podPrefix) * 100).toFixed(1)}%`
        };

        await navigator.clipboard.writeText(JSON.stringify(data, null, 2));
        copyBtn.innerText = 'Copied!';
        copyBtn.classList.add('copied');
        setTimeout(() => {
          copyBtn.innerText = 'Copy JSON';
          copyBtn.classList.remove('copied');
        }, 2000);
      };
    }

    // Check URL params on mount
    const params = new URLSearchParams(window.location.search);
    const podIp = params.get('pod_ip');
    const podPrefix = params.get('pod_prefix');
    const podsPerNode = params.get('pods_per_node');
    const nodes = params.get('nodes');

    if (podIp && validateIPv4(podIp)) podCidrInput.value = podIp;
    if (podPrefix) podPrefixInput.value = podPrefix;
    if (podsPerNode) podsPerNodeSelect.value = podsPerNode;
    if (nodes) {
      nodesInput.value = nodes;
      if (nodesLabel) nodesLabel.innerText = `${nodes} Nodes`;
    }
    
    calculateK8sPlanner();
  }

  document.addEventListener('astro:page-load', initK8sPlanner);
  initK8sPlanner();
</script>
