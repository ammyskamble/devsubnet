---import { type SupportedLanguage } from '../../utils/i18n';

import Layout from '../../layouts/Layout.astro';
import MainShell from '../../components/MainShell.astro';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout 
  lang={lang}
  title="Calcolatore di subnet IPv6 e delega dei prefissi | DevSubnet"
  description="Comprimi, espandi indirizzi IPv6 e calcola le subnet con delega dei prefissi (/48, /56, /64) all'istante."
>
  <MainShell activeTab="ipv6" navPath="ipv6-subnet-calculator" lang={lang} />
</Layout>
