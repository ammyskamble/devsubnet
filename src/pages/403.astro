---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import { type SupportedLanguage } from '../utils/i18n';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout 
  lang={lang} 
  noindex={true}
  title="403 – Access Forbidden | DevSubnet"
  description="Access to this resource has been denied by network access control policies or firewall rules. Return to DevSubnet's calculators."
>
  <div class="app-shell">
    <NavBar lang={lang} path="error" />

    <main class="error-main">
      <div class="error-container">
        <!-- Diagnostic Status Pill -->
        <div class="status-badge" role="status">
          <span class="shield-dot">🛡️</span>
          <span class="badge-code">ERR_403_ACL_REJECTED</span>
        </div>

        <h1 class="error-title">
          <span class="code-number">403</span>
          <span class="title-text">Access Policy Denied</span>
        </h1>

        <p class="error-description">
          The security perimeter rejected this request. An Access Control List (ACL), Cloudflare WAF rule, or rate-limiting threshold prevented inbound transmission.
        </p>

        <!-- Visual Firewall ACL Diagram -->
        <div class="security-diagram-card" aria-hidden="true">
          <div class="firewall-grid">
            <div class="traffic-source">
              <span class="source-icon">💻</span>
              <span class="source-text">Client IP</span>
            </div>
            <div class="firewall-barrier">
              <div class="shield-box">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shield-svg"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>WAF / ACL</span>
              </div>
              <div class="drop-line">
                <span class="blocked-tag">DENY ALL</span>
              </div>
            </div>
            <div class="traffic-target protected">
              <span class="target-icon">🔒</span>
              <span class="target-text">Protected Host</span>
            </div>
          </div>
          <div class="security-log">
            <code>[SECURITY INGRESS] Packet from source IP dropped by policy rule #0x403-ACL-STRICT</code>
          </div>
        </div>

        <!-- Troubleshooting Suggestions -->
        <div class="troubleshoot-card">
          <h2 class="card-title">Recommended Troubleshooting Steps</h2>
          <ul class="steps-list">
            <li>
              <strong>Check VPN / Corporate Proxy:</strong> If you are connecting through a datacenter or VPN IP, disengage it and try direct routing.
            </li>
            <li>
              <strong>Rate Limiting:</strong> If you performed rapid automated calculations, wait a few moments before refreshing.
            </li>
            <li>
              <strong>Public Calculators:</strong> All standard subnet calculations run entirely client-side without requiring authenticated privileges.
            </li>
          </ul>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
          <a href="/" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Return to Calculator
          </a>
          <a href="/contact" class="btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Contact Network Support
          </a>
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<style>
  .error-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3.5rem 1.5rem 5rem;
    min-height: calc(100vh - 180px);
  }

  .error-container {
    max-width: 44rem;
    width: 100%;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Status Badge */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .shield-dot {
    font-size: 0.9rem;
    line-height: 1;
  }

  /* Error Heading */
  .error-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .code-number {
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 9vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    background: linear-gradient(135deg, #fbbf24 0%, #f97316 50%, #ef4444 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .title-text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .error-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 34rem;
    margin: 0 0 2.25rem;
  }

  /* Security Diagram */
  .security-diagram-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem 2rem;
    width: 100%;
    margin-bottom: 2rem;
    backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-md);
  }

  .firewall-grid {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 1rem;
    padding: 1rem 0;
  }

  .traffic-source, .traffic-target {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .source-icon, .target-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
  }

  .source-text, .target-text {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .firewall-barrier {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .shield-box {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #f87171;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .shield-svg {
    stroke: #ef4444;
  }

  .blocked-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 800;
    color: #ef4444;
    background: rgba(239, 68, 68, 0.15);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.05em;
  }

  .security-log {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
    text-align: left;
    overflow-x: auto;
  }

  .security-log code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #fbbf24;
  }

  /* Troubleshoot Card */
  .troubleshoot-card {
    background: var(--panel-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem 2rem;
    width: 100%;
    text-align: left;
    margin-bottom: 2.5rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }

  .steps-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .steps-list strong {
    color: var(--text-primary);
  }

  /* Actions */
  .action-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    color: #ffffff;
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .btn-secondary:hover {
    background: var(--bg-secondary);
    border-color: rgba(161, 66, 244, 0.4);
  }
</style>
