---
import { type SupportedLanguage, translations } from '../utils/i18n';
import Layout from '../layouts/Layout.astro';
import MainShell from '../components/MainShell.astro';
import { pageCommonI18n } from '../utils/pages-i18n';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
const t = translations[lang] || translations.en;
const common = pageCommonI18n[lang] || pageCommonI18n.en;
const homeUrl = lang === 'en' ? '/' : `/${lang}/`;
---

<Layout lang={lang}
  title="Subnet Calculator for Students | DevSubnet"
  description="Free IP subnet calculator designed for CCNA/CCNP students and networking learners. All calculations run locally in your browser."
>
  <MainShell activeTab="ipv4" defaultCloud="standard" lang={lang}>

    <!-- Student-focused FAQ -->
    <section class="faq-section" style="margin-top: 4rem; padding: 2rem; background: var(--card-bg, rgba(255, 255, 255, 0.03)); border-radius: var(--radius-md);">
      <h2 style="font-size: 1.3rem; margin-bottom: 1rem;">Student FAQ</h2>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <details>
          <summary>What is a subnet?</summary>
          <p>A subnet is a logical subdivision of an IP network. Used for organizing traffic, improving security, and efficient IP address allocation.</p>
        </details>
        <details>
          <summary>What is CIDR notation?</summary>
          <p>CIDR (Classless Inter-Domain Routing) is a compact way to represent an IP address and its network prefix, using slash notation (e.g., /24).</p>
        </details>
        <details>
          <summary>How many hosts in a /24 subnet?</summary>
          <p>A /24 subnet has 256 total IP addresses. After subtracting the network and broadcast addresses, 254 are usable for hosts.</p>
        </details>
        <details>
          <summary>What does the calculator show?</summary>
          <p>The calculator shows the network address, netmask, broadcast address, first and last usable host, and total usable hosts per subnet.</p>
        </details>
      </div>
    </section>

    <div class="page-cta" style="margin-top: 3rem;">
      <a href={homeUrl} class="btn-return">← {common.backToCalc}</a>
    </div>
  </MainShell>
</Layout>

<style>
  .faq-section details {
    margin-bottom: 0.5rem;
  }

  .faq-section summary {
    font-weight: 600;
    cursor: pointer;
    padding: 0.5rem 0;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
  }

  .faq-section summary:hover {
    background: rgba(var(--accent-network-rgb, 56, 189, 248), 0.1);
  }
</style>