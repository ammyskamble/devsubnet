---
// BitwiseVisualizer.astro - Interactive Bitwise AND Subnetting Simulator
---

<div class="bitwise-widget" id="bitwise-widget">
  <div class="widget-header">
    <div class="widget-title-group">
      <span class="widget-icon">⚡</span>
      <div>
        <h3 class="widget-title">Live Bitwise AND Subnet Simulator</h3>
        <p class="widget-subtitle">Watch the router's hardware logic compute the network address in real time.</p>
      </div>
    </div>
    <div class="quick-presets">
      <span class="preset-label">Presets:</span>
      <button type="button" class="preset-btn" data-ip="192.168.1.75" data-cidr="24">192.168.1.75/24</button>
      <button type="button" class="preset-btn" data-ip="10.240.12.19" data-cidr="16">10.240.12.19/16</button>
      <button type="button" class="preset-btn" data-ip="172.16.88.200" data-cidr="20">172.16.88.200/20</button>
    </div>
  </div>

  <div class="simulator-inputs">
    <div class="input-field">
      <label for="sim-ip">IPv4 Address:</label>
      <input type="text" id="sim-ip" value="192.168.1.75" placeholder="e.g. 192.168.1.1" spellcheck="false" autocomplete="off" />
    </div>
    <div class="input-field">
      <label for="sim-cidr">Prefix Length (CIDR):</label>
      <div class="cidr-control">
        <input type="range" id="sim-cidr-range" min="1" max="30" value="24" />
        <span class="cidr-badge" id="sim-cidr-val">/24</span>
      </div>
    </div>
  </div>

  <!-- Real-time Bitwise Grid -->
  <div class="table-scroll-hint" aria-hidden="true">
    <span>↔ Swipe table to inspect all 32 bits</span>
  </div>
  <div class="bitwise-table-container">
    <table class="bitwise-table">
      <thead>
        <tr>
          <th class="row-label-th">Component</th>
          <th class="decimal-th">Decimal</th>
          <th class="binary-th">
            <span class="header-full">32-Bit Binary Representation (Network Bits in Blue, Host Bits in Purple)</span>
            <span class="header-compact">32-Bit Binary</span>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr class="row-ip">
          <td class="row-title">IP Address</td>
          <td class="row-dec" id="display-ip-dec">192.168.1.75</td>
          <td class="row-bin font-mono" id="display-ip-bin"></td>
        </tr>
        <tr class="row-op">
          <td colspan="3" class="operation-indicator">
            <span class="op-badge">&amp; (Bitwise Boolean AND Operation: 1 &amp; 1 = 1, otherwise 0)</span>
          </td>
        </tr>
        <tr class="row-mask">
          <td class="row-title">Subnet Mask</td>
          <td class="row-dec" id="display-mask-dec">255.255.255.0</td>
          <td class="row-bin font-mono" id="display-mask-bin"></td>
        </tr>
        <tr class="row-result">
          <td class="row-title highlight-res">Network ID</td>
          <td class="row-dec highlight-res" id="display-net-dec">192.168.1.0</td>
          <td class="row-bin font-mono highlight-res" id="display-net-bin"></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="simulator-summary">
    <div class="stat-card">
      <span class="stat-label">Network Prefix</span>
      <strong class="stat-val text-network" id="stat-net-bits">24 bits</strong>
    </div>
    <div class="stat-card">
      <span class="stat-label">Host Space</span>
      <strong class="stat-val text-host" id="stat-host-bits">8 bits (254 usable IPs)</strong>
    </div>
    <div class="stat-card">
      <span class="stat-label">Broadcast Address</span>
      <strong class="stat-val text-highlight" id="stat-broadcast">192.168.1.255</strong>
    </div>
    <div class="stat-card">
      <span class="stat-label">Usable Host Range</span>
      <strong class="stat-val" id="stat-range">192.168.1.1 – 192.168.1.254</strong>
    </div>
  </div>
</div>

<style>
  .bitwise-widget {
    background: var(--panel-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    margin: 2.5rem 0;
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
  }

  .bitwise-widget::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--gemini-gradient);
  }

  .widget-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .widget-title-group {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .widget-icon {
    font-size: 1.75rem;
    background: rgba(59, 130, 246, 0.15);
    border-radius: var(--radius-md);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .widget-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
  }

  .widget-subtitle {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0.2rem 0 0 0;
  }

  .quick-presets {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .preset-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .preset-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.6rem;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .preset-btn:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: var(--accent-network);
    color: var(--text-primary);
  }

  .simulator-inputs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.75rem;
    background: rgba(0, 0, 0, 0.15);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }

  .input-field label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
  }

  .input-field input[type="text"] {
    width: 100%;
    background: var(--bg-input);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text-primary);
    outline: none;
    box-sizing: border-box;
  }

  .input-field input[type="text"]:focus {
    border-color: var(--accent-network);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
  }

  .cidr-control {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .cidr-control input[type="range"] {
    flex: 1;
    accent-color: var(--accent-network);
    cursor: pointer;
  }

  .cidr-badge {
    background: var(--accent-network);
    color: #ffffff;
    font-family: var(--font-mono);
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    min-width: 48px;
    text-align: center;
    font-size: 0.95rem;
  }

  .bitwise-table-container {
    overflow-x: auto;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
    background: var(--bg-surface);
  }

  .bitwise-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .bitwise-table th, .bitwise-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .bitwise-table th {
    background: rgba(0, 0, 0, 0.25);
    font-weight: 600;
    color: var(--text-muted);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .row-title {
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    width: 130px;
  }

  .row-dec {
    font-family: var(--font-mono);
    color: var(--text-secondary);
    white-space: nowrap;
    width: 140px;
  }

  .row-bin {
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .operation-indicator {
    padding: 0.35rem 1rem !important;
    background: rgba(59, 130, 246, 0.08);
    text-align: center;
  }

  .op-badge {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-network);
    font-weight: 600;
  }

  .highlight-res {
    background: rgba(59, 130, 246, 0.12);
    color: var(--accent-network) !important;
    font-weight: 700 !important;
  }

  :global(.bit-net) {
    color: #60a5fa;
    font-weight: 700;
    background: rgba(59, 130, 246, 0.15);
    padding: 0 1px;
    border-radius: 2px;
  }

  :global(.bit-host) {
    color: #c084fc;
    opacity: 0.85;
    padding: 0 1px;
  }

  :global(.bit-octet-sep) {
    color: var(--text-muted);
    opacity: 0.4;
    margin: 0 3px;
  }

  .table-scroll-hint {
    display: none;
    font-size: 0.75rem;
    color: var(--accent-network);
    margin-bottom: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: right;
  }

  .header-compact {
    display: none;
  }

  @media (max-width: 768px) {
    .table-scroll-hint {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .header-full {
      display: none;
    }
    .header-compact {
      display: inline;
    }
    .bitwise-widget {
      padding: 1.25rem 0.85rem;
      margin: 1.75rem 0;
    }
    .simulator-inputs {
      padding: 1rem 0.75rem;
      gap: 1rem;
    }
  }

  .preset-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.75rem;
    min-height: 38px;
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: all var(--transition-fast);
    touch-action: manipulation;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .preset-btn:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: var(--accent-network);
    color: var(--text-primary);
  }

  .simulator-summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
  }

  @media (max-width: 540px) {
    .simulator-summary {
      grid-template-columns: 1fr;
    }
    .stat-val {
      font-size: 0.95rem;
      word-break: break-word;
    }
  }

  .stat-card {
    background: rgba(0, 0, 0, 0.15);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .stat-val {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .text-network { color: #60a5fa; }
  .text-host { color: #c084fc; }
  .text-highlight { color: #f59e0b; }
</style>

<script>
  function initBitwiseSimulator() {
    const ipInput = document.getElementById('sim-ip') as HTMLInputElement;
    const cidrRange = document.getElementById('sim-cidr-range') as HTMLInputElement;
    const cidrVal = document.getElementById('sim-cidr-val');
    
    const displayIpDec = document.getElementById('display-ip-dec');
    const displayIpBin = document.getElementById('display-ip-bin');
    const displayMaskDec = document.getElementById('display-mask-dec');
    const displayMaskBin = document.getElementById('display-mask-bin');
    const displayNetDec = document.getElementById('display-net-dec');
    const displayNetBin = document.getElementById('display-net-bin');

    const statNetBits = document.getElementById('stat-net-bits');
    const statHostBits = document.getElementById('stat-host-bits');
    const statBroadcast = document.getElementById('stat-broadcast');
    const statRange = document.getElementById('stat-range');

    if (!ipInput || !cidrRange) return;

    function ipToNumber(ip: string): number | null {
      const parts = ip.trim().split('.');
      if (parts.length !== 4) return null;
      let num = 0;
      for (let i = 0; i < 4; i++) {
        const p = parseInt(parts[i], 10);
        if (isNaN(p) || p < 0 || p > 255) return null;
        num = (num << 8) | p;
      }
      return num >>> 0;
    }

    function numberToIp(num: number): string {
      return [
        (num >>> 24) & 255,
        (num >>> 16) & 255,
        (num >>> 8) & 255,
        num & 255
      ].join('.');
    }

    function renderBinaryHtml(num: number, cidr: number): string {
      const binStr = (num >>> 0).toString(2).padStart(32, '0');
      let html = '';
      for (let i = 0; i < 32; i++) {
        if (i > 0 && i % 8 === 0) {
          html += `<span class="bit-octet-sep">.</span>`;
        }
        const bit = binStr[i];
        if (i < cidr) {
          html += `<span class="bit-net">${bit}</span>`;
        } else {
          html += `<span class="bit-host">${bit}</span>`;
        }
      }
      return html;
    }

    function update() {
      const ipStr = ipInput.value.trim();
      const cidr = parseInt(cidrRange.value, 10);
      if (cidrVal) cidrVal.textContent = `/${cidr}`;

      const ipNum = ipToNumber(ipStr);
      if (ipNum === null) {
        if (displayIpBin) displayIpBin.textContent = 'Invalid IPv4 address';
        return;
      }

      const maskNum = cidr === 0 ? 0 : (~0 << (32 - cidr)) >>> 0;
      const netNum = (ipNum & maskNum) >>> 0;
      const bcastNum = (netNum | (~maskNum >>> 0)) >>> 0;
      const hostBits = 32 - cidr;
      const totalHosts = Math.pow(2, hostBits);
      const usableHosts = totalHosts > 2 ? totalHosts - 2 : (totalHosts === 2 ? 2 : 1);

      if (displayIpDec) displayIpDec.textContent = numberToIp(ipNum);
      if (displayIpBin) displayIpBin.innerHTML = renderBinaryHtml(ipNum, cidr);

      if (displayMaskDec) displayMaskDec.textContent = numberToIp(maskNum);
      if (displayMaskBin) displayMaskBin.innerHTML = renderBinaryHtml(maskNum, cidr);

      if (displayNetDec) displayNetDec.textContent = numberToIp(netNum);
      if (displayNetBin) displayNetBin.innerHTML = renderBinaryHtml(netNum, cidr);

      if (statNetBits) statNetBits.textContent = `${cidr} bits`;
      if (statHostBits) statHostBits.textContent = `${hostBits} bits (${usableHosts.toLocaleString()} usable IPs)`;
      if (statBroadcast) statBroadcast.textContent = numberToIp(bcastNum);

      if (statRange) {
        if (cidr >= 31) {
          statRange.textContent = `${numberToIp(netNum)} – ${numberToIp(bcastNum)} (Point-to-Point)`;
        } else {
          statRange.textContent = `${numberToIp(netNum + 1)} – ${numberToIp(bcastNum - 1)}`;
        }
      }
    }

    ipInput.addEventListener('input', update);
    cidrRange.addEventListener('input', update);

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const ip = target.getAttribute('data-ip');
        const cidr = target.getAttribute('data-cidr');
        if (ip) ipInput.value = ip;
        if (cidr) cidrRange.value = cidr;
        update();
      });
    });

    update();
  }

  // Support both normal load and Astro view transitions
  initBitwiseSimulator();
  document.addEventListener('astro:page-load', initBitwiseSimulator);
</script>
