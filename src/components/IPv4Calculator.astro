---
import { calculateSubnet, getBinaryBits } from '../utils/subnetMath';
import { type SupportedLanguage } from '../utils/i18n';
import { calcTranslations } from '../utils/calc-i18n';

interface Props {
  defaultIp?: string;
  defaultCidr?: number;
  defaultCloud?: 'standard' | 'aws' | 'azure' | 'gcp';
  lang?: SupportedLanguage;
}

const { 
  defaultIp = "192.168.1.0", 
  defaultCidr = 24, 
  defaultCloud = "standard",
  lang = "en"
} = Astro.props;

// Calculate initial values for Server-Side Rendering (SEO & Instant first load)
const initialResult = calculateSubnet(defaultIp, defaultCidr, defaultCloud);
const initialBits = getBinaryBits(defaultIp, defaultCidr);
const calc = calcTranslations[lang] || calcTranslations.en;
---

<div class="calculator-layout" id="ipv4-calc-container" data-lang={lang} data-calc={JSON.stringify(calc)}>
  <!-- Left Column: Input and Details -->
  <div class="calculator-panel">
    <div class="panel-heading">
      <div>
        <span class="step">{calc.step1}</span>
        <h2>{calc.networkParamsTitle}</h2>
      </div>
      <span class="live-label">{calc.liveLabel}</span>
    </div>

    <!-- Grouped Inputs Card -->
    <div class="core-inputs-card">
      <!-- Inputs Row -->
      <div class="input-grid-2-1">
        <div class="input-row">
          <label for="ip-address" class="tooltip-trigger" data-tooltip={calc.ipAddressTooltip}>{calc.ipAddressLabel}</label>
          <div class="ip-input">
            <input 
              type="text" 
              id="ip-address" 
              value={defaultIp} 
              placeholder={calc.ipPlaceholder} 
              inputmode="decimal" 
              autocomplete="off" 
              maxlength="15"
            />
          </div>
        </div>

        <div class="input-row">
          <label for="cidr" class="tooltip-trigger" data-tooltip={calc.cidrTooltip}>{calc.cidrLabel}</label>
          <div class="ip-input">
            <span class="slash">/</span>
            <input 
              type="number" 
              id="cidr" 
              value={defaultCidr} 
              min="0" 
              max="32"
            />
          </div>
        </div>
      </div>

      <!-- Slider -->
      <div class="slider-container">
        <input 
          type="range" 
          id="cidr-slider" 
          value={defaultCidr} 
          min="0" 
          max="32"
          aria-label="CIDR prefix slider"
        />
      </div>

      <!-- Cloud Selector -->
      <div class="input-row">
        <label for="cloud-provider" class="tooltip-trigger" data-tooltip={calc.cloudTooltip}>{calc.cloudLabel}</label>
        <div class="select-wrapper">
          <select id="cloud-provider">
            <option value="standard" selected={defaultCloud === 'standard'}>{calc.cloudStandard}</option>
            <option value="aws" selected={defaultCloud === 'aws'}>{calc.cloudAws}</option>
            <option value="azure" selected={defaultCloud === 'azure'}>{calc.cloudAzure}</option>
            <option value="gcp" selected={defaultCloud === 'gcp'}>{calc.cloudGcp}</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Presets -->
    <div class="quick-row">
      <span>{calc.commonBlocks}</span>
      <button type="button" data-fill="10.0.0.0/8">10.0.0.0/8</button>
      <button type="button" data-fill="172.16.0.0/12">172.16.0.0/12</button>
      <button type="button" data-fill="192.168.0.0/16">192.168.0.0/16</button>
      <button type="button" data-fill="192.168.1.0/24">192.168.1.0/24</button>
    </div>

    <div class="error-banner" id="ip-error" role="alert">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
      <span>{calc.invalidIp}</span>
    </div>

    <!-- Binary visualization -->
    <div class="binary-section">
      <div class="binary-heading">
        <span class="tooltip-trigger" data-tooltip={calc.binaryTooltip}>{calc.binaryTitle}</span>
        <div class="binary-legend">
          <div class="legend-item"><span class="legend-color net"></span> {calc.networkBit}</div>
          <div class="legend-item"><span class="legend-color host"></span> {calc.hostBit}</div>
        </div>
      </div>
      <div class="binary-grid-wrapper" id="binary-grid">
        {Array.from({ length: 4 }).map((_, octetIdx) => (
          <div class="binary-octet">
            {initialBits.slice(octetIdx * 8, (octetIdx + 1) * 8).map((bit) => (
              <span 
                class={`binary-bit ${bit.type}`} 
                title={`Octet ${bit.octetIndex}, Bit ${bit.bitIndex + 1}: ${bit.type === 'net' ? 'Network' : 'Host'} Bit`}
              >
                {bit.val}
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- Result List -->
    <div class="result-heading">
      <div>
        <span class="step">{calc.step2}</span>
        <h2>{calc.subnetMetricsTitle}</h2>
      </div>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button class="copy-button" type="button" id="copy-ipv4-json">{calc.copyJson}</button>
        <button class="copy-button" type="button" id="copy-ipv4-csv">{calc.copyCsv}</button>
        <button class="copy-button" type="button" id="copy-ipv4-markdown">{calc.copyMd}</button>
        <button class="copy-button" type="button" id="share-link-btn" style="border-color: var(--accent-highlight); color: var(--accent-highlight); display: inline-flex; align-items: center; gap: 0.25rem;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>
          <span>{calc.shareLink}</span>
        </button>
      </div>
    </div>

    <div class="summary-grid">
      <div class="summary-item primary">
        <span class="tooltip-trigger" data-tooltip={calc.networkRangeTooltip}>{calc.networkRange}</span>
        <strong id="res-network">{initialResult.network}/{defaultCidr}</strong>
      </div>
      <div class="summary-item highlight-usable">
        <span class="tooltip-trigger" data-tooltip={calc.usableHostsTooltip}>{calc.usableHosts}</span>
        <strong id="res-host-range">{initialResult.firstUsable} - {initialResult.lastUsable}</strong>
      </div>
      <div class="summary-item">
        <span class="tooltip-trigger" data-tooltip={calc.subnetMaskTooltip}>{calc.subnetMask}</span>
        <strong id="res-mask">{initialResult.netmask}</strong>
      </div>
      <div class="summary-item">
        <span class="tooltip-trigger" data-tooltip={calc.wildcardMaskTooltip}>{calc.wildcardMask}</span>
        <strong id="res-wildcard">{initialResult.wildcard}</strong>
      </div>
      <div class="summary-item">
        <span class="tooltip-trigger" data-tooltip={calc.broadcastTooltip}>{calc.broadcast}</span>
        <strong id="res-broadcast">{initialResult.broadcast}</strong>
      </div>
      <div class="summary-item">
        <span class="tooltip-trigger" data-tooltip={calc.totalCapacityTooltip}>{calc.totalCapacity}</span>
        <strong id="res-total-hosts">{initialResult.totalHosts.toLocaleString()}</strong>
      </div>
    </div>

    <!-- Reserved IPs Detail list -->
    <div style="background-color: var(--bg-secondary); border-radius: var(--radius-md); padding: 1.25rem; border: 1px solid var(--border-color);">
      <h3 style="font-size: 0.9rem; text-transform: uppercase; font-family: var(--font-display); color: var(--text-secondary); margin-bottom: 0.75rem;">{calc.addressReservations}</h3>
      <ul id="res-details" style="font-family: var(--font-mono); font-size: 0.8rem; list-style-type: none; display: flex; flex-direction: column; gap: 0.35rem;">
        {initialResult.reservedDetails.map(detail => (
          <li style="color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;">
            <span style="color: var(--accent-host); font-weight: bold;">•</span> {detail}
          </li>
        ))}
      </ul>
    </div>

    <!-- Explanatory Reserved IPs breakdown -->
    <details class="reserved-info-details" style="border: 1px dashed var(--border-color); border-radius: var(--radius-md); background: rgba(255,255,255,0.01);">
      <summary style="font-size: 0.8rem; font-weight: 600; padding: 0.75rem; cursor: pointer; color: var(--accent-highlight); outline: none; user-select: none; display: flex; align-items: center; gap: 0.25rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        {calc.compareCloudTitle}
      </summary>
      <div style="padding: 0.75rem; font-size: 0.8rem; border-top: 1px dashed var(--border-color); display: flex; flex-direction: column; gap: 0.75rem; color: var(--text-secondary); line-height: 1.4;">
        <p>{calc.compareCloudIntro}</p>
        <div style="display: grid; grid-template-columns: 1fr; gap: 0.5rem;">
          <div style="border-left: 3px solid var(--text-muted); padding-left: 0.5rem;">
            {calc.stdRfcRule}
          </div>
          <div style="border-left: 3px solid var(--accent-network); padding-left: 0.5rem;">
            {calc.awsRule}
          </div>
          <div style="border-left: 3px solid var(--accent-host); padding-left: 0.5rem;">
            {calc.azureRule}
          </div>
          <div style="border-left: 3px solid var(--accent-highlight); padding-left: 0.5rem;">
            {calc.gcpRule}
          </div>
        </div>
      </div>
    </details>

    <!-- Inline Subnet Splitter -->
    <div style="border-top: 1px solid var(--border-color); padding-top: 1.5rem; margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
      <div class="panel-heading" style="padding-bottom: 0.5rem; border-bottom: none;">
        <div>
          <span class="step" style="background: rgba(var(--hsl-host), 0.15); color: var(--accent-host);">{calc.step3Splitter}</span>
          <h2 class="tooltip-trigger" data-tooltip={calc.splitterTooltip}>{calc.splitterTitle}</h2>
        </div>
        <span class="live-label" style="background: rgba(var(--hsl-network), 0.12); color: var(--accent-network);">{calc.allocationsLabel}</span>
      </div>

      <p class="aside-copy" style="font-size: 0.9rem; margin-bottom: 0.5rem;">
        {calc.splitterDescPre} <strong><span id="inline-splitter-base-display" style="color: var(--accent-network); font-family: var(--font-mono);">{defaultIp}/{defaultCidr}</span></strong> {calc.splitterDescPost}
      </p>

      <div class="splitter-visual-root" style="margin-top: 0.25rem;">
        <div class="subnet-block-row" id="inline-splitter-grid" style="min-height: 80px;">
          <!-- Rendered dynamically -->
        </div>
      </div>

      <div class="guide-table-wrapper" style="margin-top: 0.5rem; max-height: 250px; overflow-y: auto;">
        <table class="guide-table" style="font-size: 0.85rem;">
          <thead>
            <tr>
              <th>{calc.thLabel}</th>
              <th>{calc.thCidr}</th>
              <th>{calc.thUsable}</th>
              <th>{calc.thHosts}</th>
              <th>{calc.thAction}</th>
            </tr>
          </thead>
          <tbody id="inline-splitter-table-body">
            <!-- Rendered dynamically -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Right Column: Interactive Side Panel -->
  <div class="insight-panel">
    <div class="calculator-panel" style="gap: 1.5rem;">
      <div>
        <span class="aside-kicker">{calc.infraPlanning}</span>
        <h2 id="res-aside-title">{calc.yourSubnetTitle.replace('{cidr}', String(defaultCidr))}</h2>
      </div>
      <p class="aside-copy" id="res-aside-desc">
        {calc.asideDescPre} {initialResult.netmask} {calc.asideDescMid} {initialResult.usableHosts.toLocaleString()} {calc.asideDescPost}
      </p>

      <div class="capacity highlighted">
        <div>
          <span>{calc.usableCapacityLabel}</span>
          <strong id="res-usable-hosts">{initialResult.usableHosts.toLocaleString()}</strong>
        </div>
        <span class="capacity-unit">{calc.ipsAvailable}</span>
      </div>


      <div class="scale-visualizer">
        <div class="scale-fill" id="res-scale-fill" style={`width: ${Math.max(0, Math.min(100, (defaultCidr / 32) * 100))}%`}></div>
        <span class="scale-label" id="res-scale-label">{calc.prefixSizing.replace('{cidr}', String(defaultCidr))}</span>
      </div>
      
      <!-- IaC Exporter Section -->
      <div class="export-panel">
        <div class="export-tabs" style="display: flex; gap: 0.5rem; width: 100%;">
          <!-- a11y Fix B: sr-only label for the unlabelled select -->
          <label for="export-iac-select" class="sr-only">Export IaC Format</label>
          <select id="export-iac-select" class="cloud-select" aria-label="Export IaC Format" style="width: 100%; height: 36px; padding: 0.35rem 0.75rem; border-radius: var(--radius-sm); background-color: var(--bg-input); border: 1px solid var(--border-color); color: var(--text-primary); outline: none;">
            <option value="tf" selected>Terraform HCL</option>
            <option value="yaml">Ansible / YAML</option>
            <option value="pulumi-ts">Pulumi (TypeScript)</option>
            <option value="pulumi-py">Pulumi (Python)</option>
            <option value="cfn">AWS CloudFormation</option>
            <option value="cdk-ts">AWS CDK (TypeScript)</option>
            <option value="bicep">Azure Bicep</option>
          </select>
        </div>
        <div class="code-wrapper">
          <div class="code-copy-overlay">
            <button class="copy-button" type="button" id="copy-iac-code" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">{calc.copyCode}</button>
          </div>
          <pre><code id="iac-code-output"># Terraform VPC Subnet Definition
resource "aws_subnet" "subnet_1" &#123;
  vpc_id     = "vpc-12345678"
  cidr_block = "{initialResult.network}/{defaultCidr}"
  
  tags = &#123;
    Name = "subnet-{defaultCidr}"
  &#125;
&#125;</code></pre>
        </div>
      </div>

      <!-- Extended Tools Section: DNS & WHOIS Query Launchers -->
      <div class="extended-tools-panel" style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
        <div class="panel-heading" style="margin-bottom: 1rem;">
          <div>
            <span class="step" style="background: rgba(145, 80, 245, 0.15); color: var(--accent-host);">{calc.step3Tools}</span>
            <h2>{calc.extendedToolsTitle}</h2>
          </div>
          <span class="live-label" style="background: rgba(145, 80, 245, 0.12); color: var(--accent-host);">{calc.dnsWhoisLabel}</span>
        </div>

        <p class="aside-copy" style="margin-bottom: 1rem; font-size: 0.9rem;">
          {calc.extendedToolsDesc}
        </p>

        <div class="tools-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.875rem;">
          <a 
            href="https://dns.google/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="tool-card-btn"
            style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: rgba(255,255,255,0.02); text-decoration: none; color: var(--text-primary); font-size: 0.88rem; font-weight: 600; transition: all var(--transition-fast);"
          >
            <span style="display: flex; align-items: center; gap: 0.5rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-network);"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
              {calc.googleDns}
            </span>
            <span style="font-size: 0.75rem; color: var(--text-muted);">dns.google ↗</span>
          </a>

          <a 
            href="https://whois.arin.net/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="tool-card-btn"
            style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: rgba(255,255,255,0.02); text-decoration: none; color: var(--text-primary); font-size: 0.88rem; font-weight: 600; transition: all var(--transition-fast);"
          >
            <span style="display: flex; align-items: center; gap: 0.5rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-host);"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
              {calc.arinWhois}
            </span>
            <span style="font-size: 0.75rem; color: var(--text-muted);">arin.net ↗</span>
          </a>

          <a 
            href="https://one.one.one.one/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="tool-card-btn"
            style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: rgba(255,255,255,0.02); text-decoration: none; color: var(--text-primary); font-size: 0.88rem; font-weight: 600; transition: all var(--transition-fast);"
          >
            <span style="display: flex; align-items: center; gap: 0.5rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-highlight);"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              {calc.cloudflareDns}
            </span>
            <span style="font-size: 0.75rem; color: var(--text-muted);">1.1.1.1 ↗</span>
          </a>

          <a 
            href="https://bgp.he.net/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="tool-card-btn"
            style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: rgba(255,255,255,0.02); text-decoration: none; color: var(--text-primary); font-size: 0.88rem; font-weight: 600; transition: all var(--transition-fast);"
          >
            <span style="display: flex; align-items: center; gap: 0.5rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-warning);"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>
              {calc.bgpInspector}
            </span>
            <span style="font-size: 0.75rem; color: var(--text-muted);">he.net ↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { calculateSubnet, getBinaryBits, validateIPv4, ip2Long, long2Ip } from '../utils/subnetMath';
  import type { CalcTranslation } from '../utils/calc-i18n';

  function initIPv4Calculator() {
    const container = document.getElementById('ipv4-calc-container');
    const calcData: Partial<CalcTranslation> = container && container.dataset.calc
      ? JSON.parse(container.dataset.calc)
      : {};

    // DOM Elements
    const ipInput = document.getElementById('ip-address') as HTMLInputElement;
    const cidrInput = document.getElementById('cidr') as HTMLInputElement;
    const cidrSlider = document.getElementById('cidr-slider') as HTMLInputElement;
    const cloudSelector = document.getElementById('cloud-provider') as HTMLSelectElement;
    const errorBanner = document.getElementById('ip-error');
    
    if (!ipInput || !cidrInput || !cidrSlider || !cloudSelector) return;

    // Results Display Elements
    const resNetwork = document.getElementById('res-network');
    const resHostRange = document.getElementById('res-host-range');
    const resMask = document.getElementById('res-mask');
    const resWildcard = document.getElementById('res-wildcard');
    const resBroadcast = document.getElementById('res-broadcast');
    const resTotalHosts = document.getElementById('res-total-hosts');
    const resUsableHosts = document.getElementById('res-usable-hosts');
    const resDetails = document.getElementById('res-details');
    const binaryGrid = document.getElementById('binary-grid');
    
    // Aside elements
    const resAsideTitle = document.getElementById('res-aside-title');
    const resAsideDesc = document.getElementById('res-aside-desc');
    const resScaleFill = document.getElementById('res-scale-fill');
    const resScaleLabel = document.getElementById('res-scale-label');
    
    // Exporters
    const iacOutput = document.getElementById('iac-code-output');
    const copyIacBtn = document.getElementById('copy-iac-code');
    const copyJsonBtn = document.getElementById('copy-ipv4-json');
    const copyCsvBtn = document.getElementById('copy-ipv4-csv');
    const copyMarkdownBtn = document.getElementById('copy-ipv4-markdown');
    const shareLinkBtn = document.getElementById('share-link-btn');
    
    let currentLang = 'tf';

    // Inline Splitter State
    interface InlineSubnetNode {
      networkLong: number;
      cidr: number;
      label: string;
    }

    let inlineSubnets: InlineSubnetNode[] = [];
    let baseNetworkLong = 0;
    let baseCidrVal = 24;

    function resetInlineSplitter(networkIp: string, cidr: number) {
      baseCidrVal = cidr;
      const ipLong = ip2Long(networkIp);
      baseNetworkLong = (ipLong & (cidr === 0 ? 0 : (~0 << (32 - cidr)) >>> 0)) >>> 0;
      
      inlineSubnets = [{
        networkLong: baseNetworkLong,
        cidr: cidr,
        label: "Subnet 1"
      }];
      
      renderInlineSplitter();
    }

    function splitInlineSubnet(index: number) {
      const node = inlineSubnets[index];
      if (node.cidr >= 32) return;

      const newCidr = node.cidr + 1;
      const offset = Math.pow(2, 32 - newCidr);

      const child1: InlineSubnetNode = {
        networkLong: node.networkLong,
        cidr: newCidr,
        label: `${node.label} (A)`
      };

      const child2: InlineSubnetNode = {
        networkLong: node.networkLong + offset,
        cidr: newCidr,
        label: `${node.label} (B)`
      };

      inlineSubnets.splice(index, 1, child1, child2);
      renderInlineSplitter();
    }

    function canMergeInline(index: number): boolean {
      const node = inlineSubnets[index];
      if (node.cidr <= baseCidrVal) return false;

      const offset = Math.pow(2, 32 - node.cidr);
      const isRightSibling = (node.networkLong / offset) % 2 === 1;
      const siblingNetwork = isRightSibling ? node.networkLong - offset : node.networkLong + offset;

      const siblingIndex = inlineSubnets.findIndex(s => s.networkLong === siblingNetwork && s.cidr === node.cidr);
      return siblingIndex !== -1;
    }

    function mergeInlineSubnet(index: number) {
      const node = inlineSubnets[index];
      if (node.cidr <= baseCidrVal) return;

      const offset = Math.pow(2, 32 - node.cidr);
      const isRightSibling = (node.networkLong / offset) % 2 === 1;
      const siblingNetwork = isRightSibling ? node.networkLong - offset : node.networkLong + offset;
      const siblingIndex = inlineSubnets.findIndex(s => s.networkLong === siblingNetwork && s.cidr === node.cidr);

      if (siblingIndex === -1) return;

      const parentCidr = node.cidr - 1;
      const parentNetwork = isRightSibling ? siblingNetwork : node.networkLong;

      const parentNode: InlineSubnetNode = {
        networkLong: parentNetwork,
        cidr: parentCidr,
        label: node.label.replace(/\s*\(A\)|\s*\(B\)/g, '') || "Merged Subnet"
      };

      const firstIdx = Math.min(index, siblingIndex);
      inlineSubnets.splice(firstIdx, 2, parentNode);
      renderInlineSplitter();
    }

    function renderInlineSplitter() {
      const grid = document.getElementById('inline-splitter-grid');
      const tableBody = document.getElementById('inline-splitter-table-body');
      const baseDisplay = document.getElementById('inline-splitter-base-display');
      
      if (!grid || !tableBody) return;

      const baseIpStr = long2Ip(baseNetworkLong);
      if (baseDisplay) baseDisplay.innerText = `${baseIpStr}/${baseCidrVal}`;

      inlineSubnets.sort((a, b) => a.networkLong - b.networkLong);

      let gridHtml = '';
      const totalBlocksCapacity = Math.pow(2, 32 - baseCidrVal);

      inlineSubnets.forEach((node, idx) => {
        const nodeCapacity = Math.pow(2, 32 - node.cidr);
        const widthPct = (nodeCapacity / totalBlocksCapacity) * 100;
        
        let sizeClass = 'size-medium';
        if (node.cidr - baseCidrVal <= 1) sizeClass = 'size-large';
        else if (node.cidr - baseCidrVal >= 4) sizeClass = 'size-small';

        const canMergeNode = canMergeInline(idx);

        gridHtml += `
          <div class="subnet-block ${sizeClass}" style="flex: 1 1 ${widthPct}%; min-width: max(120px, ${widthPct}%); max-width: 100%; padding: 0.6rem 0.75rem;">
            <div class="subnet-block-highlight"></div>
            <div class="subnet-info" style="margin-bottom: 0.5rem;">
              <div class="subnet-meta" style="flex-direction: column; gap: 0.25rem;">
                <span class="subnet-cidr" style="font-size: 0.75rem; font-weight: bold;">${long2Ip(node.networkLong)}/${node.cidr}</span>
                <input 
                  type="text" 
                  class="inline-subnet-label-input" 
                  value="${node.label}" 
                  data-idx="${idx}" 
                  placeholder="Label..."
                  style="background:none; border:none; border-bottom: 1px dashed var(--border-color); color:var(--text-primary); font-size:0.75rem; outline:none; max-width:90px;"
                />
              </div>
            </div>
            <div class="subnet-actions" style="display: flex; gap: 0.25rem;">
              ${node.cidr < 32 ? `<button class="subnet-btn inline-split-btn" data-split="${idx}" style="padding: 0.15rem 0.4rem; font-size: 0.7rem; min-height: unset; height: 22px;">${calcData.btnSplit || 'Split'}</button>` : ''}
              ${canMergeNode ? `<button class="subnet-btn inline-merge-btn" data-merge="${idx}" style="padding: 0.15rem 0.4rem; font-size: 0.7rem; min-height: unset; height: 22px;">${calcData.btnMerge || 'Merge'}</button>` : ''}
            </div>
          </div>
        `;
      });
      grid.innerHTML = gridHtml;

      let tableHtml = '';
      inlineSubnets.forEach((node, idx) => {
        const calculated = calculateSubnet(long2Ip(node.networkLong), node.cidr, 'standard');

        tableHtml += `
          <tr>
            <td>
              <input 
                type="text" 
                class="inline-subnet-table-label-input" 
                value="${node.label}" 
                data-idx="${idx}" 
                aria-label="Subnet Label ${idx + 1}"
                style="background:none; border:none; border-bottom: 1px dashed var(--border-color); color:var(--text-primary); font-size:0.8rem; outline:none; max-width: 100px;"
              />
            </td>
            <td><strong>${calculated.network}/${node.cidr}</strong></td>
            <td>${node.cidr >= 31 ? `${calculated.network} - ${calculated.broadcast}` : `${calculated.firstUsable} - ${calculated.lastUsable}`}</td>
            <td>${calculated.usableHosts.toLocaleString()}</td>
            <td>
              <div style="display:flex; gap:0.25rem;">
                ${node.cidr < 32 ? `<button class="subnet-btn inline-split-btn" data-split="${idx}" style="padding: 0.2rem 0.4rem; font-size: 0.7rem; min-height: unset; height: 24px;">${calcData.btnSplit || 'Split'}</button>` : ''}
                ${canMergeInline(idx) ? `<button class="subnet-btn inline-merge-btn" data-merge="${idx}" style="padding: 0.2rem 0.4rem; font-size: 0.7rem; min-height: unset; height: 24px;">${calcData.btnMerge || 'Merge'}</button>` : ''}
              </div>
            </td>
          </tr>
        `;
      });
      tableBody.innerHTML = tableHtml;

      // Event listeners for inline split/merge
      grid.querySelectorAll('.inline-split-btn').forEach(btn => {
        (btn as HTMLButtonElement).onclick = (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).getAttribute('data-split')!, 10);
          splitInlineSubnet(idx);
        };
      });

      grid.querySelectorAll('.inline-merge-btn').forEach(btn => {
        (btn as HTMLButtonElement).onclick = (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).getAttribute('data-merge')!, 10);
          mergeInlineSubnet(idx);
        };
      });

      tableBody.querySelectorAll('.inline-split-btn').forEach(btn => {
        (btn as HTMLButtonElement).onclick = (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).getAttribute('data-split')!, 10);
          splitInlineSubnet(idx);
        };
      });

      tableBody.querySelectorAll('.inline-merge-btn').forEach(btn => {
        (btn as HTMLButtonElement).onclick = (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).getAttribute('data-merge')!, 10);
          mergeInlineSubnet(idx);
        };
      });

      // Label syncing listeners
      grid.querySelectorAll('.inline-subnet-label-input').forEach(input => {
        input.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const idx = parseInt(target.getAttribute('data-idx')!, 10);
          inlineSubnets[idx].label = target.value;
          const tableInput = tableBody.querySelector(`.inline-subnet-table-label-input[data-idx="${idx}"]`) as HTMLInputElement;
          if (tableInput) tableInput.value = target.value;
        });
      });

      tableBody.querySelectorAll('.inline-subnet-table-label-input').forEach(input => {
        input.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const idx = parseInt(target.getAttribute('data-idx')!, 10);
          inlineSubnets[idx].label = target.value;
          const blockInput = grid.querySelector(`.inline-subnet-label-input[data-idx="${idx}"]`) as HTMLInputElement;
          if (blockInput) blockInput.value = target.value;
        });
      });
    }

    function updateAll() {
      const ip = ipInput.value.trim();
      const cidr = parseInt(cidrInput.value, 10);
      const cloud = cloudSelector.value as 'standard' | 'aws' | 'azure' | 'gcp';

      // Format validation
      if (!validateIPv4(ip)) {
        errorBanner?.classList.add('show');
        return;
      } else {
        errorBanner?.classList.remove('show');
      }

      // Run math
      const result = calculateSubnet(ip, cidr, cloud);
      const bits = getBinaryBits(ip, cidr);

      // Update display text fields
      if (resNetwork) resNetwork.innerText = `${result.network}/${cidr}`;
      if (resHostRange) resHostRange.innerText = `${result.firstUsable} - ${result.lastUsable}`;
      if (resMask) resMask.innerText = result.netmask;
      if (resWildcard) resWildcard.innerText = result.wildcard;
      if (resBroadcast) resBroadcast.innerText = result.broadcast;
      if (resTotalHosts) resTotalHosts.innerText = result.totalHosts.toLocaleString();
      if (resUsableHosts) resUsableHosts.innerText = result.usableHosts.toLocaleString();
      
      // Update aside elements
      if (resAsideTitle) {
        resAsideTitle.innerText = (calcData.yourSubnetTitle || 'Your /{cidr} Subnet').replace('{cidr}', cidr.toString());
      }
      if (resAsideDesc) {
        const pre = calcData.asideDescPre || 'A subnet with a mask of';
        const mid = calcData.asideDescMid || 'provides';
        const post = calcData.asideDescPost || 'usable IP addresses for devices.';
        resAsideDesc.innerText = `${pre} ${result.netmask} ${mid} ${result.usableHosts.toLocaleString()} ${post}`;
      }
      if (resScaleFill) {
        resScaleFill.style.width = `${(cidr / 32) * 100}%`;
      }
      if (resScaleLabel) {
        resScaleLabel.innerText = (calcData.prefixSizing || 'Prefix Sizing: /{cidr}').replace('{cidr}', cidr.toString());
      }

      // Re-render Details List
      if (resDetails) {
        resDetails.innerHTML = result.reservedDetails.map(detail => `
          <li style="color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;">
            <span style="color: var(--accent-host); font-weight: bold;">•</span> ${detail}
          </li>
        `).join('');
      }

      // Re-render Binary grid
      if (binaryGrid) {
        let html = '';
        for (let oIndex = 0; oIndex < 4; oIndex++) {
          html += '<div class="binary-octet">';
          const slice = bits.slice(oIndex * 8, (oIndex + 1) * 8);
          slice.forEach(bit => {
            html += `
              <span 
                class="binary-bit ${bit.type}" 
                title="Octet ${bit.octetIndex}, Bit ${bit.bitIndex + 1}: ${bit.type === 'net' ? 'Network' : 'Host'} Bit"
              >${bit.val}</span>
            `;
          });
          html += '</div>';
        }
        binaryGrid.innerHTML = html;
      }

      // Update IaC Snippet Code block
      updateIaCCode(result.network, cidr, cloud);

      // Reset inline splitter if base CIDR or base Network changed
      const currentNetworkLong = ip2Long(result.network);
      if (currentNetworkLong !== baseNetworkLong || cidr !== baseCidrVal) {
        resetInlineSplitter(result.network, cidr);
      }
    }

    // Non-blocking rAF scheduler
    let updateRaf: number | null = null;
    function scheduledUpdate() {
      if (updateRaf) cancelAnimationFrame(updateRaf);
      updateRaf = requestAnimationFrame(updateAll);
    }

    function updateIaCCode(network: string, cidr: number, cloud: string) {
      if (!iacOutput) return;
      
      const iacSelect = document.getElementById('export-iac-select') as HTMLSelectElement;
      const format = iacSelect ? iacSelect.value : 'tf';

      if (format === 'tf') {
        if (cloud === 'aws') {
          iacOutput.innerText = `# AWS VPC Subnet IaC snippet
resource "aws_subnet" "subnet_aws" {
  vpc_id            = "vpc-12345678"
  cidr_block        = "${network}/${cidr}"
  availability_zone = "us-east-1a"
  
  tags = {
    Name        = "subnet-${cidr}"
    Environment = "production"
  }
}`;
        } else if (cloud === 'azure') {
          iacOutput.innerText = `# Microsoft Azure VNet Subnet
resource "azurerm_subnet" "subnet_azure" {
  name                 = "subnet-${cidr}"
  resource_group_name  = "rg-prod"
  virtual_network_name = "vnet-prod"
  address_prefixes     = ["${network}/${cidr}"]
}`;
        } else {
          iacOutput.innerText = `# Standard Terraform Subnet Allocation
resource "terraform_subnet" "subnet_generic" {
  cidr_block = "${network}/${cidr}"
  description = "Assigned IP Block"
}`;
        }
      } else if (format === 'yaml') {
        iacOutput.innerText = `# Ansible Network Subnet Settings
network_config:
  subnet_ip: "${network}"
  cidr_prefix: ${cidr}
  provider_rules: "${cloud}"
    metadata:
      description: "Calculated via devsubnet.com"
      host_capacity: ${cidr}`;
      } else if (format === 'pulumi-ts') {
        iacOutput.innerText = `import * as aws from "@pulumi/aws";

const subnet = new aws.ec2.Subnet("subnet", {
    vpcId: "vpc-12345678",
    cidrBlock: "${network}/${cidr}",
    availabilityZone: "us-east-1a",
    tags: { Name: "subnet-${cidr}" },
});`;
      } else if (format === 'pulumi-py') {
        iacOutput.innerText = `import pulumi_aws as aws

subnet = aws.ec2.Subnet("subnet",
    vpc_id="vpc-12345678",
    cidr_block="${network}/${cidr}",
    availability_zone="us-east-1a",
    tags={"Name": "subnet-${cidr}"}
)`;
      } else if (format === 'cfn') {
        iacOutput.innerText = `Resources:
  Subnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: vpc-12345678
      CidrBlock: ${network}/${cidr}
      AvailabilityZone: us-east-1a
      Tags:
        - Key: Name
          Value: subnet-${cidr}`;
      } else if (format === 'cdk-ts') {
        iacOutput.innerText = `import * as ec2 from 'aws-cdk-lib/aws-ec2';

// Inside Stack constructor:
const subnet = new ec2.Subnet(this, 'Subnet', {
  vpcId: 'vpc-12345678',
  cidrBlock: '${network}/${cidr}',
  availabilityZone: 'us-east-1a',
});`;
      } else if (format === 'bicep') {
        iacOutput.innerText = `resource subnet 'Microsoft.Network/virtualNetworks/subnets@2023-09-01' = {
  name: 'vnet-prod/subnet-${cidr}'
  properties: {
    addressPrefix: '${network}/${cidr}'
  }
}`;
      }
    }

    // Bind Listeners
    ipInput.oninput = scheduledUpdate;
    
    cidrInput.oninput = (e) => {
      const val = parseInt((e.target as HTMLInputElement).value, 10);
      if (!isNaN(val) && val >= 0 && val <= 32) {
        cidrSlider.value = val.toString();
        scheduledUpdate();
      }
    };

    cidrSlider.oninput = (e) => {
      const val = (e.target as HTMLInputElement).value;
      cidrInput.value = val;
      scheduledUpdate();
    };

    cloudSelector.onchange = scheduledUpdate;

    // Preset Buttons
    document.querySelectorAll('[data-fill]').forEach(btn => {
      (btn as HTMLButtonElement).onclick = (e) => {
        const [ip, cidr] = (e.currentTarget as HTMLButtonElement).getAttribute('data-fill')!.split('/');
        ipInput.value = ip;
        cidrInput.value = cidr;
        cidrSlider.value = cidr;
        updateAll();
      };
    });

    // IaC Lang selection dropdown
    const iacSelect = document.getElementById('export-iac-select') as HTMLSelectElement;
    if (iacSelect) {
      iacSelect.onchange = () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        const result = calculateSubnet(ip, cidr, cloudSelector.value as any);
        updateIaCCode(result.network, cidr, cloudSelector.value);
      };
    }

    // Copy & Share Buttons
    if (copyJsonBtn) {
      copyJsonBtn.onclick = async () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        const cloud = cloudSelector.value as any;
        if (!validateIPv4(ip)) return;
        const res = calculateSubnet(ip, cidr, cloud);
        
        await navigator.clipboard.writeText(JSON.stringify(res, null, 2));
        copyJsonBtn.innerText = calcData.copied || 'Copied!';
        copyJsonBtn.classList.add('copied');
        setTimeout(() => {
          copyJsonBtn.innerText = calcData.copyJson || 'Copy JSON';
          copyJsonBtn.classList.remove('copied');
        }, 2000);
      };
    }

    if (copyCsvBtn) {
      copyCsvBtn.onclick = async () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        const cloud = cloudSelector.value as any;
        if (!validateIPv4(ip)) return;
        const res = calculateSubnet(ip, cidr, cloud);

        const csvContent = [
          ['Metric', 'Value'],
          [calcData.networkRange || 'Network Range / Address', `${res.network}/${cidr}`],
          [calcData.usableHosts || 'Usable Host IPs', `${res.firstUsable} - ${res.lastUsable}`],
          [calcData.subnetMask || 'Subnet Mask', res.netmask],
          [calcData.wildcardMask || 'Wildcard Mask', res.wildcard],
          [calcData.broadcast || 'Broadcast Address', res.broadcast],
          [calcData.totalCapacity || 'Total IP Capacity', res.totalHosts],
          [calcData.usableCapacityLabel || 'Usable Host Capacity', res.usableHosts]
        ].map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');

        await navigator.clipboard.writeText(csvContent);
        copyCsvBtn.innerText = calcData.copied || 'Copied!';
        copyCsvBtn.classList.add('copied');
        setTimeout(() => {
          copyCsvBtn.innerText = calcData.copyCsv || 'Copy CSV';
          copyCsvBtn.classList.remove('copied');
        }, 2000);
      };
    }

    if (copyMarkdownBtn) {
      copyMarkdownBtn.onclick = async () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        const cloud = cloudSelector.value as any;
        if (!validateIPv4(ip)) return;
        const res = calculateSubnet(ip, cidr, cloud);

        const mdContent = [
          '| Metric | Value |',
          '| --- | --- |',
          `| **${calcData.networkRange || 'Network Range / Address'}** | ${res.network}/${cidr} |`,
          `| **${calcData.usableHosts || 'Usable Host IPs'}** | ${res.firstUsable} - ${res.lastUsable} |`,
          `| **${calcData.subnetMask || 'Subnet Mask'}** | ${res.netmask} |`,
          `| **${calcData.wildcardMask || 'Wildcard Mask'}** | ${res.wildcard} |`,
          `| **${calcData.broadcast || 'Broadcast Address'}** | ${res.broadcast} |`,
          `| **${calcData.totalCapacity || 'Total IP Capacity'}** | ${res.totalHosts.toLocaleString()} |`,
          `| **${calcData.usableCapacityLabel || 'Usable Host Capacity'}** | ${res.usableHosts.toLocaleString()} |`
        ].join('\n');

        await navigator.clipboard.writeText(mdContent);
        copyMarkdownBtn.innerText = calcData.copied || 'Copied!';
        copyMarkdownBtn.classList.add('copied');
        setTimeout(() => {
          copyMarkdownBtn.innerText = calcData.copyMd || 'Copy MD Table';
          copyMarkdownBtn.classList.remove('copied');
        }, 2000);
      };
    }

    if (shareLinkBtn) {
      shareLinkBtn.onclick = async () => {
        const ip = ipInput.value.trim();
        const cidr = cidrInput.value;
        const cloud = cloudSelector.value;
        
        const url = new URL(window.location.origin + window.location.pathname);
        url.searchParams.set('ip', ip);
        url.searchParams.set('cidr', cidr);
        url.searchParams.set('cloud', cloud);

        await navigator.clipboard.writeText(url.toString());
        const btnTextSpan = shareLinkBtn.querySelector('span');
        if (btnTextSpan) btnTextSpan.innerText = calcData.copied || 'Copied!';
        shareLinkBtn.classList.add('copied');
        setTimeout(() => {
          if (btnTextSpan) btnTextSpan.innerText = calcData.shareLink || 'Share Link';
          shareLinkBtn.classList.remove('copied');
        }, 2000);
      };
    }

    if (copyIacBtn) {
      copyIacBtn.onclick = async () => {
        if (!iacOutput) return;
        await navigator.clipboard.writeText(iacOutput.innerText);
        copyIacBtn.innerText = calcData.copied || 'Copied!';
        copyIacBtn.classList.add('copied');
        setTimeout(() => {
          copyIacBtn.innerText = calcData.copyCode || 'Copy Code';
          copyIacBtn.classList.remove('copied');
        }, 2000);
      };
    }

    // Check URL params on mount (supports cidr & prefix)
    const params = new URLSearchParams(window.location.search);
    const ipParam = params.get('ip');
    const cidrParam = params.get('cidr') || params.get('prefix');
    const cloudParam = params.get('cloud');

    if (ipParam && validateIPv4(ipParam)) ipInput.value = ipParam;
    if (cidrParam) {
      const cNum = parseInt(cidrParam, 10);
      if (cNum >= 0 && cNum <= 32) {
        cidrInput.value = cNum.toString();
        cidrSlider.value = cNum.toString();
      }
    }
    if (cloudParam) {
      if (['standard', 'aws', 'azure', 'gcp'].includes(cloudParam)) {
        cloudSelector.value = cloudParam;
      }
    }
    // Keyboard Navigation & Shortcuts
    const handleKeyDown = (e: KeyboardEvent) => {
      // Ctrl + Shift + C (Copy primary Usable Host Range)
      if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.code === 'KeyC') {
        const rangeEl = document.getElementById('res-host-range');
        if (rangeEl) {
          e.preventDefault();
          const text = rangeEl.innerText;
          navigator.clipboard.writeText(text).then(() => {
            const flash = document.createElement('div');
            flash.textContent = 'Copied Usable Host Range: ' + text;
            flash.style.position = 'fixed';
            flash.style.bottom = '20px';
            flash.style.right = '20px';
            flash.style.background = 'var(--accent-highlight)';
            flash.style.color = '#0d111c';
            flash.style.padding = '0.5rem 1rem';
            flash.style.borderRadius = 'var(--radius-sm)';
            flash.style.zIndex = '99999';
            flash.style.fontFamily = 'var(--font-sans)';
            flash.style.fontSize = '0.85rem';
            flash.style.fontWeight = 'bold';
            document.body.appendChild(flash);
            setTimeout(() => flash.remove(), 2000);
          });
        }
      }

      // Arrow Up/Down to adjust CIDR slider (when not typing in a text field)
      const focused = document.activeElement;
      const isInputText = focused && (
        focused.tagName === 'TEXTAREA' || 
        (focused.tagName === 'INPUT' && (focused as HTMLInputElement).type === 'text')
      );
      if (!isInputText) {
        let val = parseInt(cidrSlider.value, 10);
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (val < 32) {
            val++;
            cidrSlider.value = val.toString();
            cidrInput.value = val.toString();
            scheduledUpdate();
          }
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (val > 0) {
            val--;
            cidrSlider.value = val.toString();
            cidrInput.value = val.toString();
            scheduledUpdate();
          }
        }
      }
    };

    document.addEventListener('keydown', handleKeyDown);

    // Clean up event listener when page navigates (using Astro transitions)
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keydown', handleKeyDown);
    }, { once: true });

    updateAll();
  }

  document.addEventListener('astro:page-load', initIPv4Calculator);
  initIPv4Calculator();
</script>
