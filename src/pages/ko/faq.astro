---import Footer from '../../components/Footer.astro';
import { type SupportedLanguage } from '../../utils/i18n';

import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import { translations } from '../../utils/i18n';

const t = translations.ko;

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout 
  lang={lang}
  title="IP 서브네팅 & CIDR FAQ – 자주 묻는 질문 | DevSubnet"
  description="IP 서브넷, CIDR, 클라우드 VPC 및 Kubernetes 네트워킹에 대한 질문과 답변. 계산법, AWS 예약 및 모범 사례를 알기 쉽게 설명합니다."
>
  <div class="app-shell">
    <NavBar path="faq" lang={lang} />

    <main class="faq-main">
      <div class="faq-container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/ko/">홈</a> <span class="sep">/</span> <strong>FAQ</strong>
        </nav>

        <!-- Page Header -->
        <section class="faq-intro">
          <div class="eyebrow">빠른 답변</div>
          <h1>IP 서브넷 FAQ</h1>
          <p class="lede">
            IP 서브넷, CIDR 및 클라우드 네트워크에 대해 가장 많이 묻는 질문을 쉽고 명확하게 답변해 드립니다.
          </p>
        </section>

        <!-- FAQ Accordion List -->
        <div class="faq-accordion" role="list">
          <details class="faq-details" role="listitem">
            <summary class="faq-summary">
              <span>서브넷 마스크란 무엇이며 어떻게 작동하나요?</span>
              <span class="icon" aria-hidden="true"><span class="plus">+</span><span class="minus">&#8722;</span></span>
            </summary>
            <div class="faq-answer">
              <p>서브넷 마스크는 IP 주소를 네트워크 부분과 호스트 부분으로 나누는 32비트 숫자입니다. 비트 단위 AND 연산을 수행하여 1로 표시된 비트는 네트워크를, 0으로 표시된 비트는 호스트를 정의합니다.</p>
            </div>
          </details>

          <details class="faq-details" role="listitem">
            <summary class="faq-summary">
              <span>IP 주소에서 서브넷을 어떻게 계산하나요?</span>
              <span class="icon" aria-hidden="true"><span class="plus">+</span><span class="minus">&#8722;</span></span>
            </summary>
            <div class="faq-answer">
              <p>CIDR 또는 서브넷 마스크를 2진수로 변환합니다. 생성 가능한 서브넷 수는 2<sup>n</sup>(빌려온 비트 수)이고, 사용 가능한 호스트 수는 2<sup>h</sup> &minus; 2입니다.</p>
            </div>
          </details>

          <details class="faq-details" role="listitem">
            <summary class="faq-summary">
              <span>CIDR 표기법이란 무엇인가요?</span>
              <span class="icon" aria-hidden="true"><span class="plus">+</span><span class="minus">&#8722;</span></span>
            </summary>
            <div class="faq-answer">
              <p>CIDR(Classless Inter-Domain Routing)은 IP 접두사를 슬래시와 숫자 형태로 간결하게 나타내는 표기법(예: 24비트 네트워크의 경우 /24)으로, 기존의 경직된 클래스 기반 주소 지정 모델을 대체했습니다.</p>
            </div>
          </details>

          <details class="faq-details" role="listitem">
            <summary class="faq-summary">
              <span>/24 서브넷은 사용 가능한 호스트가 몇 개인가요?</span>
              <span class="icon" aria-hidden="true"><span class="plus">+</span><span class="minus">&#8722;</span></span>
            </summary>
            <div class="faq-answer">
              <p>/24 서브넷은 256개의 IP 주소를 가집니다. 네트워크 주소와 브로드캐스트 주소를 제외하면 정확히 254개의 호스트 주소를 사용할 수 있습니다.</p>
            </div>
          </details>

          <details class="faq-details" role="listitem">
            <summary class="faq-summary">
              <span>AWS는 VPC 서브넷에서 어떤 IP 주소를 예약하나요?</span>
              <span class="icon" aria-hidden="true"><span class="plus">+</span><span class="minus">&#8722;</span></span>
            </summary>
            <div class="faq-answer">
              <p>AWS는 서브넷당 5개의 IP 주소를 예약합니다. 처음 4개 주소(네트워크 주소, VPC 라우터, DNS, 향후 사용)와 마지막 주소(브로드캐스트)가 이에 해당합니다.</p>
            </div>
          </details>

          <details class="faq-details" role="listitem">
            <summary class="faq-summary">
              <span>Kubernetes Pod 및 Service CIDR은 어떻게 사이징해야 하나요?</span>
              <span class="icon" aria-hidden="true"><span class="plus">+</span><span class="minus">&#8722;</span></span>
            </summary>
            <div class="faq-answer">
              <p>노드, Pod, 서비스 간에 겹치지 않는 CIDR 범위를 설정하세요. 일반적으로 노드당 /24(254개 Pod) 또는 /26(62개 Pod)를 할당합니다.</p>
            </div>
          </details>
        </div>

        <div style="margin-top: 3rem; text-align: center;">
          <a href="/ko/" class="btn-seo-primary">계산기로 이동 →</a>
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<style>
  .faq-main {
    padding: 3rem 1.5rem;
    max-width: 56rem;
    margin: 0 auto;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a {
    color: var(--accent-network);
    text-decoration: none;
  }
  .faq-intro h1 {
    font-size: 2.25rem;
    margin-bottom: 0.5rem;
  }
  .faq-intro .lede {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .faq-details {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
  }
  .faq-summary {
    cursor: pointer;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-primary);
  }
  .faq-answer {
    margin-top: 0.75rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }
</style>
