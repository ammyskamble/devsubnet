---
import { type SupportedLanguage } from '../utils/i18n';
import Layout from '../layouts/Layout.astro';
import MainShell from '../components/MainShell.astro';
import { toolsI18n } from '../utils/tools-i18n';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
const tCloud = (toolsI18n[lang] || toolsI18n.en).cloudIntros.azure;
---
<Layout lang={lang}
  title={`${tCloud.title} | DevSubnet`}
  description={tCloud.lede}
>
  <MainShell lang={lang} activeTab="ipv4" defaultCloud="azure" navPath="azure" />
</Layout>
