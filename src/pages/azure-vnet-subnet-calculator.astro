---import { type SupportedLanguage } from '../utils/i18n';

import Layout from '../layouts/Layout.astro';
import MainShell from '../components/MainShell.astro';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---
<Layout lang={lang}
  title="Azure VNet Subnet Calculator – CIDR Planner with 5 Reserved IPs | DevSubnet"
  description="Calculate Azure VNet subnets accounting for all 5 reserved IP addresses (network, gateway, DNS x2, broadcast). Plan sets CIDR blocks and export Terraform for Azure."
  canonicalUrl="https://devsubnet.com/azure-vnet-subnet-calculator/"
>
  <MainShell lang={lang} activeTab="ipv4" defaultCloud="azure" navPath="azure" />
</Layout>
