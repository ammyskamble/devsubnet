---import { type SupportedLanguage } from '../../utils/i18n';

import Layout from '../../layouts/Layout.astro';
import MainShell from '../../components/MainShell.astro';
import { translations } from '../../utils/i18n';

const t = translations.de;

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout 
  lang={lang}
  title="Visueller Subnetz-Splitter & CIDR-Partitionierer | DevSubnet"
  description="Teilen Sie Netzwerkblöcke visuell in Subnetze auf. Dynamische Baumanzeige und IaC-Export für Terraform & Ansible."
>
  <MainShell activeTab="splitter" navPath="visual-subnet-splitter" lang={lang} />
</Layout>
