---
import { validateIPv4, ip2Long } from '../utils/subnetMath';
---
<div class="calculator-layout">
  <!-- Left Column: Input -->
  <div class="calculator-panel">
    <div class="panel-heading">
      <div>
        <span class="step">01</span>
        <h2>Networks to Aggregate</h2>
      </div>
      <span class="live-label">SUPERNETTING / ROUTE SUMMARIZATION</span>
    </div>

    <div class="input-row">
      <label for="supernet-input">Contiguous CIDR blocks (one per line)</label>
      <textarea id="supernet-input" rows="6" style="background-color: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem 1rem; font-family: var(--font-mono); font-size: 0.9rem; color: var(--text-primary); outline: none; resize: vertical;">192.168.0.0/24
192.168.1.0/24
192.168.2.0/24
192.168.3.0/24</textarea>
    </div>

    <div class="quick-row">
      <button type="button" id="btn-run-supernet" class="subtool-btn" style="border-color: var(--accent-highlight); color: var(--accent-highlight);">Aggregate</button>
      <button type="button" id="btn-clear-supernet" class="subtool-btn">Clear</button>
    </div>

    <div class="error-banner" id="supernet-error" role="alert">
      <span>Enter valid CIDR blocks — one per line. Only redundant routes that can collapse safely are aggregated.</span>
    </div>
  </div>

  <!-- Right Column: Results -->
  <div class="insight-panel">
    <div class="calculator-panel" style="gap: 1.5rem;">
      <div>
        <span class="aside-kicker">SUMMARY ROUTES</span>
        <h2>Aggregated Result</h2>
      </div>
      <p class="aside-copy">
        A single summary route that covers all listed networks reduces routing table size and accelerates convergence. Some networks may remain separate if they are not aggregatable.
      </p>
      <div class="guide-table-wrapper">
        <table class="guide-table">
          <thead>
            <tr>
              <th>CIDR</th>
              <th>Range</th>
            </tr>
          </thead>
          <tbody id="supernet-table-body">
            <tr><td colspan="2" style="text-align:center;color:var(--text-muted); font-family:var(--font-sans);">Enter CIDR blocks and click Aggregate.</td></tr>
          </tbody>
        </table>
      </div>
      <div class="export-panel">
        <div class="code-wrapper">
          <div class="code-copy-overlay">
            <button class="copy-button" type="button" id="copy-supernet-code" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">Copy</button>
          </div>
          <pre><code id="supernet-code-output"># Summary route export</code></pre>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { validateIPv4, ip2Long, long2Ip } from '../utils/subnetMath';

  function initSupernetter() {
    const input = document.getElementById('supernet-input') as HTMLTextAreaElement;
    const runBtn = document.getElementById('btn-run-supernet') as HTMLButtonElement;
    const clearBtn = document.getElementById('btn-clear-supernet') as HTMLButtonElement;
    const tableBody = document.getElementById('supernet-table-body') as HTMLTableSectionElement;
    const codeOutput = document.getElementById('supernet-code-output') as HTMLElement;
    const copyBtn = document.getElementById('copy-supernet-code') as HTMLButtonElement;
    const errorBanner = document.getElementById('supernet-error');

    if (!input || !runBtn || !tableBody) return;

    function parseBlock(line: string): { network: number; cidr: number } | null {
      const t = line.trim();
      if (!t) return null;
      const slash = t.lastIndexOf('/');
      if (slash === -1) return null;
      const ip = t.slice(0, slash).trim();
      const cidr = parseInt(t.slice(slash + 1), 10);
      if (!validateIPv4(ip) || isNaN(cidr) || cidr < 0 || cidr > 32) return null;
      const mask = cidr === 0 ? 0 : (~0 << (32 - cidr)) >>> 0;
      return { network: (ip2Long(ip) & mask) >>> 0, cidr };
    }

    function run() {
      errorBanner?.classList.remove('show');
      const blocks: { network: number; cidr: number }[] = [];
      let valid = true;

      input.value.split('\n').forEach(line => {
        const b = parseBlock(line);
        if (b) blocks.push(b);
        else if (line.trim()) valid = false;
      });

      if (!valid || blocks.length === 0) {
        errorBanner?.classList.add('show');
        return;
      }

      blocks.sort((a, b) => a.network - b.network || a.cidr - b.cidr);

      let aggregated = blocks.map(b => ({ ...b }));
      let changed = true;
      while (changed) {
        changed = false;
        const next: { network: number; cidr: number }[] = [];
        for (let i = 0; i < aggregated.length; i++) {
          const a = aggregated[i];
          if (i + 1 < aggregated.length) {
            const b = aggregated[i + 1];
            const parentCidr = a.cidr - 1;
            const parentStep = Math.pow(2, 32 - parentCidr);
            if (a.cidr === b.cidr && a.cidr > 0 && (a.network % parentStep === 0) && b.network === a.network + Math.pow(2, 32 - a.cidr)) {
              next.push({ network: a.network, cidr: parentCidr });
              i++;
              changed = true;
              continue;
            }
          }
          next.push(a);
        }
        aggregated = next;
      }

      let html = '';
      aggregated.forEach(a => {
        const end = a.network + Math.pow(2, 32 - a.cidr) - 1;
        html += `<tr><td><strong>${long2Ip(a.network)}/${a.cidr}</strong></td><td>${long2Ip(a.network)} - ${long2Ip(end)}</td></tr>`;
      });
      tableBody.innerHTML = html || '<tr><td colspan="2" style="text-align:center;color:var(--text-muted);">No results.</td></tr>';

      if (codeOutput) {
        let code = '# Supernet summary routes\n';
        aggregated.forEach(a => {
          code += `ip route ${long2Ip(a.network)}/${a.cidr} Null0\n`;
        });
        codeOutput.innerText = code.trim();
      }
    }

    runBtn.onclick = run;
    if (clearBtn) {
      clearBtn.onclick = () => {
        input.value = '';
        tableBody.innerHTML = '<tr><td colspan="2" style="text-align:center;color:var(--text-muted); font-family:var(--font-sans);">Enter CIDR blocks and click Aggregate.</td></tr>';
        if (codeOutput) codeOutput.innerText = '# Summary route export';
      };
    }
    if (copyBtn) {
      copyBtn.onclick = async () => {
        if (!codeOutput) return;
        await navigator.clipboard.writeText(codeOutput.innerText);
        copyBtn.innerText = 'Copied!';
        copyBtn.classList.add('copied');
        setTimeout(() => { copyBtn.innerText = 'Copy'; copyBtn.classList.remove('copied'); }, 2000);
      };
    }
  }

  document.addEventListener('astro:page-load', initSupernetter);
  initSupernetter();
</script>

<style>
  .subtool-btn {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .subtool-btn:hover { color: var(--text-primary); background-color: var(--border-color); }
</style>
