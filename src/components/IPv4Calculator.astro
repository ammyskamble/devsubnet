          >
            <span style="display: flex; align-items: center; gap: 0.5rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-highlight);"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              {calc.cloudflareDns}
            </span>
            <span style="font-size: 0.75rem; color: var(--text-muted);">1.1.1.1 ↗</span>
          </a>

          <a 
            href="https://bgp.he.net/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="tool-card-btn"
            style="display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); background: rgba(255,255,255,0.02); text-decoration: none; color: var(--text-primary); font-size: 0.88rem; font-weight: 600; transition: all var(--transition-fast);"
          >
            <span style="display: flex; align-items: center; gap: 0.5rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-warning);"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>
              {calc.bgpInspector}
            </span>
            <span style="font-size: 0.75rem; color: var(--text-muted);">he.net ↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { 
    calculateSubnet, 
    getBinaryBits, 
    validateIPv4, 
    ip2Long, 
    long2Ip, 
    netmaskToCidr, 
    wildcardToCidr, 
    parseSmartIpInput, 
    calculateExamMath 
  } from '../utils/subnetMath';
  import type { CalcTranslation } from '../utils/calc-i18n';

  function initIPv4Calculator() {
    const container = document.getElementById('ipv4-calc-container');
    const calcData: Partial<CalcTranslation> = container && container.dataset.calc
      ? JSON.parse(container.dataset.calc)
      : {};

    // DOM Elements
    const ipInput = document.getElementById('ip-address') as HTMLInputElement;
    const cidrInput = document.getElementById('cidr') as HTMLInputElement;
    const cidrSlider = document.getElementById('cidr-slider') as HTMLInputElement;
    const netmaskInput = document.getElementById('netmask-input') as HTMLInputElement;
    const cloudSelector = document.getElementById('cloud-provider') as HTMLSelectElement;
    const errorBanner = document.getElementById('ip-error');
    
    if (!ipInput || !cidrInput || !cidrSlider || !cloudSelector) return;

    // Results Display Elements
    const resNetwork = document.getElementById('res-network');
    const resHostRange = document.getElementById('res-host-range');
    const resMask = document.getElementById('res-mask');
    const resWildcard = document.getElementById('res-wildcard');
    const resBroadcast = document.getElementById('res-broadcast');
    const resTotalHosts = document.getElementById('res-total-hosts');
    const resUsableHosts = document.getElementById('res-usable-hosts');
    const resDetails = document.getElementById('res-details');
    const binaryGrid = document.getElementById('binary-grid');
    
    // Interactive Bit Grid Mode Elements
    const modePrefixBtn = document.getElementById('mode-prefix-btn') as HTMLButtonElement;
    const modeFlipBtn = document.getElementById('mode-flip-btn') as HTMLButtonElement;
    const binaryModeInstruction = document.getElementById('binary-mode-instruction');
    let bitInteractionMode: 'prefix' | 'flip' = 'prefix';

    // Exam Mode Elements
    const examModeToggle = document.getElementById('exam-mode-toggle') as HTMLButtonElement;
    const examModeContent = document.getElementById('exam-mode-content');
    const examToggleLabel = document.getElementById('exam-toggle-label');
    let examModeExpanded = true;

    // Subnet Stepper Elements
    const btnPrevSubnet = document.getElementById('btn-prev-subnet') as HTMLButtonElement | null;
    const btnNextSubnet = document.getElementById('btn-next-subnet') as HTMLButtonElement | null;
    const stepperCurrentBadge = document.getElementById('stepper-current-badge');
    const stepperDeltaBadge = document.getElementById('stepper-delta-badge');

    // CLI Quick Copy Buttons
    const quickCopyCiscoIp = document.getElementById('quick-copy-cisco-ip');
    const quickCopyCiscoAcl = document.getElementById('quick-copy-cisco-acl');
    const quickCopyLinuxIp = document.getElementById('quick-copy-linux-ip');
    const quickCopyCiscoRoute = document.getElementById('quick-copy-cisco-route');

    // Aside elements
    const resAsideTitle = document.getElementById('res-aside-title');
    const resAsideDesc = document.getElementById('res-aside-desc');
    const resScaleFill = document.getElementById('res-scale-fill');
    const resScaleLabel = document.getElementById('res-scale-label');
    
    // Exporters
    const iacOutput = document.getElementById('iac-code-output');
    const copyIacBtn = document.getElementById('copy-iac-code');
    const copyJsonBtn = document.getElementById('copy-ipv4-json');
    const copyCsvBtn = document.getElementById('copy-ipv4-csv');
    const copyMarkdownBtn = document.getElementById('copy-ipv4-markdown');
    const shareLinkBtn = document.getElementById('share-link-btn');

    // Inline Splitter State
    interface InlineSubnetNode {
      networkLong: number;
      cidr: number;
      label: string;
    }

    let inlineSubnets: InlineSubnetNode[] = [];
    let baseNetworkLong = 0;
    let baseCidrVal = 24;

    function resetInlineSplitter(networkIp: string, cidr: number) {
      baseCidrVal = cidr;
      const ipLong = ip2Long(networkIp);
      baseNetworkLong = (ipLong & (cidr === 0 ? 0 : (~0 << (32 - cidr)) >>> 0)) >>> 0;
      
      inlineSubnets = [{
        networkLong: baseNetworkLong,
        cidr: cidr,
        label: "Subnet 1"
      }];
      
      renderInlineSplitter();
    }

    function splitInlineSubnet(index: number) {
      const node = inlineSubnets[index];
      if (node.cidr >= 32) return;

      const newCidr = node.cidr + 1;
      const offset = Math.pow(2, 32 - newCidr);

      const child1: InlineSubnetNode = {
        networkLong: node.networkLong,
        cidr: newCidr,
        label: `${node.label} (A)`
      };

      const child2: InlineSubnetNode = {
        networkLong: node.networkLong + offset,
        cidr: newCidr,
        label: `${node.label} (B)`
      };

      inlineSubnets.splice(index, 1, child1, child2);
      renderInlineSplitter();
    }

    function canMergeInline(index: number): boolean {
      const node = inlineSubnets[index];
      if (node.cidr <= baseCidrVal) return false;

      const offset = Math.pow(2, 32 - node.cidr);
      const isRightSibling = (node.networkLong / offset) % 2 === 1;
      const siblingNetwork = isRightSibling ? node.networkLong - offset : node.networkLong + offset;

      const siblingIndex = inlineSubnets.findIndex(s => s.networkLong === siblingNetwork && s.cidr === node.cidr);
      return siblingIndex !== -1;
    }

    function mergeInlineSubnet(index: number) {
      const node = inlineSubnets[index];
      if (node.cidr <= baseCidrVal) return;

      const offset = Math.pow(2, 32 - node.cidr);
      const isRightSibling = (node.networkLong / offset) % 2 === 1;
      const siblingNetwork = isRightSibling ? node.networkLong - offset : node.networkLong + offset;
      const siblingIndex = inlineSubnets.findIndex(s => s.networkLong === siblingNetwork && s.cidr === node.cidr);

      if (siblingIndex === -1) return;

      const parentCidr = node.cidr - 1;
      const parentNetwork = isRightSibling ? siblingNetwork : node.networkLong;

      const parentNode: InlineSubnetNode = {
        networkLong: parentNetwork,
        cidr: parentCidr,
        label: node.label.replace(/\s*\(A\)|\s*\(B\)/g, '') || "Merged Subnet"
      };

      const firstIdx = Math.min(index, siblingIndex);
      inlineSubnets.splice(firstIdx, 2, parentNode);
      renderInlineSplitter();
    }

    function renderInlineSplitter() {
      const grid = document.getElementById('inline-splitter-grid');
      const tableBody = document.getElementById('inline-splitter-table-body');
      const baseDisplay = document.getElementById('inline-splitter-base-display');
      
      if (!grid || !tableBody) return;

      const baseIpStr = long2Ip(baseNetworkLong);
      if (baseDisplay) baseDisplay.innerText = `${baseIpStr}/${baseCidrVal}`;

      inlineSubnets.sort((a, b) => a.networkLong - b.networkLong);

      let gridHtml = '';
      const totalBlocksCapacity = Math.pow(2, 32 - baseCidrVal);

      inlineSubnets.forEach((node, idx) => {
        const nodeCapacity = Math.pow(2, 32 - node.cidr);
        const widthPct = (nodeCapacity / totalBlocksCapacity) * 100;
        
        let sizeClass = 'size-medium';
        if (node.cidr - baseCidrVal <= 1) sizeClass = 'size-large';
        else if (node.cidr - baseCidrVal >= 4) sizeClass = 'size-small';

        const canMergeNode = canMergeInline(idx);

        gridHtml += `
          <div class="subnet-block ${sizeClass}" style="flex: 1 1 ${widthPct}%; min-width: max(120px, ${widthPct}%); max-width: 100%; padding: 0.6rem 0.75rem;">
            <div class="subnet-block-highlight"></div>
            <div class="subnet-info" style="margin-bottom: 0.5rem;">
              <div class="subnet-meta" style="flex-direction: column; gap: 0.25rem;">
                <span class="subnet-cidr" style="font-size: 0.75rem; font-weight: bold;">${long2Ip(node.networkLong)}/${node.cidr}</span>
                <input 
                  type="text" 
                  class="inline-subnet-label-input" 
                  value="${node.label}" 
                  data-idx="${idx}" 
                  placeholder="Label..."
                  style="background:none; border:none; border-bottom: 1px dashed var(--border-color); color:var(--text-primary); font-size:0.75rem; outline:none; max-width:90px;"
                />
              </div>
            </div>
            <div class="subnet-actions" style="display: flex; gap: 0.25rem;">
              ${node.cidr < 32 ? `<button class="subnet-btn inline-split-btn" data-split="${idx}" style="padding: 0.15rem 0.4rem; font-size: 0.7rem; min-height: unset; height: 22px;">${calcData.btnSplit || 'Split'}</button>` : ''}
              ${canMergeNode ? `<button class="subnet-btn inline-merge-btn" data-merge="${idx}" style="padding: 0.15rem 0.4rem; font-size: 0.7rem; min-height: unset; height: 22px;">${calcData.btnMerge || 'Merge'}</button>` : ''}
            </div>
          </div>
        `;
      });
      grid.innerHTML = gridHtml;

      let tableHtml = '';
      inlineSubnets.forEach((node, idx) => {
        const calculated = calculateSubnet(long2Ip(node.networkLong), node.cidr, 'standard');

        tableHtml += `
          <tr>
            <td>
              <input 
                type="text" 
                class="inline-subnet-table-label-input" 
                value="${node.label}" 
                data-idx="${idx}" 
                aria-label="Subnet Label ${idx + 1}"
                style="background:none; border:none; border-bottom: 1px dashed var(--border-color); color:var(--text-primary); font-size:0.8rem; outline:none; max-width: 100px;"
              />
            </td>
            <td><strong>${calculated.network}/${node.cidr}</strong></td>
            <td>${node.cidr >= 31 ? `${calculated.network} - ${calculated.broadcast}` : `${calculated.firstUsable} - ${calculated.lastUsable}`}</td>
            <td>${calculated.usableHosts.toLocaleString()}</td>
            <td>
              <div style="display:flex; gap:0.25rem;">
                ${node.cidr < 32 ? `<button class="subnet-btn inline-split-btn" data-split="${idx}" style="padding: 0.2rem 0.4rem; font-size: 0.7rem; min-height: unset; height: 24px;">${calcData.btnSplit || 'Split'}</button>` : ''}
                ${canMergeInline(idx) ? `<button class="subnet-btn inline-merge-btn" data-merge="${idx}" style="padding: 0.2rem 0.4rem; font-size: 0.7rem; min-height: unset; height: 24px;">${calcData.btnMerge || 'Merge'}</button>` : ''}
              </div>
            </td>
          </tr>
        `;
      });
      tableBody.innerHTML = tableHtml;

      // Event listeners for inline split/merge
      grid.querySelectorAll('.inline-split-btn').forEach(btn => {
        (btn as HTMLButtonElement).onclick = (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).getAttribute('data-split')!, 10);
          splitInlineSubnet(idx);
        };
      });

      grid.querySelectorAll('.inline-merge-btn').forEach(btn => {
        (btn as HTMLButtonElement).onclick = (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).getAttribute('data-merge')!, 10);
          mergeInlineSubnet(idx);
        };
      });

      tableBody.querySelectorAll('.inline-split-btn').forEach(btn => {
        (btn as HTMLButtonElement).onclick = (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).getAttribute('data-split')!, 10);
          splitInlineSubnet(idx);
        };
      });

      tableBody.querySelectorAll('.inline-merge-btn').forEach(btn => {
        (btn as HTMLButtonElement).onclick = (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).getAttribute('data-merge')!, 10);
          mergeInlineSubnet(idx);
        };
      });

      // Label syncing listeners
      grid.querySelectorAll('.inline-subnet-label-input').forEach(input => {
        input.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const idx = parseInt(target.getAttribute('data-idx')!, 10);
          inlineSubnets[idx].label = target.value;
          const tableInput = tableBody.querySelector(`.inline-subnet-table-label-input[data-idx="${idx}"]`) as HTMLInputElement;
          if (tableInput) tableInput.value = target.value;
        });
      });

      tableBody.querySelectorAll('.inline-subnet-table-label-input').forEach(input => {
        input.addEventListener('input', (e) => {
          const target = e.target as HTMLInputElement;
          const idx = parseInt(target.getAttribute('data-idx')!, 10);
          inlineSubnets[idx].label = target.value;
          const blockInput = grid.querySelector(`.inline-subnet-label-input[data-idx="${idx}"]`) as HTMLInputElement;
          if (blockInput) blockInput.value = target.value;
        });
      });
    }

    function renderExamMode(exam: ReturnType<typeof calculateExamMath>) {
      if (!examModeContent) return;

      const hopsHtml = exam.multiples.slice(0, 8).map(m => {
        const isActive = m === exam.lowerBoundary;
        return `<span class="hop-badge ${isActive ? 'active-hop' : ''}">.${m}</span>`;
      }).join('') + (exam.multiples.length > 8 ? '<span class="hop-badge">...</span>' : '');

      examModeContent.innerHTML = `
        <div class="exam-grid">
          <!-- Card 1: Subnet & Host Bit Calculations -->
          <div class="exam-step-card">
            <div class="step-num-badge">STEP 1</div>
            <h4>Bit Allocation (2<sup>s</sup> & 2<sup>h</sup> &minus; 2)</h4>
            <div class="formula-box">
              <div class="formula-line">
                <span class="f-label">Subnets Created:</span>
                <code>2<sup>s</sup> = 2<sup>${exam.borrowedBits}</sup> = ${exam.subnetsCreated.toLocaleString()}</code>
              </div>
              <div class="formula-line">
                <span class="f-label">Usable Host IPs:</span>
                <code>2<sup>h</sup> &minus; 2 = 2<sup>${exam.hostBits}</sup> &minus; 2 = ${exam.usableHosts.toLocaleString()}</code>
              </div>
            </div>
            <p class="exam-step-desc">
              IP is Class <strong>${exam.ipClass}</strong> (default /${exam.defaultClassCidr}). Borrowing <strong>${exam.borrowedBits}</strong> bits creates <strong>${exam.subnetsCreated.toLocaleString()}</strong> subnets with <strong>${exam.hostBits}</strong> host bits remaining.
            </p>
          </div>

          <!-- Card 2: Magic Number & Block Size -->
          <div class="exam-step-card highlight">
            <div class="step-num-badge">STEP 2</div>
            <h4>Magic Number & Block Size</h4>
            <div class="formula-box">
              <div class="formula-line">
                <span class="f-label">Interesting Octet:</span>
                <code>${exam.interestingOctetName} (Mask: ${exam.maskOctetValue})</code>
              </div>
              <div class="formula-line">
                <span class="f-label">Magic Number:</span>
                <code class="highlight-magic">256 &minus; ${exam.maskOctetValue} = ${exam.magicNumber}</code>
              </div>
            </div>
            <p class="exam-step-desc">
              The subnet boundary falls in the <strong>${exam.interestingOctetName}</strong>. Subnet blocks increment by multiples of <strong>${exam.magicNumber}</strong>.
            </p>
          </div>

          <!-- Card 3: Boundary Hops & Range Identification -->
          <div class="exam-step-card">
            <div class="step-num-badge">STEP 3</div>
            <h4>Boundary Hops & Range Identification</h4>
            <div class="hops-ribbon">
              ${hopsHtml}
            </div>
            <p class="exam-step-desc">
              Octet value is <strong>${exam.ipOctetValue}</strong>. It falls between <strong>.${exam.lowerBoundary}</strong> and <strong>.${exam.broadcastOctet}</strong>.
            </p>
            <div class="exam-summary-strip">
              <span><strong>Net ID:</strong> ${exam.networkIp}</span>
              <span><strong>Usable:</strong> ${exam.firstUsableIp} - ${exam.lastUsableIp}</span>
              <span><strong>Broadcast:</strong> ${exam.broadcastIp}</span>
            </div>
          </div>

          <!-- Card 4: Bitwise AND Verification -->
          <div class="exam-step-card">
            <div class="step-num-badge">STEP 4</div>
            <h4>Bitwise AND Verification</h4>
            <div class="and-table">
              <div class="and-row"><span class="and-lbl">IP (${exam.ipOctetValue}):</span><code class="and-bits">${exam.andOperation.ipOctetBin}</code></div>
              <div class="and-row"><span class="and-lbl">Mask (${exam.maskOctetValue}):</span><code class="and-bits">${exam.andOperation.maskOctetBin}</code></div>
              <div class="and-row and-result"><span class="and-lbl">AND Result:</span><code class="and-bits">${exam.andOperation.andResultBin} (=${exam.andOperation.resultDec})</code></div>
            </div>
            <p class="exam-step-desc">
              Bitwise AND produces <strong>${exam.andOperation.resultDec}</strong>, validating the Network ID.
            </p>
          </div>
        </div>
      `;
    }

    function updateAll() {
      const ip = ipInput.value.trim();
      const cidr = parseInt(cidrInput.value, 10);
      const cloud = cloudSelector.value as 'standard' | 'aws' | 'azure' | 'gcp';

      // Format validation
      if (!validateIPv4(ip)) {
        errorBanner?.classList.add('show');
        return;
      } else {
        errorBanner?.classList.remove('show');
      }

      // Run math
      const result = calculateSubnet(ip, cidr, cloud);
      const bits = getBinaryBits(ip, cidr);
      const exam = calculateExamMath(ip, cidr);

      // Sync netmask input when user is not typing in it
      if (netmaskInput && document.activeElement !== netmaskInput) {
        netmaskInput.value = result.netmask;
      }

      // Update display text fields
      if (resNetwork) resNetwork.innerText = `${result.network}/${cidr}`;
      if (resHostRange) resHostRange.innerText = `${result.firstUsable} - ${result.lastUsable}`;
      if (resMask) resMask.innerText = result.netmask;
      if (resWildcard) resWildcard.innerText = result.wildcard;
      if (resBroadcast) resBroadcast.innerText = result.broadcast;
      if (resTotalHosts) resTotalHosts.innerText = result.totalHosts.toLocaleString();
      if (resUsableHosts) resUsableHosts.innerText = result.usableHosts.toLocaleString();
      
      // Update aside elements
      if (resAsideTitle) {
        resAsideTitle.innerText = (calcData.yourSubnetTitle || 'Your /{cidr} Subnet').replace('{cidr}', cidr.toString());
      }
      if (resAsideDesc) {
        const pre = calcData.asideDescPre || 'A subnet with a mask of';
        const mid = calcData.asideDescMid || 'provides';
        const post = calcData.asideDescPost || 'usable IP addresses for devices.';
        resAsideDesc.innerText = `${pre} ${result.netmask} ${mid} ${result.usableHosts.toLocaleString()} ${post}`;
      }
      if (resScaleFill) {
        resScaleFill.style.width = `${(cidr / 32) * 100}%`;
      }
      if (resScaleLabel) {
        resScaleLabel.innerText = (calcData.prefixSizing || 'Prefix Sizing: /{cidr}').replace('{cidr}', cidr.toString());
      }

      // Re-render Details List
      if (resDetails) {
        resDetails.innerHTML = result.reservedDetails.map(detail => `
          <li style="color: var(--text-secondary); display: flex; align-items: center; gap: 0.5rem;">
            <span style="color: var(--accent-host); font-weight: bold;">•</span> ${detail}
          </li>
        `).join('');
      }

      // Re-render Interactive Binary grid
      if (binaryGrid) {
        const ipParts = ip.split('.');
        let html = '';
        for (let oIndex = 0; oIndex < 4; oIndex++) {
          html += `
            <div class="binary-octet-col">
              <div class="binary-bit-weights">
                <span>128</span><span>64</span><span>32</span><span>16</span><span>8</span><span>4</span><span>2</span><span>1</span>
              </div>
              <div class="binary-octet" data-octet="${oIndex + 1}">
          `;
          const slice = bits.slice(oIndex * 8, (oIndex + 1) * 8);
          slice.forEach((bit, bIdx) => {
            const globalIdx = oIndex * 8 + bIdx;
            const isBoundary = globalIdx + 1 === cidr;
            html += `
              <button 
                type="button" 
                class="binary-bit ${bit.type} ${isBoundary ? 'boundary-bit' : ''}" 
                data-bit-idx="${globalIdx}" 
                data-bit-val="${bit.val}"
                data-octet-idx="${bit.octetIndex}"
                title="Bit ${globalIdx + 1} (Weight ${Math.pow(2, 7 - bit.bitIndex)}): ${bit.type === 'net' ? 'Network' : 'Host'} Bit. Click to ${bitInteractionMode === 'prefix' ? 'set prefix /' + (globalIdx + 1) : 'flip bit to ' + (bit.val === '1' ? '0' : '1')}"
                aria-label="Bit ${globalIdx + 1}, value ${bit.val}"
              >${bit.val}</button>
            `;
          });
          html += `
              </div>
              <div class="binary-octet-footer">
                Octet ${oIndex + 1}: <strong class="octet-dec-val">${ipParts[oIndex] || '0'}</strong>
              </div>
            </div>
          `;
        }
        binaryGrid.innerHTML = html;

        // Attach bit click handlers
        binaryGrid.querySelectorAll('.binary-bit').forEach(btn => {
          (btn as HTMLButtonElement).onclick = (e) => {
            const target = e.currentTarget as HTMLButtonElement;
            const bitIdx = parseInt(target.getAttribute('data-bit-idx')!, 10);
            
            if (bitInteractionMode === 'prefix') {
              const newCidr = bitIdx + 1;
              cidrInput.value = newCidr.toString();
              cidrSlider.value = newCidr.toString();
              scheduledUpdate();
            } else {
              // Flip bit in IP address
              const currentLong = ip2Long(ipInput.value);
              // In 32-bit big endian: bit 0 from left is bit 31
              const bitMask = (1 << (31 - bitIdx)) >>> 0;
              const flippedLong = (currentLong ^ bitMask) >>> 0;
              ipInput.value = long2Ip(flippedLong);
              scheduledUpdate();
            }
          };
        });
      }

      // Re-render Exam Mode Step-by-Step Breakdown
      renderExamMode(exam);

      // Update Subnet Stepper Badges and States
      if (stepperCurrentBadge) {
        stepperCurrentBadge.innerText = `${result.network}/${cidr}`;
      }
      if (stepperDeltaBadge) {
        const blockSize = Math.pow(2, 32 - cidr);
        const currentIpLong = ip2Long(ip);
        const maskLong = (cidr === 0 ? 0 : (~0 << (32 - cidr)) >>> 0);
        const currentNetLong = (currentIpLong & maskLong) >>> 0;
        
        stepperDeltaBadge.innerText = `Step: ±${blockSize.toLocaleString()} IPs (Magic Number: ${exam.magicNumber})`;
        
        if (btnPrevSubnet) {
          btnPrevSubnet.disabled = (cidr === 0 || currentNetLong - blockSize < 0);
        }
        if (btnNextSubnet) {
          btnNextSubnet.disabled = (cidr === 0 || currentNetLong + blockSize > 0xFFFFFFFF);
        }
      }

      // Update IaC Snippet Code block
      updateIaCCode(result.network, cidr, cloud, result.netmask, result.wildcard, result.firstUsable);

      // Reset inline splitter if base CIDR or base Network changed
      const currentNetworkLong = ip2Long(result.network);
      if (currentNetworkLong !== baseNetworkLong || cidr !== baseCidrVal) {
        resetInlineSplitter(result.network, cidr);
      }
    }

    // Non-blocking rAF scheduler
    let updateRaf: number | null = null;
    function scheduledUpdate() {
      if (updateRaf) cancelAnimationFrame(updateRaf);
      updateRaf = requestAnimationFrame(updateAll);
    }

    function updateIaCCode(network: string, cidr: number, cloud: string, netmask?: string, wildcard?: string, firstUsable?: string) {
      if (!iacOutput) return;
      
      const iacSelect = document.getElementById('export-iac-select') as HTMLSelectElement;
      const format = iacSelect ? iacSelect.value : 'tf';
      const actualNetmask = netmask || (resMask ? resMask.innerText : '255.255.255.0');
      const actualWildcard = wildcard || (resWildcard ? resWildcard.innerText : '0.0.0.255');
      const actualFirst = firstUsable || (resHostRange ? resHostRange.innerText.split(' - ')[0] : `${network}`);

      if (format === 'cisco-ios') {
        iacOutput.innerText = `! Cisco IOS Interface & Static Route Configuration
! 1. Assign interface IP in subnet ${network}/${cidr}
interface GigabitEthernet0/1
 description Subnet Link
 ip address ${actualFirst} ${actualNetmask}
 no shutdown
exit

! 2. Static route targeting this subnet
ip route ${network} ${actualNetmask} GigabitEthernet0/1`;
      } else if (format === 'cisco-acl') {
        iacOutput.innerText = `! Cisco IOS Access Control List (ACL) with Wildcard Mask
! Standard ACL to permit this subnet:
access-list 10 permit ${network} ${actualWildcard}

! Extended ACL permitting all traffic from this subnet:
access-list 101 permit ip ${network} ${actualWildcard} any

! Named Extended ACL:
ip access-list extended LAB_PERMIT_SUBNET
 permit ip ${network} ${actualWildcard} any
exit`;
      } else if (format === 'linux-iproute2') {
        iacOutput.innerText = `# Linux iproute2 Network Configuration
# 1. Assign IP address and CIDR prefix to interface
sudo ip addr add ${actualFirst}/${cidr} dev eth0

# 2. Bring interface up
sudo ip link set dev eth0 up

# 3. Add static subnet route
sudo ip route add ${network}/${cidr} dev eth0`;
      } else if (format === 'tf') {
        if (cloud === 'aws') {
          iacOutput.innerText = `# AWS VPC Subnet IaC snippet
resource "aws_subnet" "subnet_aws" {
  vpc_id            = "vpc-12345678"
  cidr_block        = "${network}/${cidr}"
  availability_zone = "us-east-1a"
  
  tags = {
    Name        = "subnet-${cidr}"
    Environment = "production"
  }
}`;
        } else if (cloud === 'azure') {
          iacOutput.innerText = `# Microsoft Azure VNet Subnet
resource "azurerm_subnet" "subnet_azure" {
  name                 = "subnet-${cidr}"
  resource_group_name  = "rg-prod"
  virtual_network_name = "vnet-prod"
  address_prefixes     = ["${network}/${cidr}"]
}`;
        } else {
          iacOutput.innerText = `# Standard Terraform Subnet Allocation
resource "terraform_subnet" "subnet_generic" {
  cidr_block = "${network}/${cidr}"
  description = "Assigned IP Block"
}`;
        }
      } else if (format === 'yaml') {
        iacOutput.innerText = `# Ansible Network Subnet Settings
network_config:
  subnet_ip: "${network}"
  cidr_prefix: ${cidr}
  provider_rules: "${cloud}"
    metadata:
      description: "Calculated via devsubnet.com"
      host_capacity: ${cidr}`;
      } else if (format === 'pulumi-ts') {
        iacOutput.innerText = `import * as aws from "@pulumi/aws";

const subnet = new aws.ec2.Subnet("subnet", {
    vpcId: "vpc-12345678",
    cidrBlock: "${network}/${cidr}",
    availabilityZone: "us-east-1a",
    tags: { Name: "subnet-${cidr}" },
});`;
      } else if (format === 'pulumi-py') {
        iacOutput.innerText = `import pulumi_aws as aws

subnet = aws.ec2.Subnet("subnet",
    vpc_id="vpc-12345678",
    cidr_block="${network}/${cidr}",
    availability_zone="us-east-1a",
    tags={"Name": "subnet-${cidr}"}
)`;
      } else if (format === 'cfn') {
        iacOutput.innerText = `Resources:
  Subnet:
    Type: AWS::EC2::Subnet
    Properties:
      VpcId: vpc-12345678
      CidrBlock: ${network}/${cidr}
      AvailabilityZone: us-east-1a
      Tags:
        - Key: Name
          Value: subnet-${cidr}`;
      } else if (format === 'cdk-ts') {
        iacOutput.innerText = `import * as ec2 from 'aws-cdk-lib/aws-ec2';

// Inside Stack constructor:
const subnet = new ec2.Subnet(this, 'Subnet', {
  vpcId: 'vpc-12345678',
  cidrBlock: '${network}/${cidr}',
  availabilityZone: 'us-east-1a',
});`;
      } else if (format === 'bicep') {
        iacOutput.innerText = `resource subnet 'Microsoft.Network/virtualNetworks/subnets@2023-09-01' = {
  name: 'vnet-prod/subnet-${cidr}'
  properties: {
    addressPrefix: '${network}/${cidr}'
  }
}`;
      }
    }

    // Bind Listeners
    ipInput.oninput = scheduledUpdate;
    
    // Smart IP Parsing on blur or paste (handles 192.168.1.1 255.255.255.240 or 192.168.1.1/28)
    ipInput.addEventListener('change', () => {
      const parsed = parseSmartIpInput(ipInput.value);
      if (parsed) {
        ipInput.value = parsed.ip;
        if (parsed.cidr !== undefined) {
          cidrInput.value = parsed.cidr.toString();
          cidrSlider.value = parsed.cidr.toString();
        }
        scheduledUpdate();
      }
    });

    // Reverse Netmask / Wildcard input listener
    if (netmaskInput) {
      netmaskInput.addEventListener('input', () => {
        const val = netmaskInput.value.trim();
        const cidrFromMask = netmaskToCidr(val) ?? wildcardToCidr(val);
        if (cidrFromMask !== null) {
          cidrInput.value = cidrFromMask.toString();
          cidrSlider.value = cidrFromMask.toString();
          scheduledUpdate();
        }
      });
    }

    // Interactive Bit Grid Mode Switcher
    if (modePrefixBtn && modeFlipBtn && binaryModeInstruction) {
      modePrefixBtn.onclick = () => {
        bitInteractionMode = 'prefix';
        modePrefixBtn.classList.add('active');
        modeFlipBtn.classList.remove('active');
        binaryModeInstruction.innerHTML = 'Click any bit above to set the <strong>CIDR prefix boundary</strong> directly.';
        scheduledUpdate();
      };

      modeFlipBtn.onclick = () => {
        bitInteractionMode = 'flip';
        modeFlipBtn.classList.add('active');
        modePrefixBtn.classList.remove('active');
        binaryModeInstruction.innerHTML = 'Click any bit above to <strong>flip its value (0 ↔ 1)</strong> and watch the IP address dynamically recalculate.';
        scheduledUpdate();
      };
    }

    // Exam Mode Toggle
    if (examModeToggle && examModeContent) {
      examModeToggle.onclick = () => {
        examModeExpanded = !examModeExpanded;
        examModeToggle.setAttribute('aria-expanded', String(examModeExpanded));
        if (examModeExpanded) {
          examModeContent.style.display = 'block';
          if (examToggleLabel) examToggleLabel.innerText = calcData.hideMathLabel || 'Hide Step-by-Step Math';
        } else {
          examModeContent.style.display = 'none';
          if (examToggleLabel) examToggleLabel.innerText = calcData.showMathLabel || 'Show Step-by-Step Math';
        }
      };
    }

    // CLI Quick Copy Handlers
    function triggerCopyFeedback(btn: HTMLElement, originalText: string) {
      btn.classList.add('copied');
      const span = btn.querySelector('span');
      if (span) span.innerText = 'Copied to Clipboard!';
      setTimeout(() => {
        btn.classList.remove('copied');
        if (span) span.innerText = originalText;
      }, 2000);
    }

    if (quickCopyCiscoIp) {
      quickCopyCiscoIp.onclick = async () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        if (!validateIPv4(ip)) return;
        const res = calculateSubnet(ip, cidr, 'standard');
        const text = `ip address ${res.firstUsable} ${res.netmask}`;
        await navigator.clipboard.writeText(text);
        triggerCopyFeedback(quickCopyCiscoIp, 'Cisco IOS IP');
      };
    }

    if (quickCopyCiscoAcl) {
      quickCopyCiscoAcl.onclick = async () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        if (!validateIPv4(ip)) return;
        const res = calculateSubnet(ip, cidr, 'standard');
        const text = `access-list 101 permit ip ${res.network} ${res.wildcard} any`;
        await navigator.clipboard.writeText(text);
        triggerCopyFeedback(quickCopyCiscoAcl, 'Cisco ACL Wildcard');
      };
    }

    if (quickCopyLinuxIp) {
      quickCopyLinuxIp.onclick = async () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        if (!validateIPv4(ip)) return;
        const res = calculateSubnet(ip, cidr, 'standard');
        const text = `sudo ip addr add ${res.firstUsable}/${cidr} dev eth0`;
        await navigator.clipboard.writeText(text);
        triggerCopyFeedback(quickCopyLinuxIp, 'Linux iproute2');
      };
    }

    if (quickCopyCiscoRoute) {
      quickCopyCiscoRoute.onclick = async () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        if (!validateIPv4(ip)) return;
        const res = calculateSubnet(ip, cidr, 'standard');
        const text = `ip route ${res.network} ${res.netmask} GigabitEthernet0/1`;
        await navigator.clipboard.writeText(text);
        triggerCopyFeedback(quickCopyCiscoRoute, 'Cisco Route');
      };
    }

    // Subnet Stepper Click Handlers
    function stepSubnetBlock(direction: 'prev' | 'next') {
      const ip = ipInput.value.trim();
      const cidr = parseInt(cidrInput.value, 10);
      if (!validateIPv4(ip) || isNaN(cidr) || cidr < 0 || cidr > 32 || cidr === 0) return;

      const blockSize = Math.pow(2, 32 - cidr);
      const currentIpLong = ip2Long(ip);
      const maskLong = (~0 << (32 - cidr)) >>> 0;
      const currentNetLong = (currentIpLong & maskLong) >>> 0;

      let targetNetLong: number;
      if (direction === 'next') {
        if (currentNetLong + blockSize > 0xFFFFFFFF) return;
        targetNetLong = currentNetLong + blockSize;
      } else {
        if (currentNetLong - blockSize < 0) return;
        targetNetLong = currentNetLong - blockSize;
      }

      ipInput.value = long2Ip(targetNetLong >>> 0);
      scheduledUpdate();
    }

    btnPrevSubnet?.addEventListener('click', () => stepSubnetBlock('prev'));
    btnNextSubnet?.addEventListener('click', () => stepSubnetBlock('next'));
    
    cidrInput.oninput = (e) => {
      const val = parseInt((e.target as HTMLInputElement).value, 10);
      if (!isNaN(val) && val >= 0 && val <= 32) {
        cidrSlider.value = val.toString();
        scheduledUpdate();
      }
    };

    cidrSlider.oninput = (e) => {
      const val = (e.target as HTMLInputElement).value;
      cidrInput.value = val;
      scheduledUpdate();
    };

    cloudSelector.onchange = scheduledUpdate;

    // Preset Buttons
    document.querySelectorAll('[data-fill]').forEach(btn => {
      (btn as HTMLButtonElement).onclick = (e) => {
        const [ip, cidr] = (e.currentTarget as HTMLButtonElement).getAttribute('data-fill')!.split('/');
        ipInput.value = ip;
        cidrInput.value = cidr;
        cidrSlider.value = cidr;
        updateAll();
      };
    });

    // IaC Lang selection dropdown
    const iacSelect = document.getElementById('export-iac-select') as HTMLSelectElement;
    if (iacSelect) {
      iacSelect.onchange = () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        const result = calculateSubnet(ip, cidr, cloudSelector.value as any);
        updateIaCCode(result.network, cidr, cloudSelector.value, result.netmask, result.wildcard, result.firstUsable);
      };
    }

    // Copy & Share Buttons
    if (copyJsonBtn) {
      copyJsonBtn.onclick = async () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        const cloud = cloudSelector.value as any;
        if (!validateIPv4(ip)) return;
        const res = calculateSubnet(ip, cidr, cloud);
        
        await navigator.clipboard.writeText(JSON.stringify(res, null, 2));
        copyJsonBtn.innerText = calcData.copied || 'Copied!';
        copyJsonBtn.classList.add('copied');
        setTimeout(() => {
          copyJsonBtn.innerText = calcData.copyJson || 'Copy JSON';
          copyJsonBtn.classList.remove('copied');
        }, 2000);
      };
    }

    if (copyCsvBtn) {
      copyCsvBtn.onclick = async () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        const cloud = cloudSelector.value as any;
        if (!validateIPv4(ip)) return;
        const res = calculateSubnet(ip, cidr, cloud);

        const csvContent = [
          ['Metric', 'Value'],
          [calcData.networkRange || 'Network Range / Address', `${res.network}/${cidr}`],
          [calcData.usableHosts || 'Usable Host IPs', `${res.firstUsable} - ${res.lastUsable}`],
          [calcData.subnetMask || 'Subnet Mask', res.netmask],
          [calcData.wildcardMask || 'Wildcard Mask', res.wildcard],
          [calcData.broadcast || 'Broadcast Address', res.broadcast],
          [calcData.totalCapacity || 'Total IP Capacity', res.totalHosts],
          [calcData.usableCapacityLabel || 'Usable Host Capacity', res.usableHosts]
        ].map(row => row.map(cell => `"${cell}"`).join(',')).join('\n');

        await navigator.clipboard.writeText(csvContent);
        copyCsvBtn.innerText = calcData.copied || 'Copied!';
        copyCsvBtn.classList.add('copied');
        setTimeout(() => {
          copyCsvBtn.innerText = calcData.copyCsv || 'Copy CSV';
          copyCsvBtn.classList.remove('copied');
        }, 2000);
      };
    }

    if (copyMarkdownBtn) {
      copyMarkdownBtn.onclick = async () => {
        const ip = ipInput.value.trim();
        const cidr = parseInt(cidrInput.value, 10);
        const cloud = cloudSelector.value as any;
