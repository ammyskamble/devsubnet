---
import { type SupportedLanguage } from '../utils/i18n';
import Layout from '../layouts/Layout.astro';
import MainShell from '../components/MainShell.astro';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout lang={lang} 
  title="DevSubnet - Online IP Subnet Calculator & CIDR Calculator"
  description="DevSubnet is the free online IP subnet calculator and CIDR calculator online. Calculate IPv4 & IPv6 network ranges, subnet masks, broadcast addresses, usable hosts, cloud VPC reservations for AWS/Azure/GCP, and Terraform cidrsubnet planning instantly."
>
  <MainShell lang={lang} activeTab="ipv4" defaultCloud="standard">
  </MainShell>

  <!-- FAQ Schema for SEO -->
  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a subnet calculator and how does it work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A subnet calculator is a software utility used by network engineers, IT professionals, and students to divide IP networks into smaller subnets. By entering an IP address and CIDR prefix (e.g. /24), the calculator automates binary math to instantly determine the network address, broadcast address, subnet mask, usable host IP range, and cloud-aware VPC reserved IPs without manual calculation."
          }
        },
        {
          "@type": "Question",
          "name": "How do I calculate subnets using the Magic Number method for CCNA and CCNP exams?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To calculate subnets using the Magic Number method on Cisco exams: (1) Identify the interesting octet in the subnet mask (the octet that is neither 255 nor 0). (2) Subtract the interesting mask octet from 256 to determine the block size (e.g., 256 - 192 = 64). (3) Count in multiples of the magic number (0, 64, 128, 192). (4) Identify the multiple that is less than or equal to your IP octet to find the Network ID."
          }
        },
        {
          "@type": "Question",
          "name": "How do I perform a reverse netmask or wildcard mask lookup?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In DevSubnet, enter any dotted-decimal subnet mask (such as 255.255.255.240) or wildcard mask (such as 0.0.0.15) directly into the Subnet Mask field. DevSubnet converts the mask to CIDR notation (/28) and displays the network boundary, broadcast IP, and usable host range."
          }
        },
        {
          "@type": "Question",
          "name": "Can I copy Cisco IOS or Linux CLI commands directly from this subnet calculator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. DevSubnet provides 1-click quick-copy buttons for Cisco IOS interface configuration (ip address 192.168.1.1 255.255.255.0), Cisco ACL wildcard syntax, and Linux iproute2 commands (sudo ip addr add dev eth0) directly for Packet Tracer, GNS3, and EVE-NG labs."
          }
        },
        {
          "@type": "Question",
          "name": "How do I use this online IP subnet calculator and CIDR calculator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To use this online IP subnet calculator, enter any IPv4 or IPv6 address and adjust the CIDR prefix length slider. Our online IP CIDR calculator instantly computes the subnet mask, network ID, broadcast address, usable host IP range, wildcard mask, and cloud VPC reserved IPs (for AWS, Azure, and GCP) directly in your browser with zero server latency."
          }
        },
        {
          "@type": "Question",
          "name": "What is a subnet mask and how does it work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A subnet mask is a 32-bit number used to divide an IP address into two parts: the network address and the host address. It works by performing a bitwise AND operation on the IP address, where binary '1's represent the network portion and binary '0's represent the host portion."
          }
        },
        {
          "@type": "Question",
          "name": "How do I calculate subnets from an IP address?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "To calculate subnets, convert the CIDR slash notation or subnet mask to binary. Identify the network bits (marked as 1) and host bits (marked as 0). The number of subnets you can create is 2^n, where n is the number of borrowed bits. Usable hosts per subnet is 2^h - 2."
          }
        },
        {
          "@type": "Question",
          "name": "What is CIDR notation and how is it used?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "CIDR (Classless Inter-Domain Routing) notation is a compact way of representing an IP address and its associated routing prefix. It consists of an IP address, a slash character ('/'), and a decimal number indicating the number of bits allocated to the network prefix (e.g., /24 implies 24 network bits)."
          }
        },
        {
          "@type": "Question",
          "name": "How many usable hosts are in a /24 subnet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A /24 subnet has 256 total IP addresses. After subtracting the network address (the first IP) and the broadcast address (the last IP), you have exactly 254 usable host IP addresses."
          }
        }
      ]
    }
  </script>
</Layout>
