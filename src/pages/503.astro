---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import { type SupportedLanguage } from '../utils/i18n';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout 
  lang={lang} 
  noindex={true}
  title="503 – Service Temporarily Unavailable | DevSubnet"
  description="Our edge servers are temporarily undergoing scheduled maintenance or experiencing capacity limits. DevSubnet will be back shortly."
>
  <div class="app-shell">
    <NavBar lang={lang} path="error" />

    <main class="error-main">
      <div class="error-container">
        <!-- Status Badge -->
        <div class="status-badge" role="status">
          <span class="maint-icon">🔧</span>
          <span class="badge-code">ERR_503_SERVICE_MAINTENANCE</span>
        </div>

        <h1 class="error-title">
          <span class="code-number">503</span>
          <span class="title-text">Service Temporarily Unavailable</span>
        </h1>

        <p class="error-description">
          Our edge routing infrastructure is undergoing scheduled upgrades or traffic re-routing. The service will resume normal operations in moments.
        </p>

        <!-- Live Countdown & Status Box -->
        <div class="maintenance-card" aria-label="Maintenance Status & Auto Retry">
          <div class="maint-header">
            <span class="maint-title">EDGE GATEWAY RE-SYNCHRONIZATION</span>
            <span class="maint-pulse-badge">UPGRADE IN PROGRESS</span>
          </div>

          <div class="countdown-section">
            <span class="countdown-label">Automatically attempting reconnect in:</span>
            <div class="timer-display">
              <span id="seconds-left" class="timer-number">30</span>
              <span class="timer-unit">seconds</span>
            </div>
            <div class="progress-bar-wrap" aria-hidden="true">
              <div id="countdown-bar" class="progress-bar-fill"></div>
            </div>
          </div>

          <div class="offline-note">
            <span class="note-icon">⚡</span>
            <span>Tip: Pre-cached calculators operate entirely client-side without server roundtrips.</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
          <button type="button" id="force-retry-btn" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
            Retry Now
          </button>
          <a href="/" class="btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Return to Calculator
          </a>
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<style>
  .error-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3.5rem 1.5rem 5rem;
    min-height: calc(100vh - 180px);
  }

  .error-container {
    max-width: 44rem;
    width: 100%;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Status Badge */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(168, 85, 247, 0.12);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .maint-icon {
    font-size: 0.95rem;
    line-height: 1;
  }

  /* Error Heading */
  .error-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .code-number {
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 9vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    background: linear-gradient(135deg, #c084fc 0%, #38bdf8 50%, #34d399 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .title-text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .error-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 34rem;
    margin: 0 0 2.25rem;
  }

  /* Maintenance Card */
  .maintenance-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem 2rem;
    width: 100%;
    margin-bottom: 2.5rem;
    backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-md);
    text-align: left;
  }

  .maint-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .maint-title {
    color: var(--text-muted);
    font-weight: 600;
  }

  .maint-pulse-badge {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    font-size: 0.7rem;
  }

  .countdown-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem 0;
  }

  .countdown-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .timer-display {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .timer-number {
    font-family: var(--font-mono);
    font-size: 3rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
  }

  .timer-unit {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .progress-bar-wrap {
    width: 100%;
    max-width: 20rem;
    height: 6px;
    background: var(--bg-secondary);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, #38bdf8, #a855f7);
    border-radius: var(--radius-full);
    transition: width 1s linear;
  }

  .offline-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .note-icon {
    color: #eab308;
  }

  /* Actions */
  .action-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    color: #ffffff;
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    border: none;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .btn-secondary:hover {
    background: var(--bg-secondary);
    border-color: rgba(161, 66, 244, 0.4);
  }
</style>

<script>
  let seconds = 30;
  const initialSeconds = 30;
  const timerEl = document.getElementById('seconds-left');
  const barEl = document.getElementById('countdown-bar');
  const forceBtn = document.getElementById('force-retry-btn');

  const interval = setInterval(() => {
    seconds -= 1;
    if (timerEl) {
      timerEl.textContent = String(seconds);
    }
    if (barEl) {
      barEl.style.width = `${(seconds / initialSeconds) * 100}%`;
    }

    if (seconds <= 0) {
      clearInterval(interval);
      window.location.reload();
    }
  }, 1000);

  if (forceBtn) {
    forceBtn.addEventListener('click', () => {
      clearInterval(interval);
      window.location.reload();
    });
  }
</script>
