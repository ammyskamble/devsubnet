---
import { translations, type SupportedLanguage } from '../utils/i18n';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = "en" } = Astro.props;
const t = translations[lang] || translations.en;
const guide = t.guide;
const langPrefix = lang === 'en' ? '' : `/${lang}`;
---

<section class="seo-netsudoku-section" aria-labelledby="seo-section-title">
  <div class="seo-netsudoku-container">
    <!-- Header Title & Lead Paragraph -->
    <h2 id="seo-section-title">{guide.title}</h2>
    <p class="lead">{guide.lead}</p>

    <!-- Card Grid for SEO Topics -->
    <h3 style="margin-top: 0;">{guide.exploreTitle}</h3>
    <div class="seo-netsudoku-grid">
      {guide.cards.map((card) => (
        <div class="seo-netsudoku-card">
          <div>
            <h4>{card.title}</h4>
            <p>{card.desc}</p>
          </div>
          <a href={card.href} class="card-link">
            {card.linkText}
          </a>
        </div>
      ))}
    </div>

    <!-- Additional Rich Content Section -->
    <h3>{guide.prefixTableTitle}</h3>
    <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.5rem;">
      {guide.prefixTableDesc}
    </p>
    <div class="guide-table-wrapper" style="margin-bottom: 3rem;">
      <table class="guide-table">
        <thead>
          <tr>
            <th>CIDR Prefix</th>
            <th>Subnet Mask</th>
            <th>Wildcard Mask</th>
            <th>Usable Hosts (Standard)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>/32</td><td>255.255.255.255</td><td>0.0.0.0</td><td>1 Host</td></tr>
          <tr><td>/31</td><td>255.255.255.254</td><td>0.0.0.1</td><td>2 Hosts (Point-to-point)</td></tr>
          <tr><td>/30</td><td>255.255.255.252</td><td>0.0.0.3</td><td>2 Hosts</td></tr>
          <tr><td>/29</td><td>255.255.255.248</td><td>0.0.0.7</td><td>6 Hosts</td></tr>
          <tr><td>/28</td><td>255.255.255.240</td><td>0.0.0.15</td><td>14 Hosts</td></tr>
          <tr><td>/27</td><td>255.255.255.224</td><td>0.0.0.31</td><td>30 Hosts</td></tr>
          <tr><td>/26</td><td>255.255.255.192</td><td>0.0.0.63</td><td>62 Hosts</td></tr>
          <tr><td>/25</td><td>255.255.255.128</td><td>0.0.0.127</td><td>126 Hosts</td></tr>
          <tr><td>/24</td><td>255.255.255.0</td><td>0.0.0.255</td><td>254 Hosts</td></tr>
          <tr><td>/23</td><td>255.255.254.0</td><td>0.0.1.255</td><td>510 Hosts</td></tr>
          <tr><td>/22</td><td>255.255.252.0</td><td>0.0.3.255</td><td>1,022 Hosts</td></tr>
          <tr><td>/20</td><td>255.255.240.0</td><td>0.0.15.255</td><td>4,094 Hosts</td></tr>
          <tr><td>/16</td><td>255.255.0.0</td><td>0.0.255.255</td><td>65,534 Hosts</td></tr>
          <tr><td>/8</td><td>255.0.0.0</td><td>0.255.255.255</td><td>16,777,214 Hosts</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Comparison Table Section -->
    <h3>{guide.comparisonTitle}</h3>
    <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.5rem;">
      {guide.comparisonDesc}
    </p>
    <div class="guide-table-wrapper" style="margin-bottom: 3rem;">
      <table class="guide-table">
        <thead>
          <tr>
            <th>Feature / Capability</th>
            <th>DevSubnet</th>
            <th>Basic calculators</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Cloud-aware VPC (AWS / Azure / GCP)</td><td style="color: var(--accent-highlight); font-weight: 600;">Yes</td><td style="color: var(--text-muted);">No</td></tr>
          <tr><td>IPv4 + IPv6 Dual-Stack</td><td style="color: var(--accent-highlight); font-weight: 600;">Yes</td><td style="color: var(--text-muted);">Often IPv4 only</td></tr>
          <tr><td>Terraform cidrsubnet() planning</td><td style="color: var(--accent-highlight); font-weight: 600;">Yes</td><td style="color: var(--text-muted);">No</td></tr>
          <tr><td>Kubernetes & CNI cluster planning</td><td style="color: var(--accent-highlight); font-weight: 600;">Yes</td><td style="color: var(--text-muted);">No</td></tr>
          <tr><td>VLSM segmentation</td><td style="color: var(--accent-highlight); font-weight: 600;">Yes</td><td style="color: var(--text-muted);">No</td></tr>
          <tr><td>Subnet overlap conflict detection</td><td style="color: var(--accent-highlight); font-weight: 600;">Yes</td><td style="color: var(--text-muted);">No</td></tr>
          <tr><td>CIDR supernetting / aggregation</td><td style="color: var(--accent-highlight); font-weight: 600;">Yes</td><td style="color: var(--text-muted);">No</td></tr>
          <tr><td>Binary grid visualization</td><td style="color: var(--accent-highlight); font-weight: 600;">Yes</td><td style="color: var(--text-muted);">Rare</td></tr>
          <tr><td>No signup, 100% in-browser security</td><td style="color: var(--accent-highlight); font-weight: 600;">Yes</td><td style="color: var(--text-secondary);">Varies</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Dedicated SEO Content: Online IP Subnet Calculator & CIDR Calculator -->
    <h3>Why Use an Online IP Subnet Calculator &amp; CIDR Calculator?</h3>
    <p style="color: var(--text-secondary); font-size: 0.92rem; line-height: 1.7; margin-bottom: 1.5rem;">
      Whether designing enterprise cloud VPCs across Australia and the Netherlands or studying for CCNA/CCNP certifications in the United States and the United Kingdom, using an <strong>online ip subnet calculator</strong> eliminates human calculation errors. A dependable <strong>ip cidr calculator</strong> translates slash notation (e.g. <code>/24</code>, <code>/27</code>) into binary subnet masks, network IDs, broadcast addresses, and usable host counts in nanoseconds.
    </p>
    <div class="seo-netsudoku-grid" style="margin-bottom: 3rem;">
      <div class="seo-netsudoku-card">
        <div>
          <h4 style="font-size: 1.05rem;">Fast In-Browser Subnet Calculator</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            Traditional calculators transmit your network IP topology to remote servers. Our <strong>online ip subnet calculator</strong> runs 100% client-side via JavaScript, ensuring confidential corporate IP schemas remain strictly inside your browser.
          </p>
        </div>
      </div>
      <div class="seo-netsudoku-card">
        <div>
          <h4 style="font-size: 1.05rem;">Precise CIDR Calculator Online</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            Our <strong>cidr calculator online</strong> automatically accounts for vendor-specific reserved IPs across AWS (5 reserved IPs), Azure VNet (5 reserved IPs), and Google Cloud (4 reserved IPs) to prevent subnet exhaustion and IP routing collisions.
          </p>
        </div>
      </div>
      <div class="seo-netsudoku-card">
        <div>
          <h4 style="font-size: 1.05rem;">CIDR Calculator to Subnet Mask Conversion</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            Instantly map any prefix with our <strong>ip cidr calculator</strong>. View binary bitwise breakdowns, wildcard masks, and usable host ranges with zero delay.
          </p>
        </div>
      </div>
      <div class="seo-netsudoku-card">
        <div>
          <h4 style="font-size: 1.05rem;">Multi-Region Cloud Architecture</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            Engineered for global DevOps infrastructure, from Sydney (ap-southeast-2) and Amsterdam (europe-west4) to London (eu-west-2) and Northern Virginia (us-east-1). Plan non-overlapping CIDR blocks with confidence.
          </p>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <h3 id="faq-section-title">{guide.faqTitle}</h3>
    <div class="seo-netsudoku-grid" style="margin-bottom: 2rem;">
      <div class="seo-netsudoku-card">
        <div>
          <h4 style="font-size: 1.05rem;">What is a subnet calculator and how does it work?</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            A <strong>subnet calculator</strong> is a software utility used by network administrators, IT engineers, and students to divide IP networks into smaller subnets. By entering an IP address and CIDR prefix (such as <code>/24</code>), it automates binary math to output the network address, broadcast address, subnet mask, usable host IP range, and cloud VPC reservations.
          </p>
        </div>
      </div>
      <div class="seo-netsudoku-card">
        <div>
          <h4 style="font-size: 1.05rem;">How do I calculate subnets using an IP subnet calculator online?</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            Using an <strong>ip subnet calculator online</strong>, enter your IPv4 or IPv6 network address and select your prefix. The tool calculates network boundaries, broadcast addresses, and usable host ranges instantly without manual binary arithmetic.
          </p>
        </div>
      </div>
      <div class="seo-netsudoku-card">
        <div>
          <h4 style="font-size: 1.05rem;">What is a subnet mask and how does it work?</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            A subnet mask is a 32-bit number used to divide an IP address into two parts: the network address and the host address. It works by performing a bitwise AND operation on the IP address.
          </p>
        </div>
      </div>

      <div class="seo-netsudoku-card">
        <div>
          <h4 style="font-size: 1.05rem;">How do I calculate subnets from an IP address?</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            Convert CIDR slash notation or subnet mask to binary. The number of subnets is 2<sup>n</sup> (borrowed bits) and usable hosts is 2<sup>h</sup> - 2.
          </p>
        </div>
      </div>

      <div class="seo-netsudoku-card">
        <div>
          <h4 style="font-size: 1.05rem;">What is CIDR notation and how is it used?</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            CIDR notation represents an IP address and its routing prefix length (e.g. /24 implies 24 network bits) to replace rigid legacy classful addressing.
          </p>
        </div>
      </div>

      <div class="seo-netsudoku-card">
        <div>
          <h4 style="font-size: 1.05rem;">How many usable hosts are in a /24 subnet?</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary);">
            A /24 subnet has 256 total IP addresses. Subtracting 2 addresses for network and broadcast leaves exactly 254 usable hosts.
          </p>
        </div>
      </div>
    </div>

    <!-- Link to FAQ page -->
    <div style="margin-bottom: 3.5rem;">
      <a href={`${langPrefix}/faq`} class="btn-seo-primary" style="display: inline-block;">{guide.faqViewAll}</a>
    </div>

    <!-- CTA Buttons Row -->
    <div class="seo-netsudoku-ctas">
      <a href={`${langPrefix}/`} class="btn-seo-primary">{guide.ctaPrimary}</a>
      <a href={`${langPrefix}/visual-subnet-splitter`} class="btn-seo-secondary">{guide.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .seo-netsudoku-section {
    border-top: 1px solid var(--border-color);
    padding: 5rem 1.5rem;
    position: relative;
    background-color: rgba(var(--bg-secondary), 0.1);
    content-visibility: auto;
    contain-intrinsic-size: 1px 1200px;
  }
  
  .seo-netsudoku-container {
    max-width: 56rem;
    margin: 0 auto;
    text-align: left;
  }
  
  .seo-netsudoku-container h2 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }
  
  .seo-netsudoku-container p.lead {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
  }

  .seo-netsudoku-container h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 3.5rem;
    margin-bottom: 1.5rem;
  }
  
  .seo-netsudoku-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .seo-netsudoku-card {
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    border-radius: var(--radius-md);
    background-color: var(--bg-surface);
    backdrop-filter: blur(var(--glass-blur));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .seo-netsudoku-card:hover {
    border-color: var(--accent-network);
    transform: translateY(-2px);
  }
  
  .seo-netsudoku-card h4 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  
  .seo-netsudoku-card p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .seo-netsudoku-card .card-link {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-network);
    text-decoration: none;
    margin-top: 1.25rem;
    display: inline-block;
  }

  .seo-netsudoku-card .card-link:hover {
    text-decoration: underline;
  }

  .guide-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }

  .guide-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  .guide-table th {
    background: rgba(255,255,255,0.03);
    padding: 0.85rem 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
  }

  .guide-table td {
    padding: 0.75rem 1.2rem;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  /* Button CTA Row */
  .seo-netsudoku-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .btn-seo-primary {
    background-color: var(--text-primary);
    color: var(--bg-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .btn-seo-primary:hover {
    opacity: 0.9;
  }

  .btn-seo-secondary {
    border: 1px solid var(--border-color);
    background-color: transparent;
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .btn-seo-secondary:hover {
    background-color: var(--bg-secondary);
  }

  @media (max-width: 768px) {
    .seo-netsudoku-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
