---
import Footer from '../components/Footer.astro';
import { type SupportedLanguage } from '../utils/i18n';

import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout lang={lang} 
  title="About DevSubnet – Free Client-Side IP Subnet Calculator & Tools"
  description="Learn about DevSubnet's mission, privacy architecture, publisher standards, and commitment to free, zero-latency networking tools for sysadmins, cloud architects, and students."
>
  <div class="app-shell">
    <NavBar lang={lang} path='about' />

    <main class="page-main">
      <div class="content-container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={lang === 'en' ? '/' : `/${lang}/`}>Home</a> <span class="sep">/</span> <strong>About Us</strong>
        </nav>

        <section class="page-header">
          <div class="eyebrow">OUR MISSION & TRANSPARENCY</div>
          <h1>About devsubnet.com</h1>
          <p class="lede">
            Building modern, privacy-first, client-side networking utilities engineered for sysadmins, cloud architects, DevOps teams, and students worldwide.
          </p>
        </section>

        <section class="page-body">
          <div class="card-grid">
            <div class="info-card">
              <h2>Who We Are</h2>
              <p>
                devsubnet.com was built by a dedicated team of network engineers and cloud systems architects who set out to eliminate outdated, ad-cluttered, slow subnet calculators. Our goal is to provide a clean, modern, and accessible suite of IP calculation tools for developers, network administrators, and certification candidates worldwide.
              </p>
            </div>
            
            <div class="info-card">
              <h2>Privacy-First Architecture</h2>
              <p>
                Unlike traditional online tools that transmit query parameters to backend servers, devsubnet.com operates <strong>entirely inside your browser</strong>. All IP mathematical operations, CIDR conversions, Kubernetes node sizing, and visual subnet partitioning happen locally. Your network topology data never leaves your device.
              </p>
            </div>
          </div>

          <div class="text-block">
            <h2>Our Operational & Revenue Model</h2>
            <p>
              devsubnet.com is committed to remaining 100% free and accessible to all users worldwide without paywalls, subscriptions, or required account registration. To cover domain costs, CDN infrastructure, continuous feature development, and open-source maintenance, we display context-relevant advertisements served through <strong>Google AdSense</strong>.
            </p>
            <p style="margin-top: 0.75rem;">
              We maintain strict separation between ad delivery and our core calculation logic. Advertisements are clearly demarcated and non-intrusive, ensuring your workflow remains smooth and efficient.
            </p>
          </div>

          <div class="text-block">
            <h2>Technical & Editorial Standards</h2>
            <p>
              All IP mathematical routines, CIDR boundary calculations, and IaC code template generators (Terraform, Ansible) are rigorously tested against official IETF RFC standards (RFC 791, RFC 4632, RFC 1918, RFC 4291) and cloud provider documentation (AWS VPC, Azure VNet, GCP VPC, Kubernetes CNI).
            </p>
          </div>

          <div class="text-block">
            <h2>Trademarks & Non-Affiliation Statement</h2>
            <p>
              devsubnet.com is an independent developer utility tool. Amazon Web Services (AWS), Microsoft Azure, Google Cloud Platform (GCP), Kubernetes, Terraform, Cilium, and Calico are registered trademarks of their respective owners. devsubnet.com is not affiliated with, endorsed by, or sponsored by Amazon.com Inc., Microsoft Corporation, Google LLC, The Linux Foundation, or HashiCorp Inc.
            </p>
          </div>

          <div class="text-block">
            <h2>Open Source & Community</h2>
            <p>
              We believe in open technical standards and community collaboration. The source code for devsubnet.com is hosted publicly on <a href="https://github.com/ammyskamble/devsubnet" target="_blank" rel="noopener noreferrer">GitHub</a>. Users and network professionals are invited to review the code, report issues, suggest feature enhancements, or contribute improvements.
            </p>
          </div>

          <div class="text-block">
            <h2>Get in Touch</h2>
            <p>
              Have questions, technical suggestions, or feedback? Visit our <a href="/contact">Contact Page</a> or reach out directly to our engineering team at <a href="mailto:support@devsubnet.com">support@devsubnet.com</a>.
            </p>
          </div>
        </section>

        <div class="page-cta">
          <a href="/" class="btn-return">← Return to Calculator</a>
        </div>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<style>
  .page-main {
    flex: 1;
    padding: 3rem 1.5rem 5rem;
  }

  .content-container {
    max-width: 54rem;
    margin: 0 auto;
    text-align: left;
  }

  .breadcrumb {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }

  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb .sep { color: var(--text-secondary); }

  .page-header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2.5rem;
  }

  .page-header .eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .page-header .lede {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 40rem;
    margin: 0;
  }

  .page-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .info-card {
    background-color: var(--card-bg, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .info-card h2 {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 1rem;
    color: var(--text-primary);
  }

  .info-card p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  .text-block h2 {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
    color: var(--text-primary);
  }

  .text-block p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0;
  }

  .text-block a {
    color: var(--accent);
    text-decoration: none;
  }

  .text-block a:hover {
    text-decoration: underline;
  }

  .page-cta {
    margin-top: 3.5rem;
  }

  .btn-return {
    display: inline-block;
    background: var(--text-primary);
    color: var(--bg-primary);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .btn-return:hover { opacity: 0.85; }

  /* Theme Toggle */
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .theme-toggle:hover {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
  }

  .theme-toggle .sun { display: none; width: 1.25rem; height: 1.25rem; }
  .theme-toggle .moon { display: block; width: 1.25rem; height: 1.25rem; }

  :root[data-theme="light"] .theme-toggle .sun  { display: block; }
  :root[data-theme="light"] .theme-toggle .moon { display: none; }
</style>

<script>
  const themeBtn = document.getElementById('theme-btn');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const doc = document.documentElement;
      const next = doc.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      doc.setAttribute('data-theme', next);
      localStorage.setItem('devsubnet-theme', next);
    });
  }
</script>
