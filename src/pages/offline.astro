---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import { type SupportedLanguage } from '../utils/i18n';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';

const cachedTools = [
  { name: 'IPv4 Subnet Calculator', href: '/', icon: '⚡', desc: 'Pre-cached & operates 100% offline' },
  { name: 'Visual Subnet Splitter', href: '/visual-subnet-splitter', icon: '🔀', desc: 'Interactive local partition tree' },
  { name: 'VLSM Calculator', href: '/vlsm-calculator', icon: '📊', desc: 'Client-side variable mask solver' },
  { name: 'CIDR Cheat Sheet', href: '/subnet-cheat-sheet', icon: '📋', desc: 'Complete local reference table' },
  { name: 'IPv6 Subnet Calculator', href: '/ipv6-subnet-calculator', icon: '🌐', desc: '128-bit hex offline calculation' }
];
---

<Layout 
  lang={lang} 
  noindex={true}
  title="Offline Mode – Network Disconnected | DevSubnet"
  description="You are currently offline. DevSubnet's IP calculators are pre-cached and operate 100% locally in your browser without internet access."
>
  <div class="app-shell">
    <NavBar lang={lang} path="error" />

    <main class="error-main">
      <div class="error-container">
        <!-- Status Badge -->
        <div id="conn-badge" class="status-badge offline" role="status">
          <span class="pulse-dot"></span>
          <span id="conn-status-text" class="badge-code">ERR_INTERNET_DISCONNECTED</span>
        </div>

        <h1 class="error-title">
          <span class="title-icon" aria-hidden="true">📡</span>
          <span class="title-text">You Are Currently Offline</span>
        </h1>

        <p class="error-description">
          Your internet connection appears to be lost. However, <strong>DevSubnet's core calculators run entirely client-side</strong> and remain ready for use without any network connection!
        </p>

        <!-- Live Connectivity Status Indicator -->
        <div class="offline-diagnostic-card">
          <div class="diag-header">
            <span class="diag-title">PWA OFFLINE CACHE STATUS</span>
            <span class="diag-status">OFFLINE STORAGE ACTIVE</span>
          </div>
          <div class="diag-details">
            <div class="diag-stat">
              <span class="stat-number">100%</span>
              <span class="stat-label">Local Processing</span>
            </div>
            <div class="diag-stat">
              <span class="stat-number">0 KB</span>
              <span class="stat-label">Server Data Needed</span>
            </div>
            <div class="diag-stat">
              <span class="stat-number">⚡</span>
              <span class="stat-label">Instant Calculation</span>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
          <button type="button" id="check-conn-btn" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
            Check Connection
          </button>
          <a href="/" class="btn-secondary">
            Launch IPv4 Calculator
          </a>
        </div>

        <!-- Offline-Ready Tools Grid -->
        <section class="cached-section" aria-label="Available Offline Calculators">
          <h2 class="section-heading">Pre-Cached Calculators Available Offline</h2>
          <div class="tool-grid">
            {cachedTools.map((tool) => (
              <a href={tool.href} class="tool-card">
                <span class="tool-icon">{tool.icon}</span>
                <div class="tool-info">
                  <span class="tool-name">{tool.name}</span>
                  <span class="tool-desc">{tool.desc}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<style>
  .error-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3.5rem 1.5rem 5rem;
    min-height: calc(100vh - 180px);
  }

  .error-container {
    max-width: 46rem;
    width: 100%;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Status Badge */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    transition: all var(--transition-normal);
  }

  .status-badge.offline {
    background: rgba(245, 158, 11, 0.12);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .status-badge.online {
    background: rgba(16, 185, 129, 0.12);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: currentColor;
    box-shadow: 0 0 8px currentColor;
    animation: pulseGlow 1.8s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* Error Heading */
  .error-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    line-height: 1.15;
  }

  .title-icon {
    font-size: 3rem;
    line-height: 1;
  }

  .title-text {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .error-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 36rem;
    margin: 0 0 2.25rem;
  }

  .error-description strong {
    color: var(--text-primary);
  }

  /* Diagnostic Card */
  .offline-diagnostic-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem 2rem;
    width: 100%;
    max-width: 36rem;
    margin-bottom: 2.5rem;
    backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-md);
    text-align: left;
  }

  .diag-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diag-title {
    color: var(--text-muted);
    font-weight: 600;
  }

  .diag-status {
    color: #34d399;
    font-weight: 700;
  }

  .diag-details {
    display: flex;
    justify-content: space-around;
    text-align: center;
    gap: 1rem;
  }

  .diag-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-number {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Actions */
  .action-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    color: #ffffff;
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    border: none;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .btn-secondary:hover {
    background: var(--bg-secondary);
    border-color: rgba(161, 66, 244, 0.4);
  }

  /* Cached Tools Section */
  .cached-section {
    width: 100%;
    text-align: left;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    width: 100%;
  }

  .tool-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem 1.15rem;
    text-decoration: none;
    transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .tool-card:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.4);
    background: var(--panel-bg);
  }

  .tool-icon {
    font-size: 1.4rem;
    line-height: 1;
    margin-top: 0.1rem;
  }

  .tool-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tool-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .tool-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.35;
  }
</style>

<script>
  const checkBtn = document.getElementById('check-conn-btn');
  const badge = document.getElementById('conn-badge');
  const statusText = document.getElementById('conn-status-text');

  function updateStatus() {
    if (navigator.onLine) {
      if (badge) {
        badge.classList.remove('offline');
        badge.classList.add('online');
      }
      if (statusText) {
        statusText.textContent = 'INTERNET_CONNECTION_RESTORED';
      }
      setTimeout(() => {
        window.location.reload();
      }, 1200);
    } else {
      if (badge) {
        badge.classList.remove('online');
        badge.classList.add('offline');
      }
      if (statusText) {
        statusText.textContent = 'ERR_INTERNET_DISCONNECTED';
      }
    }
  }

  window.addEventListener('online', updateStatus);
  window.addEventListener('offline', updateStatus);

  if (checkBtn) {
    checkBtn.addEventListener('click', () => {
      fetch('/favicon.ico', { method: 'HEAD', cache: 'no-store' })
        .then(() => {
          updateStatus();
          window.location.reload();
        })
        .catch(() => {
          updateStatus();
        });
    });
  }
</script>
