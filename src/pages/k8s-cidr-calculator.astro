---
import Footer from '../components/Footer.astro';
import { type SupportedLanguage, translations } from '../utils/i18n';

import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
const t = translations[lang] || translations.en;
---

<Layout lang={lang}
  title={`${t.intro.k8sCidr.title} | DevSubnet`}
  description={t.intro.k8sCidr.lede}
>
  <div class="app-shell">
    <NavBar lang={lang} path="k8s-cidr" />

    <main>
      <!-- Hero Intro -->
      <section class="intro" aria-labelledby="page-title">
        <div class="eyebrow">{t.intro.k8sCidr.eyebrow}</div>
        <h1 id="page-title">{t.intro.k8sCidr.title}</h1>
        <p class="lede">
          {t.intro.k8sCidr.lede}
        </p>
      </section>

      <!-- Calculator Panel -->
      <section class="calculator-panel" style="margin-bottom: 2.5rem;">
        <div class="panel-heading">
          <div><span class="step">01</span><h2>Cluster Architecture & CNI Parameters</h2></div>
          <span class="live-label">K8S CLUSTER SIZER</span>
        </div>

        <div class="k8s-calc-grid">
          <!-- Inputs Column -->
          <div class="k8s-inputs-col">
            <div class="field-group">
              <label for="k8s-nodes-count">Target Maximum Node Count</label>
              <input type="number" id="k8s-nodes-count" value="100" min="1" max="10000" class="ip-input" />
              <span class="field-hint">Maximum number of worker nodes planned for the cluster</span>
            </div>

            <div class="field-group">
              <label for="k8s-pods-per-node">Max Pods per Node</label>
              <select id="k8s-pods-per-node" class="cloud-select">
                <option value="30">30 Pods/Node (Lightweight/Microservices)</option>
                <option value="64">64 Pods/Node (Standard Enterprise)</option>
                <option value="110" selected>110 Pods/Node (Default Kubernetes / EKS)</option>
                <option value="250">250 Pods/Node (High Density / GKE)</option>
              </select>
            </div>

            <div class="field-group">
              <label for="k8s-cni-type">CNI Plugin Architecture</label>
              <select id="k8s-cni-type" class="cloud-select">
                <option value="cilium" selected>Cilium (eBPF Overlay / ClusterPool IPAM)</option>
                <option value="calico">Project Calico (BGP / VXLAN Overlay)</option>
                <option value="awsvpc">AWS VPC CNI (Prefix Delegation / Secondary ENI)</option>
                <option value="azurecni">Azure CNI (Overlay Mode / VNet Integration)</option>
                <option value="flannel">Flannel (Host-GW / VXLAN)</option>
              </select>
            </div>

            <div class="field-group">
              <label for="k8s-base-pod-cidr">Pod Network Base CIDR</label>
              <input type="text" id="k8s-base-pod-cidr" value="10.244.0.0/16" class="ip-input" />
              <span class="field-hint">Global CIDR allocated for all Pod IP addresses</span>
            </div>

            <div class="field-group">
              <label for="k8s-service-cidr">Service ClusterIP Base CIDR</label>
              <input type="text" id="k8s-service-cidr" value="10.96.0.0/16" class="ip-input" />
              <span class="field-hint">Internal VIPs for ClusterIP services and CoreDNS</span>
            </div>
          </div>

          <!-- Live Output & Diagnostics Column -->
          <div class="k8s-diagnostics-col">
            <div class="diagnostic-card" id="diag-summary-card">
              <div class="diag-header">
                <span class="diag-title">CIDR Sizing Metrics</span>
                <span class="diag-badge" id="diag-status-badge">HEALTHY</span>
              </div>

              <div class="diag-metric-row">
                <span>Per-Node Subnet Mask:</span>
                <strong id="diag-node-mask">/24 (254 Pod IPs per Node)</strong>
              </div>
              <div class="diag-metric-row">
                <span>Max Accommodated Nodes:</span>
                <strong id="diag-max-nodes">256 Nodes</strong>
              </div>
              <div class="diag-metric-row">
                <span>Total Cluster Pod Capacity:</span>
                <strong id="diag-total-pods">65,024 Pods</strong>
              </div>
              <div class="diag-metric-row">
                <span>Service IP Capacity:</span>
                <strong id="diag-service-ips">65,534 ClusterIPs</strong>
              </div>
              <div class="diag-metric-row">
                <span>CoreDNS Service IP:</span>
                <strong id="diag-dns-ip">10.96.0.10</strong>
              </div>

              <div id="diag-exhaustion-warning" class="diag-warning" style="display: none;">
                ⚠️ <strong>Risk Detected:</strong> Target node count exceeds Pod CIDR capacity. Expand base Pod CIDR (e.g. to /14) or adjust per-node mask.
              </div>
            </div>

            <!-- Copyable Config Output -->
            <div style="margin-top: 1.25rem;">
              <div class="output-header">
                <span class="output-title">Export Kubernetes Manifest</span>
                <button id="copy-k8s-btn" class="btn-copy" type="button">Copy Manifest</button>
              </div>
              <pre class="code-box"><code id="k8s-manifest-output"># Generating Kubernetes Manifest...</code></pre>
            </div>
          </div>
        </div>
      </section>

      <!-- CNI Pod Sizing & Density Calculator Section -->
      <section class="calculator-panel" style="margin-bottom: 2.5rem;">
        <div class="panel-heading">
          <div><span class="step">02</span><h2>CNI Pod Sizing & Density Calculator</h2></div>
          <span class="live-label" style="background-color:rgba(145, 80, 245, 0.12); color:var(--accent-host);">POD DENSITY SIZER</span>
        </div>

        <div class="k8s-calc-grid">
          <!-- Inputs Column -->
          <div class="k8s-inputs-col">
            <div class="field-group">
              <label for="density-cni-type">CNI Plugin & Mode</label>
              <select id="density-cni-type" class="cloud-select">
                <option value="calico" selected>Project Calico Overlay (IPv4)</option>
                <option value="cilium-v4">Cilium Overlay (IPv4)</option>
                <option value="cilium-v6">Cilium Overlay (IPv6 Prefix Mode)</option>
                <option value="awsvpc-std">AWS VPC CNI (Standard Mode)</option>
                <option value="awsvpc-prefix">AWS VPC CNI (Prefix Delegation Mode)</option>
                <option value="azurecni">Azure CNI VNet Integration</option>
              </select>
              <span class="field-hint">Defines the address allocation boundaries per worker node.</span>
            </div>

            <div class="field-group" id="density-cidr-wrapper">
              <label for="density-node-cidr">Chosen Node CIDR size</label>
              <select id="density-node-cidr" class="cloud-select">
                <option value="24" selected>/24 (254 usable IPs)</option>
              </select>
              <span class="field-hint">The prefix size allocated to each individual node for Pod IPs.</span>
            </div>

            <div class="field-group" id="density-aws-wrapper" style="display: none;">
              <label for="density-aws-instance">AWS Instance Type</label>
              <select id="density-aws-instance" class="cloud-select">
                <option value="t3.micro">t3.micro (2 ENIs, 2 IPs/ENI)</option>
                <option value="t3.medium" selected>t3.medium (3 ENIs, 6 IPs/ENI)</option>
                <option value="m5.large">m5.large (3 ENIs, 10 IPs/ENI)</option>
                <option value="m5.xlarge">m5.xlarge (4 ENIs, 15 IPs/ENI)</option>
                <option value="m5.4xlarge">m5.4xlarge (8 ENIs, 30 IPs/ENI)</option>
                <option value="custom">Custom Configuration...</option>
              </select>
              <span class="field-hint">Determines hardware-bound ENI and IP limits.</span>
            </div>

            <div class="field-group" id="density-custom-aws-wrapper" style="display: none; gap: 1rem;">
              <div style="flex: 1;">
                <label for="density-eni-count" style="margin-bottom: 0.35rem; display: block;">ENI Count</label>
                <input type="number" id="density-eni-count" value="3" min="1" max="20" class="ip-input" style="width: 100%;" />
              </div>
              <div style="flex: 1;">
                <label for="density-ip-per-eni" style="margin-bottom: 0.35rem; display: block;">IPs/ENI</label>
                <input type="number" id="density-ip-per-eni" value="6" min="1" max="50" class="ip-input" style="width: 100%;" />
              </div>
            </div>

            <div class="field-group">
              <label for="density-kubelet-limit">Kubelet Max Pods Limit</label>
              <input type="number" id="density-kubelet-limit" value="110" min="1" max="500" class="ip-input" />
              <span class="field-hint">Kubernetes kubelet hard limit (Standard is 110, High density is 250).</span>
            </div>
          </div>

          <!-- Diagnostics Column -->
          <div class="k8s-diagnostics-col">
            <div class="diagnostic-card" style="height: 100%;">
              <div class="diag-header">
                <span class="diag-title">Per-Node Sizing Metrics</span>
                <span class="diag-badge" style="background: rgba(145, 80, 245, 0.15); color: var(--accent-host);">CNI METRICS</span>
              </div>

              <div class="diag-metric-row">
                <span>IP Allocation from Subnet:</span>
                <strong id="density-out-ip-cap">256 IPs</strong>
              </div>
              <div class="diag-metric-row">
                <span>CNI Plugin Limit:</span>
                <strong id="density-out-cni-limit">110 Pods</strong>
              </div>
              <div class="diag-metric-row">
                <span>Kubelet Ceiling:</span>
                <strong id="density-out-kubelet-limit">110 Pods</strong>
              </div>
              <div class="diag-metric-row" style="border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem; margin-bottom: 0.75rem;">
                <span>Usable Pods per Node:</span>
                <strong id="density-out-usable-pods" style="color:var(--accent-network); font-size: 1.05rem;">110 Pods</strong>
              </div>

              <div id="density-out-status" class="diag-warning" style="background: rgba(56, 189, 248, 0.05); border: 1px solid rgba(56, 189, 248, 0.2); color: var(--text-primary); margin-top: 0.5rem; line-height: 1.5;">
                Optimizing layout metrics...
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Technical Architecture Section -->
      <section class="guide-section">
        <div class="guide-sticky">
          <h2>Kubernetes <em>Networking</em> Rules</h2>
        </div>
        <div class="guide-content">
          <div class="guide-block">
            <h3>Pod-to-Pod Communication Without NAT</h3>
            <p>
              Kubernetes fundamental networking model dictates that every Pod receives its own unique routable IP address and can communicate with all other Pods without Network Address Translation (NAT).
            </p>
          </div>

          <div class="guide-block">
            <h3>Overlay vs. Direct VPC Routing (AWS VPC CNI & Azure CNI)</h3>
            <p>
              When using <strong>AWS VPC CNI</strong> or <strong>Azure CNI (Native)</strong>, Pod IPs are drawn directly from the underlying VPC subnet rather than an isolated overlay. Always enable <strong>Prefix Delegation</strong> in EKS to avoid exhausting AWS Elastic Network Interface (ENI) attachment limits!
            </p>
          </div>

          <div class="guide-block">
            <h3>Service CIDR & CoreDNS Allocation</h3>
            <p>
              The Service CIDR is virtual and handled by <code>kube-proxy</code> / Cilium eBPF via iptables/IPVS/eBPF maps. The 10th IP (e.g. <code>10.96.0.10</code>) is traditionally reserved for the CoreDNS cluster resolver.
            </p>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <Footer lang={lang} />
  </div>

  <!-- FAQ Schema for SEO -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I plan IP ranges for a Kubernetes cluster?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Allocate three non-overlapping CIDR blocks: one for Node IPs, one for Pod IPs, and one for Service IPs. The Pod CIDR must be large enough to give each Node a subnet (usually /24 or /26) based on the max pods per node setting in your kubelet configuration."
          }
        },
        {
          "@type": "Question",
          "name": "What IP addresses does AWS reserve in a VPC subnet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AWS reserves 5 IP addresses in every VPC subnet: x.x.x.0 (network address), x.x.x.1 (VPC router), x.x.x.2 (DNS resolver), x.x.x.3 (reserved for future use), and x.x.x.255 (broadcast address)."
          }
        },
        {
          "@type": "Question",
          "name": "How many usable hosts are in a /24 subnet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A /24 subnet contains 256 total IP addresses. After subtracting the network address (the first IP) and the broadcast address (the last IP), you have exactly 254 usable host IP addresses."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a /16 and /24 subnet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A /16 subnet allocates 16 bits to the network portion and 16 bits to host addresses, supporting up to 65,534 usable hosts. A /24 subnet allocates 24 bits to the network portion and 8 bits to hosts, supporting up to 254 usable hosts."
          }
        },
        {
          "@type": "Question",
          "name": "How does Terraform cidrsubnet() calculate subnet ranges?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Terraform's cidrsubnet(prefix, newbits, netnum) function calculates a subnet address within a given IP network prefix. 'prefix' is the base CIDR, 'newbits' is the number of additional network bits to add, and 'netnum' is the zero-based index of the subnet to generate."
          }
        }
      ]
    }
  </script>
</Layout>

<style>
  .k8s-calc-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .k8s-inputs-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .k8s-diagnostics-col {
    display: flex;
    flex-direction: column;
  }

  .diagnostic-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .diag-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .diag-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .diag-badge {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .diag-badge.warning {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
  }

  .diag-metric-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(255,255,255,0.03);
  }

  .diag-metric-row strong {
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .diag-warning {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: var(--radius-sm);
    color: #fca5a5;
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .output-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .output-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .btn-copy {
    background: var(--accent-network);
    color: #0d111c;
    border: none;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .btn-copy:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .code-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--accent-highlight);
    overflow-x: auto;
    max-height: 380px;
    margin: 0;
  }

  @media (max-width: 900px) {
    .k8s-calc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupK8sArchitecture() {
    function calculateK8sArchitecture() {
      const nodeCount = parseInt((document.getElementById('k8s-nodes-count') as HTMLInputElement)?.value || '100', 10);
      const maxPodsPerNode = parseInt((document.getElementById('k8s-pods-per-node') as HTMLSelectElement)?.value || '110', 10);
      const cni = (document.getElementById('k8s-cni-type') as HTMLSelectElement)?.value || 'cilium';
      const podCidr = (document.getElementById('k8s-base-pod-cidr') as HTMLInputElement)?.value || '10.244.0.0/16';
      const svcCidr = (document.getElementById('k8s-service-cidr') as HTMLInputElement)?.value || '10.96.0.0/16';

      const podPrefix = parseInt(podCidr.split('/')[1] || '16', 10);
      const svcPrefix = parseInt(svcCidr.split('/')[1] || '16', 10);

      let nodeMask = 24;
      if (maxPodsPerNode <= 30) nodeMask = 26;
      else if (maxPodsPerNode <= 64) nodeMask = 25;
      else if (maxPodsPerNode <= 120) nodeMask = 24;
      else nodeMask = 23;

      const maxNodesCapacity = Math.pow(2, nodeMask - podPrefix);
      const totalPodCapacity = maxNodesCapacity * (Math.pow(2, 32 - nodeMask) - 2);
      const serviceIpsCapacity = Math.pow(2, 32 - svcPrefix) - 2;

      const [svcBase] = svcCidr.split('/');
      const svcParts = svcBase.split('.');
      const dnsIp = `${svcParts[0]}.${svcParts[1]}.${svcParts[2]}.10`;

      const diagNodeMask = document.getElementById('diag-node-mask');
      const diagMaxNodes = document.getElementById('diag-max-nodes');
      const diagTotalPods = document.getElementById('diag-total-pods');
      const diagServiceIps = document.getElementById('diag-service-ips');
      const diagDnsIp = document.getElementById('diag-dns-ip');
      const warningEl = document.getElementById('diag-exhaustion-warning');
      const badgeEl = document.getElementById('diag-status-badge');

      if (diagNodeMask) diagNodeMask.textContent = `/${nodeMask} (${Math.pow(2, 32 - nodeMask) - 2} Pod IPs per Node)`;
      if (diagMaxNodes) diagMaxNodes.textContent = `${maxNodesCapacity.toLocaleString()} Nodes`;
      if (diagTotalPods) diagTotalPods.textContent = `${totalPodCapacity.toLocaleString()} Pods`;
      if (diagServiceIps) diagServiceIps.textContent = `${serviceIpsCapacity.toLocaleString()} ClusterIPs`;
      if (diagDnsIp) diagDnsIp.textContent = dnsIp;

      const isExhausted = nodeCount > maxNodesCapacity;
      if (warningEl && badgeEl) {
        if (isExhausted) {
          warningEl.style.display = 'block';
          badgeEl.textContent = 'EXHAUSTION RISK';
          badgeEl.classList.add('warning');
        } else {
          warningEl.style.display = 'none';
          badgeEl.textContent = 'HEALTHY CAPACITY';
          badgeEl.classList.remove('warning');
        }
      }

      let manifest = '';
      if (cni === 'cilium') {
        manifest = `# Cilium Helm values.yaml
cluster:
  name: "production-cluster"
  id: 1
ipam:
  mode: "cluster-pool"
  operator:
    clusterPoolIPv4PodCIDRList: ["${podCidr}"]
    clusterPoolIPv4MaskSize: ${nodeMask}
k8sServiceHost: "127.0.0.1"
k8sServicePort: 6443
tunnel: "vxlan"
kubeProxyReplacement: "true"`;
      } else if (cni === 'calico') {
        manifest = `# Calico Installation Manifest (values.yaml)
kind: Installation
apiVersion: operator.tigera.io/v1
metadata:
  name: default
spec:
  calicoNetwork:
    ipPools:
      - blockSize: ${nodeMask}
        cidr: ${podCidr}
        encapsulation: VXLAN
        natOutgoing: Enabled
        nodeSelector: all()`;
      } else if (cni === 'awsvpc') {
        manifest = `# AWS EKS Terraform & VPC CNI Configuration
module "eks" {
  source          = "terraform-aws-modules/eks/aws"
  cluster_name    = "eks-prod"
  cluster_version = "1.31"
  vpc_id          = "vpc-0123456789"
  subnet_ids      = ["subnet-1", "subnet-2", "subnet-3"]

  cluster_service_ipv4_cidr = "${svcCidr}"
}

# AWS VPC CNI Prefix Delegation Add-on
resource "aws_eks_addon" "vpc_cni" {
  cluster_name = module.eks.cluster_name
  addon_name   = "vpc-cni"
  configuration_values = jsonencode({
    env = {
      ENABLE_PREFIX_DELEGATION = "true"
      WARM_PREFIX_TARGET       = "1"
    }
  })
}`;
      } else {
        manifest = `# Kubeadm ClusterConfiguration YAML
apiVersion: kubeadm.k8s.io/v1beta3
kind: ClusterConfiguration
kubernetesVersion: v1.31.0
networking:
  podSubnet: "${podCidr}"
  serviceSubnet: "${svcCidr}"
  dnsDomain: "cluster.local"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
maxPods: ${maxPodsPerNode}`;
      }

      const codeEl = document.getElementById('k8s-manifest-output');
      if (codeEl) codeEl.textContent = manifest;
    }

    ['k8s-nodes-count', 'k8s-pods-per-node', 'k8s-cni-type', 'k8s-base-pod-cidr', 'k8s-service-cidr'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.oninput = calculateK8sArchitecture;
        el.onchange = calculateK8sArchitecture;
      }
    });

    const copyBtn = document.getElementById('copy-k8s-btn');
    if (copyBtn) {
      copyBtn.onclick = () => {
        const code = document.getElementById('k8s-manifest-output')?.textContent || '';
        navigator.clipboard.writeText(code).then(() => {
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = 'Copy Manifest'; }, 2000);
        });
      };
    }

    calculateK8sArchitecture();
  }

  function setupCniSizing() {
    const cniSelect = document.getElementById('density-cni-type') as HTMLSelectElement;
    const cidrWrapper = document.getElementById('density-cidr-wrapper') as HTMLElement;
    const cidrSelect = document.getElementById('density-node-cidr') as HTMLSelectElement;
    const awsWrapper = document.getElementById('density-aws-wrapper') as HTMLElement;
    const awsInstanceSelect = document.getElementById('density-aws-instance') as HTMLSelectElement;
    const customAwsWrapper = document.getElementById('density-custom-aws-wrapper') as HTMLElement;
    const eniInput = document.getElementById('density-eni-count') as HTMLInputElement;
    const ipPerEniInput = document.getElementById('density-ip-per-eni') as HTMLInputElement;
    const kubeletLimitInput = document.getElementById('density-kubelet-limit') as HTMLInputElement;

    const outIpCap = document.getElementById('density-out-ip-cap');
    const outCniLimit = document.getElementById('density-out-cni-limit');
    const outKubeletLimit = document.getElementById('density-out-kubelet-limit');
    const outUsablePods = document.getElementById('density-out-usable-pods');
    const outStatus = document.getElementById('density-out-status');

    if (!cniSelect) return;

    const awsInstances: Record<string, { enis: number; ips: number }> = {
      't3.micro': { enis: 2, ips: 2 },
      't3.medium': { enis: 3, ips: 6 },
      'm5.large': { enis: 3, ips: 10 },
      'm5.xlarge': { enis: 4, ips: 15 },
      'm5.4xlarge': { enis: 8, ips: 30 },
      'custom': { enis: 3, ips: 6 }
    };

    function updateFieldsVisibility() {
      const cni = cniSelect.value;
      if (cni === 'awsvpc-std' || cni === 'awsvpc-prefix') {
        awsWrapper.style.display = 'block';
        cidrWrapper.style.display = 'none';
        const awsVal = awsInstanceSelect.value;
        if (awsVal === 'custom') {
          customAwsWrapper.style.display = 'flex';
        } else {
          customAwsWrapper.style.display = 'none';
          if (awsInstances[awsVal]) {
            eniInput.value = awsInstances[awsVal].enis.toString();
            ipPerEniInput.value = awsInstances[awsVal].ips.toString();
          }
        }
      } else {
        awsWrapper.style.display = 'none';
        customAwsWrapper.style.display = 'none';
        cidrWrapper.style.display = 'block';

        // Load correct prefix choices (IPv4 vs IPv6)
        let html = '';
        if (cni === 'cilium-v6') {
          html = `
            <option value="112" selected>/112 (65,536 IPs per Node)</option>
            <option value="116">/116 (4,096 IPs per Node)</option>
            <option value="120">/120 (256 IPs per Node)</option>
            <option value="124">/124 (16 IPs per Node)</option>
            <option value="128">/128 (1 IP per Node)</option>
          `;
        } else {
          html = `
            <option value="22">/22 (1,022 usable IPs)</option>
            <option value="23">/23 (510 usable IPs)</option>
            <option value="24" selected>/24 (254 usable IPs)</option>
            <option value="25">/25 (126 usable IPs)</option>
            <option value="26">/26 (62 usable IPs)</option>
            <option value="27">/27 (30 usable IPs)</option>
            <option value="28">/28 (14 usable IPs)</option>
          `;
        }
        cidrSelect.innerHTML = html;
      }
    }

    function calculate() {
      const cni = cniSelect.value;
      const kubeletLimit = parseInt(kubeletLimitInput.value || '110', 10);
      
      let ipCapacity = 0;
      let cniLimit = 0;
      let cniLabel = '';

      if (cni === 'awsvpc-std' || cni === 'awsvpc-prefix') {
        const enis = parseInt(eniInput.value || '0', 10);
        const ips = parseInt(ipPerEniInput.value || '0', 10);

        if (cni === 'awsvpc-std') {
          // Standard AWS VPC CNI: ENIs * (IPs - 1) + 2
          cniLimit = enis * (ips - 1) + 2;
          cniLabel = `AWS ENI standard mode limit`;
        } else {
          // Prefix delegation mode: ENIs * ((IPs - 1) * 16) + 2
          cniLimit = enis * ((ips - 1) * 16) + 2;
          cniLabel = `AWS ENI prefix mode limit`;
        }
        ipCapacity = cniLimit; // drawn from subnet
      } else {
        const prefix = parseInt(cidrSelect.value || '24', 10);
        if (cni === 'cilium-v6') {
          ipCapacity = Math.pow(2, 128 - prefix);
          cniLimit = ipCapacity;
          cniLabel = `IPv6 overlay size limit`;
        } else {
          // IPv4 Overlay
          ipCapacity = Math.max(0, Math.pow(2, 32 - prefix) - 2);
          cniLimit = ipCapacity;
          cniLabel = `IPv4 overlay size limit`;
        }
      }

      const usablePods = Math.min(ipCapacity, cniLimit, kubeletLimit);

      if (outIpCap) outIpCap.innerText = ipCapacity.toLocaleString() + ' IPs';
      if (outCniLimit) outCniLimit.innerText = cniLimit.toLocaleString() + ' Pods';
      if (outKubeletLimit) outKubeletLimit.innerText = kubeletLimit.toLocaleString() + ' Pods';
      if (outUsablePods) outUsablePods.innerText = usablePods.toLocaleString() + ' Pods per Node';

      if (outStatus) {
        if (usablePods < kubeletLimit) {
          outStatus.innerHTML = `<span style="color:var(--accent-danger, #f43f5e); font-weight:bold;">⚠️ Exceeded limits!</span> Pod capacity is restricted to <strong>${usablePods}</strong> by CNI/IP limits. Consider expanding the Node CIDR prefix size or upgrading instance type.`;
        } else if (ipCapacity > kubeletLimit * 4) {
          outStatus.innerHTML = `<span style="color:var(--accent-warning, #f59e0b); font-weight:bold;">💡 Oversized Subnet!</span> Subnet allocates <strong>${ipCapacity}</strong> IPs, but Kubelet limits pods to <strong>${kubeletLimit}</strong>. You are wasting IP addresses. Consider reducing the Node CIDR size.`;
        } else {
          outStatus.innerHTML = `<span style="color:var(--accent-network, #38bdf8); font-weight:bold;">✅ Optimal Sizing!</span> Node CIDR size matches Kubelet and CNI limits perfectly with minimal address waste.`;
        }
      }
    }

    cniSelect.onchange = () => {
      updateFieldsVisibility();
      calculate();
    };

    awsInstanceSelect.onchange = () => {
      updateFieldsVisibility();
      calculate();
    };

    [cidrSelect, eniInput, ipPerEniInput, kubeletLimitInput].forEach(el => {
      if (el) {
        el.oninput = calculate;
        el.onchange = calculate;
      }
    });

    updateFieldsVisibility();
    calculate();
  }

  function initCalculators() {
    setupK8sArchitecture();
    setupCniSizing();
  }

  document.addEventListener('astro:page-load', initCalculators);
  initCalculators();
</script>
