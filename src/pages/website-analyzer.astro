<script>
  // Dynamic Website Analysis logic

  // Define interfaces for analysis
  interface URLNode {
    [key: string]: any;
    _files?: string[];
  }

  interface URLData {
    url: string;
    normalized: string;
    path: string;
    category: string;
    depth: number;
    issues: string[];
  }

  function initWebsiteAnalyzer() {
    const inputArea = document.getElementById('analyzer-input') as HTMLTextAreaElement;
    const urlInput = document.getElementById('analyzer-url') as HTMLInputElement;
    const loadExampleBtn = document.getElementById('btn-load-example') as HTMLButtonElement;
    const runBtn = document.getElementById('btn-run-analysis') as HTMLButtonElement;
    const modeBtns = document.querySelectorAll('.mode-btn');
    const inputLabel = document.getElementById('input-label') as HTMLLabelElement;
    const textContainer = document.getElementById('text-input-container') as HTMLDivElement;
    const urlContainer = document.getElementById('url-input-container') as HTMLDivElement;

    const placeholder = document.getElementById('results-placeholder');
    const resultsContainer = document.getElementById('results-container');

    const totalLinksEl = document.getElementById('stat-total-links');
    const maxDepthEl = document.getElementById('stat-max-depth');
    const issuesCountEl = document.getElementById('stat-issues-count');
    const healthScoreEl = document.getElementById('stat-health-score');

    const distBar = document.getElementById('dist-bar');
    const distLegend = document.getElementById('dist-legend');
    const categoriesContainer = document.getElementById('categories-container');
    const auditContainer = document.getElementById('audit-issues-container');
    const treeContainer = document.getElementById('tree-container');

    let currentMode = 'sitemap';
    let analyzedData: URLData[] = [];
    let categories: Record<string, URLData[]> = {};
    let auditIssues: { type: 'critical' | 'warning' | 'info'; title: string; desc: string; rec: string; url?: string }[] = [];

    if (!inputArea || !runBtn) return;

    // Switch mode handlers
    modeBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        modeBtns.forEach(b => b.classList.remove('active'));
        const target = e.currentTarget as HTMLButtonElement;
        target.classList.add('active');
        currentMode = target.dataset.mode || 'sitemap';

        // Update labels and visibility
        if (currentMode === 'scan') {
          if (textContainer) textContainer.style.display = 'none';
          if (urlContainer) urlContainer.style.display = 'block';
          if (inputLabel) inputLabel.textContent = 'Enter Sitemap URL or Web Address';
        } else {
          if (textContainer) textContainer.style.display = 'block';
          if (urlContainer) urlContainer.style.display = 'none';
          if (inputLabel) {
            if (currentMode === 'sitemap') {
              inputLabel.textContent = 'Paste Sitemap XML';
              inputArea.placeholder = 'Paste your sitemap.xml content here...';
            } else if (currentMode === 'list') {
              inputLabel.textContent = 'Paste URL List (One per line)';
              inputArea.placeholder = 'https://example.com/page-1\nhttps://example.com/page-2\n/relative/path-3';
            } else {
              inputLabel.textContent = 'Paste Page HTML Source';
              inputArea.placeholder = 'Paste full HTML source <html>...</html> containing links...';
            }
          }
        }
      });
    });

    // Load example sitemap data
    if (loadExampleBtn) {
      loadExampleBtn.addEventListener('click', () => {
        if (currentMode === 'scan') {
          if (urlInput) urlInput.value = 'https://devsubnet.com/sitemap.xml';
        } else if (currentMode === 'sitemap') {
          inputArea.value = `<?xml version="1.0" encoding="UTF-8"?>
