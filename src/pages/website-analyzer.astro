---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
---

<Layout
  title="Website Sitemap & Structure Analyzer | DevSubnet"
  description="Free online website analyzer and sitemap segregator. Parse sitemaps, URL lists, or HTML to group links by category, check directory depth, run SEO diagnostics, and download reports."
>
  <div class="app-shell">
    <NavBar path="website-analyzer" />
    <main>
      <section class="intro" aria-labelledby="page-title">
        <div class="eyebrow">WEB UTILITIES / STRUCTURE &amp; OPTIMIZATION</div>
        <h1 id="page-title">Website Sitemap &amp; Structure Analyzer</h1>
        <p class="lede">Input a sitemap XML, HTML source, or list of URLs. Categorize your website's architecture, identify nesting depth, export sitemaps, and receive optimization recommendations instantly.</p>
      </section>

      <section aria-label="Website analyzer workspace">
        <div class="calculator-layout">
          <!-- Left Column: Inputs and Settings -->
          <div class="calculator-panel">
            <div class="panel-heading">
              <div>
                <span class="step">01</span>
                <h2>Select Input Mode</h2>
              </div>
              <span class="live-label">CLIENT-SIDE AUDIT</span>
            </div>

            <!-- Mode Switcher Tabs -->
            <div class="analyzer-modes">
              <button class="mode-btn active" data-mode="sitemap" type="button">Sitemap XML</button>
              <button class="mode-btn" data-mode="list" type="button">URL List</button>
              <button class="mode-btn" data-mode="html" type="button">HTML Source</button>
              <button class="mode-btn" data-mode="scan" type="button">Live Scan</button>
            </div>

            <!-- Input Container -->
            <div class="input-row">
              <label for="analyzer-input" id="input-label">Paste Sitemap XML</label>
              
              <!-- Textarea for paste modes -->
              <div id="text-input-container">
                <textarea 
                  id="analyzer-input" 
                  placeholder="Paste your sitemap.xml content here..." 
                  spellcheck="false"
                  rows="10"
                ></textarea>
              </div>

              <!-- URL input for scan mode -->
              <div id="url-input-container" style="display: none;">
                <div class="ip-input" style="width: 100%;">
                  <input 
                    type="url" 
                    id="analyzer-url" 
                    placeholder="https://example.com/sitemap.xml or https://example.com" 
                    autocomplete="off" 
                  />
                </div>
                <p class="input-tip">Fetches contents client-side via CORS proxy. Fallback to pasting if blocked by security policies.</p>
              </div>
            </div>

            <div class="quick-row">
              <button type="button" id="btn-load-example" class="subtool-btn">Load Demo Example</button>
              <button type="button" id="btn-run-analysis" class="subtool-btn action-highlight">Analyze Website</button>
            </div>

            <!-- Segregation Rules Info Card -->
            <div class="settings-card" style="margin-top: 1.5rem;">
              <h3>Categorical Segregation Rules</h3>
              <ul class="rules-list">
                <li><span class="badge blog-badge">Blog</span> <code>/blog</code>, <code>/post</code>, <code>/article</code>, <code>/news</code></li>
                <li><span class="badge product-badge">Product</span> <code>/product</code>, <code>/shop</code>, <code>/store</code>, <code>/item</code>, <code>/pricing</code></li>
                <li><span class="badge docs-badge">Docs</span> <code>/docs</code>, <code>/guide</code>, <code>/wiki</code>, <code>/help</code>, <code>/faq</code></li>
                <li><span class="badge legal-badge">Static</span> <code>/about</code>, <code>/contact</code>, <code>/privacy</code>, <code>/terms</code>, <code>/legal</code></li>
                <li><span class="badge asset-badge">Assets</span> Styles (CSS), Scripts (JS), Images, Fonts, PDFs</li>
                <li><span class="badge api-badge">API / Query</span> URLs matching <code>/api/</code> or containing query strings <code>?</code></li>
              </ul>
            </div>
          </div>

          <!-- Right Column: Interactive Dashboard & Results -->
          <div class="insight-panel">
            <!-- Placeholder before analysis -->
            <div class="calculator-panel placeholder-panel" id="results-placeholder">
              <div class="placeholder-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="48" height="48">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </div>
              <h3>Waiting for Analysis</h3>
              <p>Paste your sitemap or website content in the left panel and click <strong>Analyze Website</strong> to review categorical breakdown, folder depth, SEO optimization alerts, and download options.</p>
            </div>

            <!-- Analysis Results Dashboard -->
            <div class="calculator-panel" id="results-container" style="display: none; gap: 1.5rem;">
              <div>
                <span class="aside-kicker">WEBSITE STRUCTURE INSIGHTS</span>
                <h2>Analysis Dashboard</h2>
              </div>

              <!-- Summary KPIs -->
              <div class="stats-grid">
                <div class="stat-card">
                  <span class="stat-num" id="stat-total-links">0</span>
                  <span class="stat-label">Total URLs</span>
                </div>
                <div class="stat-card">
                  <span class="stat-num" id="stat-max-depth">0</span>
                  <span class="stat-label">Max Depth</span>
                </div>
                <div class="stat-card">
                  <span class="stat-num text-warning" id="stat-issues-count">0</span>
                  <span class="stat-label">Issues Flagged</span>
                </div>
                <div class="stat-card">
                  <span class="stat-num text-success" id="stat-health-score">100%</span>
                  <span class="stat-label">Health Score</span>
                </div>
              </div>

              <!-- Download Center -->
              <div class="download-panel">
                <h3>Export &amp; Download Results</h3>
                <div class="download-buttons">
                  <button type="button" class="dl-btn" data-format="json">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    Download JSON
                  </button>
                  <button type="button" class="dl-btn" data-format="csv">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    Download CSV
                  </button>
                  <button type="button" class="dl-btn" data-format="txt">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    URL List (.txt)
                  </button>
                </div>
              </div>

              <!-- Output Tabs -->
              <div class="export-panel" style="margin-top: 0.5rem;">
                <div class="export-tabs">
                  <button type="button" class="export-tab-btn active" data-tab="categories">Segregated Groups</button>
                  <button type="button" class="export-tab-btn" data-tab="optimizations">SEO &amp; Performance Audit</button>
                  <button type="button" class="export-tab-btn" data-tab="tree">Directory Tree</button>
                </div>

                <div class="tab-content" id="tab-categories">
                  <!-- Custom visual distribution bar -->
                  <div class="bar-chart-container">
                    <h4>Categorical URL Distribution</h4>
                    <div class="distribution-bar" id="dist-bar"></div>
                    <div class="distribution-legend" id="dist-legend"></div>
                  </div>

                  <!-- Categories accordion/list -->
                  <div class="categories-list" id="categories-container"></div>
                </div>

                <div class="tab-content" id="tab-optimizations" style="display: none;">
                  <div class="audit-summary">
                    <p class="aside-copy">Automated audit checking file types, URL structures, nesting directory depth, protocols, and security parameters.</p>
                  </div>
                  <div class="audit-issues" id="audit-issues-container"></div>
                </div>

                <div class="tab-content" id="tab-tree" style="display: none;">
                  <div class="tree-summary">
                    <p class="aside-copy">Collapsible visualization mapping of the website's directory structures.</p>
                  </div>
                  <div class="directory-tree-view" id="tree-container"></div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </section>

      <!-- Detailed Guide -->
      <section class="guide-section" style="margin-top: 4rem;">
        <div class="guide-sticky"><h2>Why analyze <em>site structure</em>?</h2></div>
        <div class="guide-content">
          <div class="guide-block">
            <h3>Categorical Segregation</h3>
            <p>Dividing a website's pages and assets into distinct logical categories (such as blogs, documentation, APIs, products, and legal) helps developers map routing configurations, understand cloud load balancing requirements, and organize sitemap indexes. Segregation also highlights which sections of your site consume the most network bandwidth or require stricter caching protocols.</p>
          </div>
          <div class="guide-block">
            <h3>SEO &amp; Crawl Budget Optimization</h3>
            <p>Search engines allocate a finite "crawl budget" to every domain. If your site has excessively deep directories (e.g., nested 5 or more levels deep), contains legacy uncompressed media, or suffers from inconsistent trailing slashes (which look like duplicate pages), search bots may fail to index important content. Resolving deep folder nesting and utilizing clean URLs are fundamental optimization steps.</p>
          </div>
          <div class="guide-block">
            <h3>DevOps &amp; Infrastructure Sizing</h3>
            <p>From an infrastructure perspective, knowing the volume and structure of static pages versus dynamic endpoints helps DevOps engineers correctly size subnets, set up appropriate Cloudflare CDN caching boundaries, and write redirect rules. Separating assets (like CSS, JS, images) from application routes allows for better target group segregation on cloud load balancers.</p>
          </div>
        </div>
      </section>

    </main>

    <footer>
      <span>DEVSUBNET.COM / ENGINEERED FOR CLEAR NETWORKS</span>
      <div class="footer-links">
        <a href="/about">About Us</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms</a>
        <a href="/faq">FAQ</a>
      </div>
      <span>NO DATA LEAVES YOUR DEVICE</span>
    </footer>
  </div>
</Layout>

<style>
  /* Custom Styles for Website Analyzer */
  .analyzer-modes {
    display: flex;
    gap: 0.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    padding: 0.25rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
  }

  .mode-btn {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .mode-btn:hover {
    color: var(--text-primary);
  }

  .mode-btn.active {
    background: rgba(var(--accent-network-rgb, 56, 189, 248), 0.12);
    color: var(--accent-network);
    font-weight: 600;
  }

  textarea#analyzer-input {
    width: 100%;
    background: var(--bg-code);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.4;
    resize: vertical;
    transition: border-color var(--transition-fast);
  }

  textarea#analyzer-input:focus {
    outline: none;
    border-color: var(--accent-network);
  }

  .input-tip {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
    line-height: 1.3;
  }

  .settings-card {
    background: var(--bg-surface-tint);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem;
  }

  .settings-card h3 {
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .rules-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .rules-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .rules-list code {
    font-size: 0.75rem;
    background: var(--bg-code);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--accent-highlight);
  }

  /* Badges for Categories */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    min-width: 65px;
    justify-content: center;
  }

  .blog-badge { background: rgba(52, 211, 153, 0.12); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.2); }
  .product-badge { background: rgba(251, 146, 60, 0.12); color: #fb923c; border: 1px solid rgba(251, 146, 60, 0.2); }
  .docs-badge { background: rgba(96, 165, 250, 0.12); color: #60a5fa; border: 1px solid rgba(96, 165, 250, 0.2); }
  .legal-badge { background: rgba(167, 139, 250, 0.12); color: #a78bfa; border: 1px solid rgba(167, 139, 250, 0.2); }
  .asset-badge { background: rgba(232, 121, 249, 0.12); color: #e879f9; border: 1px solid rgba(232, 121, 249, 0.2); }
  .api-badge { background: rgba(244, 63, 94, 0.12); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.2); }
  .general-badge { background: rgba(156, 163, 175, 0.12); color: #9ca3af; border: 1px solid rgba(156, 163, 175, 0.2); }

  /* Right column results styling */
  .placeholder-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    text-align: center;
    border: 1px dashed var(--border-color);
    background: rgba(255,255,255,0.01);
  }

  .placeholder-icon {
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    background: rgba(255,255,255,0.02);
    padding: 1rem;
    border-radius: 50%;
    border: 1px solid var(--border-color);
  }

  .placeholder-panel h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .placeholder-panel p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    max-width: 320px;
    line-height: 1.5;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 500px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .stat-num {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-primary);
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  .text-warning { color: #fb923c !important; }
  .text-success { color: #34d399 !important; }
  .text-danger { color: #f43f5e !important; }
  .text-info { color: #60a5fa !important; }

  /* Download Panel */
  .download-panel {
    background: var(--bg-surface-tint);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .download-panel h3 {
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .download-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .dl-btn {
    flex: 1;
    min-width: 130px;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.45rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    transition: all var(--transition-fast);
  }

  .dl-btn:hover {
    background: rgba(var(--accent-network-rgb, 56, 189, 248), 0.08);
    border-color: var(--accent-network);
    color: var(--accent-network);
  }

  /* Bar Chart */
  .bar-chart-container {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem;
    margin-bottom: 1.25rem;
  }

  .bar-chart-container h4 {
    font-size: 0.8rem;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-secondary);
  }

  .distribution-bar {
    height: 16px;
    width: 100%;
    border-radius: 8px;
    background: #1e293b;
    display: flex;
    overflow: hidden;
    margin-bottom: 1rem;
    border: 1px solid rgba(255,255,255,0.03);
  }

  .dist-segment {
    height: 100%;
    transition: width 0.3s ease;
  }

  .dist-blog { background-color: #34d399; }
  .dist-product { background-color: #fb923c; }
  .dist-docs { background-color: #60a5fa; }
  .dist-legal { background-color: #a78bfa; }
  .dist-asset { background-color: #e879f9; }
  .dist-api { background-color: #f43f5e; }
  .dist-general { background-color: #9ca3af; }

  .distribution-legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.5rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .legend-color {
    width: 8px;
    height: 8px;
    border-radius: 2px;
  }

  /* Categories Accordion */
  .categories-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cat-group {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .cat-header {
    width: 100%;
    background: transparent;
    border: none;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    text-align: left;
    transition: background-color var(--transition-fast);
  }

  .cat-header:hover {
    background: rgba(255, 255, 255, 0.01);
  }

  .cat-header-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.85rem;
  }

  .cat-header-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .cat-chevron {
    transition: transform var(--transition-fast);
  }

  .cat-group.open .cat-chevron {
    transform: rotate(180deg);
  }

  .cat-body {
    display: none;
    border-top: 1px solid var(--border-color);
    max-height: 250px;
    overflow-y: auto;
    background: rgba(0,0,0,0.1);
  }

  .cat-group.open .cat-body {
    display: block;
  }

  .url-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
    text-align: left;
  }

  .url-table th, .url-table td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  }

  .url-table th {
    font-weight: 600;
    color: var(--text-secondary);
    background: rgba(0,0,0,0.15);
  }

  .url-table td.url-cell {
    font-family: var(--font-mono);
    word-break: break-all;
    max-width: 250px;
    color: var(--text-primary);
  }

  .url-table tr:hover {
    background: rgba(255,255,255,0.02);
  }

  /* Diagnostics tab */
  .audit-issues {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 0.75rem;
  }

  .issue-card {
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    display: flex;
    gap: 0.75rem;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .issue-card.issue-critical {
    background: rgba(244, 63, 94, 0.06);
    border: 1px solid rgba(244, 63, 94, 0.2);
  }

  .issue-card.issue-warning {
    background: rgba(251, 146, 60, 0.06);
    border: 1px solid rgba(251, 146, 60, 0.2);
  }

  .issue-card.issue-info {
    background: rgba(96, 165, 250, 0.06);
    border: 1px solid rgba(96, 165, 250, 0.2);
  }

  .issue-icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .issue-critical .issue-icon { color: #f43f5e; }
  .issue-warning .issue-icon { color: #fb923c; }
  .issue-info .issue-icon { color: #60a5fa; }

  .issue-details h4 {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.15rem;
  }

  .issue-details p {
    color: var(--text-secondary);
    margin-bottom: 0.35rem;
  }

  .issue-details .issue-rec {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .issue-details .issue-url {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: rgba(0,0,0,0.25);
    padding: 0.15rem 0.35rem;
    border-radius: 3px;
    word-break: break-all;
    display: inline-block;
    margin-top: 0.25rem;
    color: var(--text-secondary);
  }

  /* Tree View */
  .directory-tree-view {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
