    font-size: 1.25rem;
    color: #34d399;
  }

  .takeaways-list {
    margin: 0;
    padding-left: 1.25rem;
  }

  .takeaways-list li {
    margin-bottom: 0.75rem;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--text-primary);
  }

  .takeaways-list li:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .article-layout {
      padding: 1.5rem 0.85rem 3.5rem 0.85rem;
    }
    .analogy-banner {
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.25rem 1rem;
    }
    .mac-split-diagram {
      grid-template-columns: 1fr;
    }
    .calc-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
