---
import Layout from '../layouts/Layout.astro';
import MainShell from '../components/MainShell.astro';
import { translations } from '../utils/i18n';

const t = translations.en;
---

<Layout
  title="Subnet Calculator for Business | DevSubnet"
  description="IP subnet planning for business professionals, team IP allocation, and cloud VPC resource planning. All calculations run locally in your browser."
>
  <MainShell activeTab="ipv4" defaultCloud="standard" lang="en">

    <!-- Business-focused features -->
    <section class="business-features" style="margin-top: 4rem; padding: 2rem; background: var(--card-bg, rgba(255, 255, 255, 0.03)); border-radius: var(--radius-md);">
      <h2 style="font-size: 1.3rem; margin-bottom: 1rem;">Business Use Cases</h2>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div>
          <h3>Team IP Address Planning</h3>
          <p>Calculate subnet requirements based on team size and expected growth. Plan IP allocations for departments, offices, and remote workers.</p>
        </div>
        <div>
          <h3>Cloud VPC Resource Planning</h3>
          <p>Account for cloud provider reserved IPs (AWS: 5 IPs, Azure: 5 IPs, GCP: 4 IPs). Generate accurate subnet plans for multi-region cloud architecture.</p>
        </div>
        <div>
          <h3>Terraform IaC Generation</h3>
          <p>Generate reusable Terraform cidrsubnet() code snippets for automated infrastructure deployment. Prevent IP collision bugs in multi-AZ VPC setups.</p>
        </div>
        <div>
          <h3>Shareable Network Diagrams</h3>
          <p>Create shareable URL links for subnet configurations to distribute to team members and stakeholders. Instant export for documentation.</p>
        </div>
      </div>
    </section>

    <div class="page-cta" style="margin-top: 3rem;">
      <a href="/" class="btn-return">← Start Subnet Calculation</a>
    </div>
  </MainShell>
</Layout>

<style>
  .business-features details {
    margin-bottom: 0.5rem;
  }

  .business-features summary {
    font-weight: 600;
    cursor: pointer;
    padding: 0.5rem 0;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
  }

  .business-features summary:hover {
    background: rgba(var(--accent-network-rgb, 56, 189, 248), 0.1);
  }
</style>