</style>

<script is:inline>


  function setupNavBar() {
    const themeBtn = document.getElementById("theme-btn");
    if (themeBtn) {
      themeBtn.onclick = function () {
        const doc = document.documentElement;
        const currentTheme = doc.getAttribute("data-theme");
        const targetTheme = currentTheme === "light" ? "dark" : "light";
        doc.setAttribute("data-theme", targetTheme);
        localStorage.setItem("devsubnet-theme", targetTheme);
      };
    }



    const moreBtn = document.querySelector(".nav-more-btn");
    const moreWrap = document.querySelector(".nav-more");

    if (moreBtn && moreWrap) {
      moreBtn.onclick = function (e) {
        e.stopPropagation();
        const isOpen = moreWrap.classList.toggle("open");
        moreBtn.setAttribute("aria-expanded", String(isOpen));
        const langP = document.querySelector(".lang-picker");
        if (langP) langP.classList.remove("open");
      };
    }

    const langBtn = document.querySelector(".lang-btn");
    const langPicker = document.querySelector(".lang-picker");

    if (langBtn && langPicker) {
      langBtn.onclick = function (e) {
        e.stopPropagation();
        const isOpen = langPicker.classList.toggle("open");
        langBtn.setAttribute("aria-expanded", String(isOpen));
        const moreW = document.querySelector(".nav-more");
        if (moreW) moreW.classList.remove("open");
      };
    }

    const devopsBtn = document.getElementById("btn-mode-devops");
    const studentBtn = document.getElementById("btn-mode-student");

    function setPersonaMode(mode, save = true) {
      const dBtn = document.getElementById("btn-mode-devops");
      const sBtn = document.getElementById("btn-mode-student");
      const dGrp = document.getElementById("nav-group-devops");
      const sGrp = document.getElementById("nav-group-student");

      if (mode === "student") {
        if (sBtn) {
          sBtn.classList.add("active");
          sBtn.setAttribute("aria-checked", "true");
        }
        if (dBtn) {
          dBtn.classList.remove("active");
          dBtn.setAttribute("aria-checked", "false");
        }
        if (sGrp) sGrp.style.display = "flex";
        if (dGrp) dGrp.style.display = "none";
      } else {
        if (dBtn) {
          dBtn.classList.add("active");
          dBtn.setAttribute("aria-checked", "true");
        }
        if (sBtn) {
          sBtn.classList.remove("active");
          sBtn.setAttribute("aria-checked", "false");
        }
        if (dGrp) dGrp.style.display = "flex";
        if (sGrp) sGrp.style.display = "none";
      }

      if (save) {
        try {
          localStorage.setItem("devsubnet-persona-mode", mode);
        } catch (e) {}
      }
    }

    if (devopsBtn) {
      devopsBtn.onclick = function () {
        setPersonaMode("devops", true);
      };
    }
    if (studentBtn) {
      studentBtn.onclick = function () {
        setPersonaMode("student", true);
      };
    }

    // Restore saved persona mode or default by route
    try {
      const savedMode = localStorage.getItem("devsubnet-persona-mode");
      const path = window.location.pathname;
      const isStudentPath =
        path.includes("/learn") ||
        path.includes("/what-is-a-subnet") ||
        path.includes("/cheat-sheet") ||
        path.includes("/student-guide");

      if (savedMode) {
        setPersonaMode(savedMode, false);
      } else if (isStudentPath) {
        setPersonaMode("student", false);
      } else {
        setPersonaMode("devops", false);
      }
    } catch (e) {}
  }

  // Global keyboard shortcuts: 'Escape' to close menus
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
      const moreWrap = document.querySelector(".nav-more");
      const moreBtn = document.querySelector(".nav-more-btn");
      const langPicker = document.querySelector(".lang-picker");
      const langBtn = document.querySelector(".lang-btn");
      if (moreWrap) {
        moreWrap.classList.remove("open");
        if (moreBtn) moreBtn.setAttribute("aria-expanded", "false");
      }
      if (langPicker) {
        langPicker.classList.remove("open");
        if (langBtn) langBtn.setAttribute("aria-expanded", "false");
      }
    }
  });

  document.addEventListener("click", function (e) {
    const moreWrap = document.querySelector(".nav-more");
    const moreBtn = document.querySelector(".nav-more-btn");
    const langPicker = document.querySelector(".lang-picker");
    const langBtn = document.querySelector(".lang-btn");

    if (moreWrap && moreBtn && !moreWrap.contains(e.target)) {
      moreWrap.classList.remove("open");
      moreBtn.setAttribute("aria-expanded", "false");
    }
    if (langPicker && langBtn && !langPicker.contains(e.target)) {
      langPicker.classList.remove("open");
      langBtn.setAttribute("aria-expanded", "false");
    }
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupNavBar);
  } else {
    setupNavBar();
  }
  document.addEventListener("astro:page-load", setupNavBar);
</script>
