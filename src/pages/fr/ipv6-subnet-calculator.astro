---import { type SupportedLanguage } from '../../utils/i18n';

import Layout from '../../layouts/Layout.astro';
import MainShell from '../../components/MainShell.astro';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout 
  lang={lang}
  title="Calculateur de sous-réseau IPv6 et délégation de préfixe | DevSubnet"
  description="Compressez, développez les adresses IPv6 et calculez des sous-réseaux avec délégation de préfixe (/48, /56, /64) instantanément."
>
  <MainShell activeTab="ipv6" navPath="ipv6-subnet-calculator" lang={lang} />
</Layout>
