---
import {
  languages,
  translations,
  getLocalizedPath,
  type SupportedLanguage,
} from "../utils/i18n";

interface Props {
  path?: string;
  lang?: SupportedLanguage;
}

const { path = "", lang = "en" } = Astro.props;

const t = translations[lang] || translations.en;
const currentLangInfo = languages[lang] || languages.en;
const langPrefix = lang === "en" ? "" : `/${lang}`;

const catNames: Record<SupportedLanguage, { core: string; cloud: string; knowledge: string; devops: string; student: string; exploreHub: string }> = {
  en: { core: "Core Calculators", cloud: "Cloud VPC & DevOps", knowledge: "Knowledge & Guides", devops: "DevOps", student: "Student", exploreHub: "Explore Knowledge Hub" },
  de: { core: "Kern-Rechner", cloud: "Cloud VPC & DevOps", knowledge: "Wissen & Anleitungen", devops: "DevOps", student: "Studenten", exploreHub: "Wissens-Hub erkunden" },
  es: { core: "Calculadoras Principales", cloud: "Cloud VPC y DevOps", knowledge: "Conocimiento y Guías", devops: "DevOps", student: "Estudiantes", exploreHub: "Explorar Centro de Conocimiento" },
  ja: { core: "基本計算ツール", cloud: "クラウドVPC & DevOps", knowledge: "知識 & ガイド", devops: "DevOps", student: "学習者", exploreHub: "ナレッジハブを見る" },
  fr: { core: "Calculateurs Principaux", cloud: "Cloud VPC & DevOps", knowledge: "Connaissances & Guides", devops: "DevOps", student: "Étudiants", exploreHub: "Explorer le Centre de Savoir" },
  pt: { core: "Calculadoras Principais", cloud: "Cloud VPC e DevOps", knowledge: "Conhecimento e Guias", devops: "DevOps", student: "Estudantes", exploreHub: "Explorar Central de Conhecimento" },
  ko: { core: "핵심 계산기", cloud: "클라우드 VPC 및 DevOps", knowledge: "지식 및 가이드", devops: "DevOps", student: "학생", exploreHub: "지식 허브 탐색" },
  it: { core: "Calcolatori Principali", cloud: "Cloud VPC e DevOps", knowledge: "Conoscenza e Guide", devops: "DevOps", student: "Studenti", exploreHub: "Esplora Centro di Conoscenza" },
};

const whatIsSubnetTranslations: Record<SupportedLanguage, string> = {
  en: "What is a Subnet?",
  de: "Was ist ein Subnetz?",
  es: "¿Qué es una subred?",
  ja: "サブネットとは？",
  fr: "Qu'est-ce qu'un sous-réseau ?",
  pt: "O que é uma sub-rede?",
  ko: "서브넷이란?",
  it: "Cos'è una subnet?"
};

const knowledgeHubTranslations: Record<SupportedLanguage, string> = {
  en: "Knowledge Hub",
  de: "Wissens-Hub",
  es: "Centro de Conocimiento",
  ja: "ナレッジハブ",
  fr: "Centre de Savoir",
  pt: "Central de Conhecimento",
  ko: "지식 허브",
  it: "Centro di Conoscenza"
};

const studentGuideTranslations: Record<SupportedLanguage, string> = {
  en: "Student Exam Guide",
  de: "Prüfungsleitfaden",
  es: "Guía de Examen",
  ja: "試験対策ガイド",
  fr: "Guide d'examen",
  pt: "Guia de Exame",
  ko: "시험 대비 가이드",
  it: "Guida all'esame"
};

const devopsLinks = [
  { href: `${langPrefix}/` || "/", label: `⚡ ${t.nav.ipv4}`, key: "ipv4" },
  {
    href: `${langPrefix}/kubernetes-subnet-planner`,
    label: `☸️ ${t.nav.k8s}`,
    key: "k8s",
  },
  {
    href: `${langPrefix}/terraform-subnet-planner`,
    label: `📜 ${t.nav.terraform}`,
    key: "terraform",
  },
  { href: `${langPrefix}/aws-vpc-subnet-calculator`, label: `☁️ ${t.nav.aws}`, key: "aws" },
];

const studentLinks = [
  { href: `${langPrefix}/learn`, label: `📚 ${knowledgeHubTranslations[lang] || "Knowledge Hub"}`, key: "learn", badge: "Daily" },
  {
    href: `${langPrefix}/visual-subnet-splitter`,
    label: `🔀 ${t.nav.splitter}`,
    key: "splitter",
  },
  {
    href: `${langPrefix}/what-is-a-subnet`,
    label: `💡 ${whatIsSubnetTranslations[lang] || "What is a Subnet?"}`,
    key: "what-is-a-subnet",
  },
  {
    href: `${langPrefix}/cidr-cheat-sheet`,
    label: `📋 ${t.nav.cheatsheet}`,
    key: "subnet-cheat-sheet",
  },
];

const toolCategories = [
  {
    name: catNames[lang]?.core || "Core Calculators",
    icon: "🧮",
    color: "#38bdf8",
    tools: [
      {
        href: `${langPrefix}/` || "/",
        label: t.nav.ipv4 || "IPv4 Subnet Calculator",
        desc: "Instant bitwise network & host solver",
        tag: "Core",
        key: "ipv4",
      },
      {
        href: `${langPrefix}/visual-subnet-splitter`,
        label: t.nav.splitter || "Visual Subnet Splitter",
        desc: "Interactive drag & split tree",
        tag: "Visual",
        key: "splitter",
      },
      {
        href: `${langPrefix}/vlsm-calculator`,
        label: t.nav.vlsm || "VLSM Calculator",
        desc: "Variable length subnet mask planning",
        tag: "VLSM",
        key: "vlsm",
      },
      {
        href: `${langPrefix}/ipv6-subnet-calculator`,
        label: t.nav.ipv6 || "IPv6 Calculator",
        desc: "128-bit hex & prefix explorer",
        tag: "IPv6",
        key: "ipv6",
      },
      {
        href: `${langPrefix}/subnet-overlap-checker`,
        label: t.nav.overlap || "Overlap Checker",
        desc: "Audit colliding network blocks",
        tag: "Audit",
        key: "overlap",
      },
      {
        href: `${langPrefix}/cidr-supernet-calculator`,
        label: t.nav.supernet || "CIDR Supernetting",
        desc: "Route summarization solver",
        tag: "CIDR",
        key: "supernet",
      },
    ],
  },
  {
    name: catNames[lang]?.cloud || "Cloud VPC & DevOps",
    icon: "☁️",
    color: "#a855f7",
    tools: [
      {
        href: `${langPrefix}/kubernetes-subnet-planner`,
        label: t.nav.k8s || "Kubernetes Planner",
        desc: "Node, Pod & Service CIDR sizing",
        tag: "K8s",
        key: "k8s",
      },
      {
        href: `${langPrefix}/terraform-subnet-planner`,
        label: t.nav.terraform || "Terraform Planner",
        desc: "Auto cidrsubnet() HCL generator",
        tag: "IaC",
        key: "terraform",
      },
      {
        href: `${langPrefix}/aws-vpc-subnet-calculator`,
        label: t.nav.aws || "AWS VPC Calculator",
        desc: "Multi-AZ with 5 reserved IPs",
        tag: "AWS",
        key: "aws",
      },
      {
        href: `${langPrefix}/azure-vnet-subnet-calculator`,
        label: t.nav.azure || "Azure VNet Calculator",
        desc: "GatewaySubnet & 5 reserved IPs",
        tag: "Azure",
        key: "azure",
      },
      {
        href: `${langPrefix}/gcp-vpc-subnet-calculator`,
        label: t.nav.gcp || "GCP VPC Calculator",
        desc: "Regional CIDRs with 4 reserved IPs",
        tag: "GCP",
        key: "gcp",
      },
    ],
  },
  {
    name: catNames[lang]?.knowledge || "Knowledge & Guides",
    icon: "📚",
    color: "#10b981",
    tools: [
      {
        href: `${langPrefix}/learn`,
        label: knowledgeHubTranslations[lang] || "Knowledge Hub",
        desc: "Daily student networking articles",
        tag: "Daily New",
        key: "learn",
        highlight: true,
      },
      {
        href: `${langPrefix}/what-is-a-subnet`,
        label: whatIsSubnetTranslations[lang] || "What is a Subnet?",
        desc: "Beginner network & mask primer",
        tag: "Primer",
        key: "what-is-a-subnet",
      },
      {
        href: `${langPrefix}/cidr-cheat-sheet`,
        label: t.nav.cheatsheet || "Subnet Cheat Sheet",
        desc: "/1 to /32 quick lookup table",
        tag: "Quick Ref",
        key: "subnet-cheat-sheet",
      },
      {
        href: `${langPrefix}/student-guide`,
        label: studentGuideTranslations[lang] || "Student Exam Guide",
        desc: "CCNA formulas & exam shortcuts",
        tag: "Guide",
        key: "student-guide",
      },
      {
        href: `${langPrefix}/website-analyzer`,
        label: "Website Analyzer",
        desc: "DNS, TLS & network diagnostics",
        tag: "Diagnostic",
        key: "website-analyzer",
      },
    ],
  },
];

// Flat list for active state checks
const allTools = toolCategories.flatMap((c) => c.tools);

// Resolve the current path to a key for active-state highlighting
const nonDefaultLangs = Object.keys(languages).filter((l) => l !== "en");
const pathKey =
  path.split("/").filter((p) => !nonDefaultLangs.includes(p))[0] || "ipv4";
function isActive(item: { href: string; key: string }): boolean {
  if (pathKey === "ipv4" || pathKey === "") return item.key === "ipv4";
  return item.key === pathKey;
}

const currentPathname = Astro.url.pathname;
const availableLangs = Object.keys(languages) as SupportedLanguage[];
---

<header class="topbar">
  <div class="topbar-row">
    <a class="brand" href={langPrefix || "/"} aria-label="DevSubnet.com home">
      <span class="brand-badge">
        <svg
          class="brand-navicon"
          viewBox="0 0 512 512"
          width="18"
          height="18"
          aria-hidden="true"
        >
          <circle cx="256" cy="140" r="40" fill="#ffffff"></circle>
          <path
            d="M256 180 v70 M150 290 h212 M150 250 v40 M362 250 v40 M150 290 v60 M362 290 v60"
            fill="none"
            stroke="#ffffff"
            stroke-width="32"
            stroke-linecap="round"></path>
          <circle cx="150" cy="370" r="32" fill="#ffffff"></circle>
          <circle cx="362" cy="370" r="32" fill="#ffffff"></circle>
          <path
            d="M280 190 l-48 80"
            stroke="#ffffff"
            stroke-width="36"
            stroke-linecap="round"></path>
        </svg>
        Dev
      </span>
      <span class="brand-text">Subnet.com</span>
    </a>

    <nav class="nav-links" aria-label="Primary navigation">
      <!-- Persona Mode Switcher: 🛠️ DevOps vs 🎓 Student -->
      <div
        class="persona-switch"
        role="radiogroup"
        aria-label="Navigation Mode Filter"
      >
        <button
          type="button"
          class="persona-btn active"
          id="btn-mode-devops"
          data-mode="devops"
          role="radio"
          aria-checked="true"
          title="Switch to DevOps & Cloud Architecture tabs"
        >
          <span class="persona-icon">🛠️</span>
          <span class="persona-text">{catNames[lang]?.devops || "DevOps"}</span>
        </button>
        <button
          type="button"
          class="persona-btn"
          id="btn-mode-student"
          data-mode="student"
          role="radio"
          aria-checked="false"
          title="Switch to Student & Learning Curriculum tabs"
        >
          <span class="persona-icon">🎓</span>
          <span class="persona-text">{catNames[lang]?.student || "Student"}</span>
        </button>
      </div>

      <!-- DevOps Tab Group -->
      <div class="nav-tab-group nav-group-devops" id="nav-group-devops">
        {
          devopsLinks.map((link) => (
            <a
              class={`nav-tab ${isActive(link) ? "active" : ""}`}
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- Student Tab Group -->
      <div
        class="nav-tab-group nav-group-student"
        id="nav-group-student"
        style="display: none;"
      >
        {
          studentLinks.map((link) => (
            <a
              class={`nav-tab ${isActive(link) ? "active" : ""}`}
              href={link.href}
            >
              {link.label}
              {link.badge && <span class="tab-pill-badge">{link.badge}</span>}
            </a>
          ))
        }
      </div>

      <!-- Categorized Mega-Menu Dropdown -->
      <div class="nav-more">
        <button
          class="nav-tab nav-more-btn"
          type="button"
          aria-label="Explore all subnetting tools and knowledge hub"
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span class="nav-more-icon">❖</span>
          <span>{t.nav.moreTools}</span>
          <span class="nav-count-badge">15+</span>
          <svg
            class="nav-more-caret"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><polyline points="6 9 12 15 18 9"></polyline></svg
          >
        </button>

        <div
          class="mega-menu-panel"
          role="menu"
          aria-label="Tools and Guides Directory"
        >
          <div class="mega-menu-grid">
            {
              toolCategories.map((cat) => (
                <div class="mega-col">
                  <div class="mega-col-header">
                    <span class="mega-col-icon">{cat.icon}</span>
                    <h3 class="mega-col-title">{cat.name}</h3>
                  </div>
                  <div class="mega-col-links">
                    {cat.tools.map((tool) => (
                      <a
                        class={`mega-item ${isActive(tool) ? "active" : ""} ${tool.highlight ? "item-highlight" : ""}`}
                        href={tool.href}
                        role="menuitem"
                      >
                        <div class="mega-item-main">
                          <div class="mega-item-top">
                            <span class="mega-item-label">{tool.label}</span>
                            <span
                              class={`mega-tag mega-tag-${tool.tag.toLowerCase().replace(/[^a-z0-9]/g, "-")}`}
                            >
                              {tool.tag}
                            </span>
                          </div>
                          <p class="mega-item-desc">{tool.desc}</p>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>

          <!-- Bottom Footer Bar -->
          <div class="mega-menu-footer">
            <div class="mega-footer-tip">
              <span class="mega-tip-icon">💡</span>
              <span
                ><strong>Pro Tip:</strong> Press <kbd class="footer-kbd"
                  >Esc</kbd
                > anywhere to quickly close navigation menus.</span
              >
            </div>
            <a href={`${langPrefix}/learn`} class="mega-footer-link">
              {catNames[lang]?.exploreHub || "Explore Knowledge Hub"} <span class="arrow">→</span>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <div class="nav-actions">

      <!-- Language Switcher Dropdown -->
      <div class="lang-picker">
        <button
          class="lang-btn"
          type="button"
          aria-label="Toggle language settings dropdown"
          aria-haspopup="true"
          aria-expanded="false"
          title="Change Language / Sprache / Idioma / 言語"
        >
          <span class="lang-flag">{currentLangInfo.flag}</span>
          <span class="lang-code">{currentLangInfo.code.toUpperCase()}</span>
          <svg
            class="nav-more-caret"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><polyline points="6 9 12 15 18 9"></polyline></svg
          >
        </button>
        <div class="lang-menu">
          {
            availableLangs.map((l) => (
              <a
                class={`lang-item ${l === lang ? "active" : ""}`}
                href={getLocalizedPath(currentPathname, l)}
                hreflang={l}
              >
                <span class="lang-flag">{languages[l].flag}</span>
                <span class="lang-name">{languages[l].nativeName}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Theme Switcher -->
      <button
        class="theme-toggle"
        id="theme-btn"
        aria-label="Toggle visual theme"
        type="button"
      >
        <svg
          class="sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg
          class="moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .lang-picker {
    position: relative;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.38rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lang-btn:hover {
    color: var(--text-primary);
    border-color: var(--accent-network);
  }

  .lang-flag {
    font-size: 0.95rem;
    line-height: 1;
  }

  .lang-code {
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    min-width: 140px;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.35rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    display: none;
    flex-direction: column;
    gap: 0.2rem;
    z-index: 100;
    backdrop-filter: blur(12px);
  }

  .lang-picker.open .lang-menu {
    display: flex;
  }

  .lang-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.65rem;
    font-size: 0.82rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .lang-item:hover,
  .lang-item.active {
    background: rgba(var(--accent-network-rgb, 56, 189, 248), 0.12);
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Mega Menu Header Badge & Icon */
  .nav-more-icon {
    font-size: 0.9rem;
    color: var(--accent-network);
  }

  .nav-count-badge {
    background: linear-gradient(
      135deg,
      rgba(56, 189, 248, 0.2),
      rgba(168, 85, 247, 0.2)
    );
    border: 1px solid rgba(168, 85, 247, 0.35);
    color: #c084fc;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.1rem 0.38rem;
    border-radius: var(--radius-full);
    line-height: 1;
  }

  /* Mega Menu Flyout Panel */
  .mega-menu-panel {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: 780px;
    max-width: calc(100vw - 2rem);
    background: rgba(13, 18, 30, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.6),
      0 0 1px rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(28px) saturate(190%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.99);
    transition:
      opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.22s;
    z-index: 1000;
    overflow: hidden;
  }

  :root[data-theme="light"] .mega-menu-panel {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(0, 0, 0, 0.1);
    box-shadow:
      0 24px 60px rgba(15, 23, 42, 0.18),
      0 0 1px rgba(0, 0, 0, 0.08);
  }

  .nav-more.open .mega-menu-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .mega-menu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 1.5rem;
  }

  .mega-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mega-col-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 0.25rem;
  }

  .mega-col-icon {
    font-size: 1.15rem;
  }

  .mega-col-title {
    margin: 0;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: var(--text-muted);
  }

  .mega-col-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .mega-item {
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .mega-item:hover {
    background: rgba(99, 102, 241, 0.08);
    border-color: rgba(99, 102, 241, 0.2);
    transform: translateX(2px);
  }

  .mega-item.active {
    background: rgba(56, 189, 248, 0.1);
    border-color: rgba(56, 189, 248, 0.3);
  }

  .mega-item.item-highlight {
    background: linear-gradient(
      135deg,
      rgba(16, 185, 129, 0.08) 0%,
      rgba(56, 189, 248, 0.08) 100%
    );
    border-color: rgba(16, 185, 129, 0.3);
  }

  .mega-item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .mega-item-label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--text-primary);
  }

  .mega-tag {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.12rem 0.4rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.02em;
