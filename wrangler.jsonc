{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devsubnet-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    "devsubnet.com/*",
    "www.devsubnet.com/*"
  ]
}
