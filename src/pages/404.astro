---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import { type SupportedLanguage } from '../utils/i18n';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';

const quickTools = [
  { name: 'IPv4 Subnet Calculator', href: '/', icon: '⚡', desc: 'Instant bitwise network solver' },
  { name: 'Visual Subnet Splitter', href: '/visual-subnet-splitter', icon: '🔀', desc: 'Interactive drag & partition tree' },
  { name: 'Kubernetes CIDR Planner', href: '/kubernetes-subnet-planner', icon: '☸️', desc: 'Pod, Service & Node IP sizing' },
  { name: 'Terraform cidrsubnet()', href: '/terraform-subnet-planner', icon: '📜', desc: 'HCL code generator & math' },
  { name: 'CIDR Cheat Sheet', href: '/subnet-cheat-sheet', icon: '📋', desc: 'Complete /0 to /32 reference' },
  { name: 'VLSM Calculator', href: '/vlsm-calculator', icon: '📊', desc: 'Variable length subnet allocator' }
];
---

<Layout 
  lang={lang} 
  noindex={true}
  title="404 – CIDR Block Not Found | DevSubnet"
  description="The requested routing prefix or page could not be found. Jump back to DevSubnet's free IP subnet calculators, CIDR planner, and cloud VPC tools."
>
  <div class="app-shell">
    <NavBar lang={lang} path="error" />

    <main class="error-main">
      <div class="error-container">
        <!-- Diagnostic Status Pill -->
        <div class="status-badge" role="status">
          <span class="pulse-dot"></span>
          <span class="badge-code">ERR_404_ROUTE_NOT_FOUND</span>
        </div>

        <h1 class="error-title">
          <span class="code-number">404</span>
          <span class="title-text">CIDR Block Not Found</span>
        </h1>

        <p class="error-description">
          The requested path could not be resolved by our routing table. The endpoint might have been moved, decommissioned, or mistyped in the address bar.
        </p>

        <!-- Network Diagram Visual Simulation -->
        <div class="network-diagram-card" aria-hidden="true">
          <div class="topology-wrapper">
            <div class="net-node gateway">
              <span class="node-icon">🌐</span>
              <span class="node-label">Gateway</span>
            </div>
            <div class="net-line broken-line">
              <span class="packet drop-packet">✕</span>
            </div>
            <div class="net-node destination unreachable">
              <span class="node-icon">❓</span>
              <span class="node-label">Destination</span>
            </div>
          </div>
          <div class="topology-log">
            <code>&gt; traceroute /requested-route: * * * Request timed out [Destination Prefix Unreachable]</code>
          </div>
        </div>

        <!-- Quick Recovery Actions -->
        <div class="action-buttons">
          <a href="/" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Return to Calculator
          </a>
          <button type="button" id="back-btn" class="btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            Go Back
          </button>
        </div>

        <!-- Quick Jump Calculator Directory -->
        <section class="quick-jump-section" aria-label="Available Networking Tools">
          <h2 class="section-heading">Looking for one of our subnet tools?</h2>
          <div class="tool-grid">
            {quickTools.map((tool) => (
              <a href={tool.href} class="tool-card">
                <span class="tool-icon">{tool.icon}</span>
                <div class="tool-info">
                  <span class="tool-name">{tool.name}</span>
                  <span class="tool-desc">{tool.desc}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      </div>
    </main>

    <Footer lang={lang} />
  </div>
</Layout>

<style>
  .error-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3.5rem 1.5rem 5rem;
    min-height: calc(100vh - 180px);
  }

  .error-container {
    max-width: 48rem;
    width: 100%;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Diagnostic Badge */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(239, 68, 68, 0.1);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.25);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: pulseGlow 1.8s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* Error Heading */
  .error-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .code-number {
    font-family: var(--font-mono);
    font-size: clamp(3.5rem, 9vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    background: linear-gradient(135deg, #f87171 0%, #a855f7 50%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .title-text {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .error-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 34rem;
    margin: 0 0 2.5rem;
  }

  /* Network Simulation Card */
  .network-diagram-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem 2rem;
    width: 100%;
    max-width: 36rem;
    margin-bottom: 2.5rem;
    backdrop-filter: blur(var(--glass-blur));
    box-shadow: var(--shadow-md);
  }

  .topology-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    position: relative;
  }

  .net-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    z-index: 2;
  }

  .node-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
  }

  .node-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .net-node.destination.unreachable .node-icon {
    border-color: rgba(239, 68, 68, 0.5);
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
  }

  .net-line {
    flex: 1;
    height: 2px;
    margin: 0 1rem;
    position: relative;
    background: repeating-linear-gradient(
      90deg,
      rgba(239, 68, 68, 0.3),
      rgba(239, 68, 68, 0.3) 6px,
      transparent 6px,
      transparent 12px
    );
  }

  .packet {
    position: absolute;
    top: 50%;
    left: 45%;
    transform: translate(-50%, -50%);
    font-size: 0.85rem;
    font-weight: bold;
    color: #ef4444;
    background: var(--bg-primary);
    width: 22px;
    height: 22px;
    border-radius: var(--radius-full);
    border: 1px solid #ef4444;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.4);
    animation: dropShake 2s infinite ease-in-out;
  }

  @keyframes dropShake {
    0%, 100% { transform: translate(-50%, -50%) rotate(0deg); }
    20% { transform: translate(-50%, -50%) rotate(-12deg); }
    40% { transform: translate(-50%, -50%) rotate(12deg); }
  }

  .topology-log {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
    text-align: left;
    overflow-x: auto;
  }

  .topology-log code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #f87171;
  }

  /* Actions */
  .action-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
    color: #ffffff;
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.8rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .btn-secondary:hover {
    background: var(--bg-secondary);
    border-color: rgba(161, 66, 244, 0.4);
  }

  /* Quick Jump Section */
  .quick-jump-section {
    width: 100%;
    text-align: left;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    width: 100%;
  }

  .tool-card {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1rem 1.15rem;
    text-decoration: none;
    transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .tool-card:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.4);
    background: var(--panel-bg);
  }

  .tool-icon {
    font-size: 1.4rem;
    line-height: 1;
    margin-top: 0.1rem;
  }

  .tool-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tool-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .tool-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .topology-log {
      display: none;
    }
  }
</style>

<script>
  const backBtn = document.getElementById('back-btn');
  if (backBtn) {
    backBtn.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/';
      }
    });
  }
</script>
