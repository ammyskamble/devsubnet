---
import IPv4Calculator from './IPv4Calculator.astro';
import VisualSplitter from './VisualSplitter.astro';
import KubernetesPlanner from './KubernetesPlanner.astro';
import IPv6Calculator from './IPv6Calculator.astro';
import SubnetGuide from './SubnetGuide.astro';
import NavBar from './NavBar.astro';
import { translations, type SupportedLanguage } from '../utils/i18n';

interface Props {
  activeTab: 'ipv4' | 'splitter' | 'k8s' | 'ipv6';
  defaultCloud?: 'standard' | 'aws' | 'azure' | 'gcp';
  navPath?: string;
  lang?: SupportedLanguage;
}

const { 
  activeTab, 
  defaultCloud = "standard",
  navPath = activeTab,
  lang = "en"
} = Astro.props;

const t = translations[lang] || translations.en;
const introData = t.intro[activeTab] || t.intro.ipv4;
const langPrefix = lang === 'en' ? '' : `/${lang}`;
---

<div class="app-shell">
  <!-- Top Bar navigation -->
  <NavBar path={navPath} lang={lang} />

  <!-- Main section -->
  <main>
    <!-- Heading section -->
    <section class="intro" aria-labelledby="page-title">
      <div class="eyebrow">{introData.eyebrow}</div>
      <h1 id="page-title">{introData.title}</h1>
      <p class="lede">{introData.lede}</p>
    </section>

    <!-- Content panels -->
    <section aria-label="Subnet utility workspace">
      {activeTab === 'ipv4' && <IPv4Calculator defaultCloud={defaultCloud} />}
      {activeTab === 'splitter' && <VisualSplitter />}
      {activeTab === 'k8s' && <KubernetesPlanner />}
      {activeTab === 'ipv6' && <IPv6Calculator />}
    </section>

    <!-- General detailed guide content -->
    <SubnetGuide lang={lang} />
  </main>

  <!-- Footer -->
  <footer>
    <span>{t.footer.tagline}</span>
    <div class="footer-links">
      <a href={`${langPrefix}/about`}>{t.footer.about}</a>
      <a href={`${langPrefix}/contact`}>{t.footer.contact}</a>
      <a href={`${langPrefix}/privacy`}>{t.footer.privacy}</a>
      <a href={`${langPrefix}/terms`}>{t.footer.terms}</a>
      <a href={`${langPrefix}/faq`}>{t.footer.faq}</a>
    </div>
    <span>{t.footer.noData}</span>
  </footer>
</div>
