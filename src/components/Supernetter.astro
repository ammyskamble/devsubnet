---
import { toolsI18n } from '../utils/tools-i18n';
import type { SupportedLanguage } from '../utils/i18n';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const su = (toolsI18n[lang] || toolsI18n.en).supernet;
---
<div class="calculator-layout" data-supernet-i18n={JSON.stringify(su)}>
  <!-- Left Column: Input -->
  <div class="calculator-panel">
    <div class="panel-heading">
      <div>
        <span class="step">{su.step1}</span>
        <h2>{su.title}</h2>
      </div>
      <span class="live-label">{su.badge}</span>
    </div>

    <div class="input-row">
      <label for="supernet-input">{su.inputLabel}</label>
      <textarea id="supernet-input" rows="6" style="background-color: var(--bg-input); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem 1rem; font-family: var(--font-mono); font-size: 0.9rem; color: var(--text-primary); outline: none; resize: vertical;">192.168.0.0/24
192.168.1.0/24
192.168.2.0/24
192.168.3.0/24</textarea>
    </div>

    <div class="quick-row">
      <button type="button" id="btn-run-supernet" class="subtool-btn" style="border-color: var(--accent-highlight); color: var(--accent-highlight);">{su.btnAggregate}</button>
      <button type="button" id="btn-clear-supernet" class="subtool-btn">{su.btnClear}</button>
    </div>

    <div class="error-banner" id="supernet-error" role="alert">
      <span>{su.errorInvalid}</span>
    </div>
  </div>

  <!-- Right Column: Results -->
  <div class="insight-panel">
    <div class="calculator-panel" style="gap: 1.5rem;">
      <div>
        <span class="aside-kicker">{su.asideKicker}</span>
        <h2>{su.asideTitle}</h2>
      </div>
      <p class="aside-copy">
        {su.asideDesc}
      </p>

      <!-- BGP Bounding Supernet Result -->
      <div id="bgp-supernet-card" style="background: rgba(56, 189, 248, 0.05); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 0.5rem; display: none;">
        <h3 style="font-size: 0.85rem; text-transform: uppercase; font-family: var(--font-display); color: var(--accent-network, #38bdf8); margin-bottom: 0.75rem; font-weight: bold; letter-spacing: 0.05em;">{su.bgpCardTitle}</h3>
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <span style="font-size: 0.82rem; color: var(--text-secondary);">{su.supernetCidrLabel}</span>
            <strong id="bgp-supernet-cidr" style="font-family: var(--font-mono); font-size: 1.15rem; color: var(--text-primary);">192.168.0.0/22</strong>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <span style="font-size: 0.82rem; color: var(--text-secondary);">{su.ipRangeLabel}</span>
            <span id="bgp-supernet-range" style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-primary);">192.168.0.0 - 192.168.3.255</span>
          </div>
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <span style="font-size: 0.82rem; color: var(--text-secondary);">{su.efficiencyLabel}</span>
            <span id="bgp-supernet-efficiency" style="font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-primary);">50.0% (512 / 1024 IPs)</span>
          </div>
        </div>
      </div>

      <div class="guide-table-wrapper">
        <table class="guide-table">
          <thead>
            <tr>
              <th>{su.thCidr}</th>
              <th>{su.thRange}</th>
            </tr>
          </thead>
          <tbody id="supernet-table-body">
            <tr><td colspan="2" style="text-align:center;color:var(--text-muted); font-family:var(--font-sans);">{su.initialPrompt}</td></tr>
          </tbody>
        </table>
      </div>
      <div class="export-panel">
        <div class="code-wrapper">
          <div class="code-copy-overlay">
            <button class="copy-button" type="button" id="copy-supernet-code" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">{su.copyCode}</button>
          </div>
          <pre><code id="supernet-code-output"># Summary route export</code></pre>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { validateIPv4, ip2Long, long2Ip } from '../utils/subnetMath';

  function initSupernetter() {
    const input = document.getElementById('supernet-input') as HTMLTextAreaElement;
    const runBtn = document.getElementById('btn-run-supernet') as HTMLButtonElement;
    const clearBtn = document.getElementById('btn-clear-supernet') as HTMLButtonElement;
    const tableBody = document.getElementById('supernet-table-body') as HTMLTableSectionElement;
    const codeOutput = document.getElementById('supernet-code-output') as HTMLElement;
    const copyBtn = document.getElementById('copy-supernet-code') as HTMLButtonElement;
    const errorBanner = document.getElementById('supernet-error');

    if (!input || !runBtn || !tableBody) return;

    const layoutContainer = document.querySelector('.calculator-layout[data-supernet-i18n]') as HTMLElement;
    let i18n = {
      initialPrompt: 'Enter CIDR blocks and click Aggregate.',
      copyCode: 'Copy',
      copied: 'Copied!'
    };
    if (layoutContainer && layoutContainer.dataset.supernetI18n) {
      try {
        i18n = { ...i18n, ...JSON.parse(layoutContainer.dataset.supernetI18n) };
      } catch (e) {}
    }

    function parseBlock(line: string): { network: number; cidr: number } | null {
      const t = line.trim();
      if (!t) return null;
      const slash = t.lastIndexOf('/');
      if (slash === -1) return null;
      const ip = t.slice(0, slash).trim();
      const cidr = parseInt(t.slice(slash + 1), 10);
      if (!validateIPv4(ip) || isNaN(cidr) || cidr < 0 || cidr > 32) return null;
      const mask = cidr === 0 ? 0 : (~0 << (32 - cidr)) >>> 0;
      return { network: (ip2Long(ip) & mask) >>> 0, cidr };
    }

    function run() {
      errorBanner?.classList.remove('show');
      const blocks: { network: number; cidr: number }[] = [];
      let valid = true;

      input.value.split('\n').forEach(line => {
        const b = parseBlock(line);
        if (b) blocks.push(b);
        else if (line.trim()) valid = false;
      });

      if (!valid || blocks.length === 0) {
        errorBanner?.classList.add('show');
        return;
      }

      blocks.sort((a, b) => a.network - b.network || a.cidr - b.cidr);

      // 1. Calculate Smallest Bounding Supernet
      const minStart = Math.min(...blocks.map(b => b.network));
      const maxEnd = Math.max(...blocks.map(b => b.network + Math.pow(2, 32 - b.cidr) - 1));
      const totalInputIps = blocks.reduce((sum, b) => sum + Math.pow(2, 32 - b.cidr), 0);

      let boundingCidr = 32 - Math.ceil(Math.log2(maxEnd - minStart + 1));
      if (boundingCidr < 0) boundingCidr = 0;
      let boundingNetwork = 0;
      while (boundingCidr >= 0) {
        const mask = boundingCidr === 0 ? 0 : (~0 << (32 - boundingCidr)) >>> 0;
        boundingNetwork = (minStart & mask) >>> 0;
        const end = boundingNetwork + Math.pow(2, 32 - boundingCidr) - 1;
        if (end >= maxEnd) {
          break;
        }
        boundingCidr--;
      }

      const boundingEnd = boundingNetwork + Math.pow(2, 32 - boundingCidr) - 1;
      const boundingSize = Math.pow(2, 32 - boundingCidr);
      const efficiency = (totalInputIps / boundingSize) * 100;

      // Update Bounding Supernet UI Elements
      const bgpCard = document.getElementById('bgp-supernet-card');
      const bgpCidr = document.getElementById('bgp-supernet-cidr');
      const bgpRange = document.getElementById('bgp-supernet-range');
      const bgpEfficiency = document.getElementById('bgp-supernet-efficiency');

      if (bgpCard && bgpCidr && bgpRange && bgpEfficiency) {
        bgpCidr.innerText = `${long2Ip(boundingNetwork)}/${boundingCidr}`;
        bgpRange.innerText = `${long2Ip(boundingNetwork)} - ${long2Ip(boundingEnd)}`;
        bgpEfficiency.innerText = `${efficiency.toFixed(1)}% (${totalInputIps.toLocaleString()} / ${boundingSize.toLocaleString()} IPs)`;
        bgpCard.style.display = 'block';
      }

      // 2. Collapse contiguous blocks (existing algorithm)
      let aggregated = blocks.map(b => ({ ...b }));
      let changed = true;
      while (changed) {
        changed = false;
        const next: { network: number; cidr: number }[] = [];
        for (let i = 0; i < aggregated.length; i++) {
          const a = aggregated[i];
          if (i + 1 < aggregated.length) {
            const b = aggregated[i + 1];
            const parentCidr = a.cidr - 1;
            const parentStep = Math.pow(2, 32 - parentCidr);
            if (a.cidr === b.cidr && a.cidr > 0 && (a.network % parentStep === 0) && b.network === a.network + Math.pow(2, 32 - a.cidr)) {
              next.push({ network: a.network, cidr: parentCidr });
              i++;
              changed = true;
              continue;
            }
          }
          next.push(a);
        }
        aggregated = next;
      }

      let html = '';
      aggregated.forEach(a => {
        const end = a.network + Math.pow(2, 32 - a.cidr) - 1;
        html += `<tr><td><strong>${long2Ip(a.network)}/${a.cidr}</strong></td><td>${long2Ip(a.network)} - ${long2Ip(end)}</td></tr>`;
      });
      tableBody.innerHTML = html || '<tr><td colspan="2" style="text-align:center;color:var(--text-muted);">No results.</td></tr>';

      if (codeOutput) {
        const bNet = long2Ip(boundingNetwork);
        const bMask = long2Ip(boundingCidr === 0 ? 0 : (~0 << (32 - boundingCidr)) >>> 0);
        let code = `# BGP Route Summarization & Aggregate Configs\n`;
        code += `# Cisco IOS BGP aggregate:\n`;
        code += `router bgp 65001\n`;
        code += `  aggregate-address ${bNet} ${bMask} summary-only\n\n`;
        code += `# Juniper Static Route for advertisement:\n`;
        code += `set routing-options static route ${bNet}/${boundingCidr} discard\n\n`;
        code += `# Cisco static null route to prevent routing loops:\n`;
        code += `ip route ${bNet} ${bMask} Null0\n\n`;
        code += `# Individual collapsed summary routes:\n`;
        aggregated.forEach(a => {
          code += `ip route ${long2Ip(a.network)}/${a.cidr} Null0\n`;
        });
        codeOutput.innerText = code.trim();
      }
    }

    runBtn.onclick = run;
    if (clearBtn) {
      clearBtn.onclick = () => {
        input.value = '';
        tableBody.innerHTML = `<tr><td colspan="2" style="text-align:center;color:var(--text-muted); font-family:var(--font-sans);">${i18n.initialPrompt}</td></tr>`;
        if (codeOutput) codeOutput.innerText = '# Summary route export';
        const bgpCard = document.getElementById('bgp-supernet-card');
        if (bgpCard) bgpCard.style.display = 'none';
      };
    }
    if (copyBtn) {
      copyBtn.onclick = async () => {
        if (!codeOutput) return;
        await navigator.clipboard.writeText(codeOutput.innerText);
        copyBtn.innerText = i18n.copied;
        copyBtn.classList.add('copied');
        setTimeout(() => { copyBtn.innerText = i18n.copyCode; copyBtn.classList.remove('copied'); }, 2000);
      };
    }
  }

  document.addEventListener('astro:page-load', initSupernetter);
  initSupernetter();
</script>

<style>
  .subtool-btn {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .subtool-btn:hover { color: var(--text-primary); background-color: var(--border-color); }
</style>
