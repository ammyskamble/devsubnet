---import Footer from '../components/Footer.astro';
import { type SupportedLanguage } from '../utils/i18n';

import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';

const lang = (Astro.currentLocale as SupportedLanguage) || 'en';
---

<Layout lang={lang}
  title="Subnet Mask Cheat Sheet – Complete Subnetting Reference Table | DevSubnet"
  description="Complete subnet mask cheat sheet covering prefix lengths from /0 to /32 with subnet masks, wildcard masks, total addresses, and usable hosts. Free networking resource."
>
  <div class="app-shell">
    <NavBar lang={lang} path="cheatsheet" />
    <main>
      <section class="intro" aria-labelledby="page-title">
        <div class="eyebrow">REFERENCE / SUBNET CHEAT SHEET</div>
        <h1 id="page-title">Subnet Mask Cheat Sheet</h1>
        <p class="lede">Every prefix length from /0 to /32 with its subnet mask, wildcard mask, total addresses, and usable host count — the complete quick-reference table for network engineers.</p>
      </section>

      <section class="calculator-panel" style="gap: 1.5rem; margin-bottom: 2.5rem;">
        <div class="panel-heading">
          <div><span class="step">01</span><h2>Complete Prefix Reference</h2></div>
          <span class="live-label">/0 – /32</span>
        </div>

        <!-- Interactive Search Filter -->
        <div style="margin-bottom: 0.25rem; max-width: 450px;">
          <label for="cidr-filter" style="display: block; font-family: var(--font-display); font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.35rem;">Search / Filter Reference Table</label>
          <div class="ip-input" style="padding: 0.5rem 0.75rem; font-size: 0.95rem; display: flex; align-items: center;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.5rem; color: var(--text-muted);"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input 
              type="text" 
              id="cidr-filter" 
              placeholder="Filter by prefix, mask, or hosts (e.g., /24, 255, 1024)..." 
              autocomplete="off" 
              style="background: none; border: none; color: var(--text-primary); outline: none; width: 100%; font-family: var(--font-sans);"
            />
          </div>
        </div>

        <div class="guide-table-wrapper">
          <table class="guide-table">
            <thead>
              <tr><th>CIDR</th><th>Subnet Mask</th><th>Wildcard</th><th>Total IPs</th><th>Usable Hosts</th></tr>
            </thead>
            <tbody>
              <tr><td>/32</td><td>255.255.255.255</td><td>0.0.0.0</td><td>1</td><td>1</td></tr>
              <tr><td>/31</td><td>255.255.255.254</td><td>0.0.0.1</td><td>2</td><td>2</td></tr>
              <tr><td>/30</td><td>255.255.255.252</td><td>0.0.0.3</td><td>4</td><td>2</td></tr>
              <tr><td>/29</td><td>255.255.255.248</td><td>0.0.0.7</td><td>8</td><td>6</td></tr>
              <tr><td>/28</td><td>255.255.255.240</td><td>0.0.0.15</td><td>16</td><td>14</td></tr>
              <tr><td>/27</td><td>255.255.255.224</td><td>0.0.0.31</td><td>32</td><td>30</td></tr>
              <tr><td>/26</td><td>255.255.255.192</td><td>0.0.0.63</td><td>64</td><td>62</td></tr>
              <tr><td>/25</td><td>255.255.255.128</td><td>0.0.0.127</td><td>128</td><td>126</td></tr>
              <tr><td>/24</td><td>255.255.255.0</td><td>0.0.0.255</td><td>256</td><td>254</td></tr>
              <tr><td>/23</td><td>255.255.254.0</td><td>0.0.1.255</td><td>512</td><td>510</td></tr>
              <tr><td>/22</td><td>255.255.252.0</td><td>0.0.3.255</td><td>1,024</td><td>1,022</td></tr>
              <tr><td>/21</td><td>255.255.248.0</td><td>0.0.7.255</td><td>2,048</td><td>2,046</td></tr>
              <tr><td>/20</td><td>255.255.240.0</td><td>0.0.15.255</td><td>4,096</td><td>4,094</td></tr>
              <tr><td>/19</td><td>255.255.224.0</td><td>0.0.31.255</td><td>8,192</td><td>8,190</td></tr>
              <tr><td>/18</td><td>255.255.192.0</td><td>0.0.63.255</td><td>16,384</td><td>16,382</td></tr>
              <tr><td>/17</td><td>255.255.128.0</td><td>0.0.127.255</td><td>32,768</td><td>32,766</td></tr>
              <tr><td>/16</td><td>255.255.0.0</td><td>0.0.255.255</td><td>65,536</td><td>65,534</td></tr>
              <tr><td>/15</td><td>255.254.0.0</td><td>0.1.255.255</td><td>131,072</td><td>131,070</td></tr>
              <tr><td>/14</td><td>255.252.0.0</td><td>0.3.255.255</td><td>262,144</td><td>262,142</td></tr>
              <tr><td>/13</td><td>255.248.0.0</td><td>0.7.255.255</td><td>524,288</td><td>524,286</td></tr>
              <tr><td>/12</td><td>255.240.0.0</td><td>0.15.255.255</td><td>1,048,576</td><td>1,048,574</td></tr>
              <tr><td>/11</td><td>255.224.0.0</td><td>0.31.255.255</td><td>2,097,152</td><td>2,097,150</td></tr>
              <tr><td>/10</td><td>255.192.0.0</td><td>0.63.255.255</td><td>4,194,304</td><td>4,194,302</td></tr>
              <tr><td>/9</td><td>255.128.0.0</td><td>0.127.255.255</td><td>8,388,608</td><td>8,388,606</td></tr>
              <tr><td>/8</td><td>255.0.0.0</td><td>0.255.255.255</td><td>16,777,216</td><td>16,777,214</td></tr>
              <tr><td>/7</td><td>254.0.0.0</td><td>1.255.255.255</td><td>33,554,432</td><td>33,554,430</td></tr>
              <tr><td>/6</td><td>252.0.0.0</td><td>3.255.255.255</td><td>67,108,864</td><td>67,108,862</td></tr>
              <tr><td>/5</td><td>248.0.0.0</td><td>7.255.255.255</td><td>134,217,728</td><td>134,217,726</td></tr>
              <tr><td>/4</td><td>240.0.0.0</td><td>15.255.255.255</td><td>268,435,456</td><td>268,435,454</td></tr>
              <tr><td>/3</td><td>224.0.0.0</td><td>31.255.255.255</td><td>536,870,912</td><td>536,870,910</td></tr>
              <tr><td>/2</td><td>192.0.0.0</td><td>63.255.255.255</td><td>1,073,741,824</td><td>1,073,741,822</td></tr>
              <tr><td>/1</td><td>128.0.0.0</td><td>127.255.255.255</td><td>2,147,483,648</td><td>2,147,483,646</td></tr>
              <tr><td>/0</td><td>0.0.0.0</td><td>255.255.255.255</td><td>4,294,967,296</td><td>4,294,967,294</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="guide-section">
        <div class="guide-sticky"><h2>How to <em>use</em> Subnetting</h2></div>
        <div class="guide-content">
          <div class="guide-block">
            <h3>The usable host formula</h3>
            <p>Usable hosts = 2<sup>(32 − prefix)</sup> − 2. The subnet always loses two addresses: the network identifier (first) and the broadcast address (last). For example, a /24 gives 2<sup>8</sup> − 2 = 254 usable hosts.</p>
          </div>
          <div class="guide-block">
            <h3>Common special prefix lengths</h3>
            <p><strong>/30</strong> is the standard point-to-point link. <strong>/31</strong> is used in RFC 3021 point-to-point links where both addresses are usable. <strong>/32</strong> is a single host route. Everything from /24 up is used for LANs, departments, and data centers.</p>
          </div>
          <div class="guide-block">
            <h3>Try the calculator</h3>
            <p>Enter any IP and prefix in the <a href="/">IPv4 subnet calculator</a> to get instant network, broadcast, host ranges, and cloud-aware reservations for <a href="/aws-vpc-subnet-calculator">AWS</a>, <a href="/azure-vnet-subnet-calculator">Azure</a>, and <a href="/gcp-vpc-subnet-calculator">GCP</a>.</p>
          </div>
        </div>
      </section>

      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What is CIDR notation and how is it used?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "CIDR (Classless Inter-Domain Routing) notation is a compact way of representing an IP address and its associated routing prefix. It consists of an IP address, a slash character ('/'), and a decimal number indicating the number of bits allocated to the network prefix — for example, /24 implies 24 network bits."
              }
            },
            {
              "@type": "Question",
              "name": "How do I calculate subnets from an IP address?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "To calculate subnets, convert the CIDR slash notation or subnet mask to binary. Identify the network bits (marked as 1) and host bits (marked as 0). The number of subnets you can create is 2^n, where n is the number of borrowed bits. Usable hosts per subnet is 2^h - 2."
              }
            },
            {
              "@type": "Question",
              "name": "How many usable hosts are in a /24 subnet?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "A /24 subnet has 256 total IP addresses. After subtracting the network address (the first IP) and the broadcast address (the last IP), you have exactly 254 usable host IP addresses."
              }
            },
            {
              "@type": "Question",
              "name": "What is the difference between a /16 and /24 subnet?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "A /16 subnet allocates 16 bits to the network portion and 16 bits to host addresses, supporting up to 65,534 usable hosts. A /24 subnet allocates 24 bits to the network portion and 8 bits to hosts, supporting up to 254 usable hosts."
              }
            },
            {
              "@type": "Question",
              "name": "What is the usable host formula?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Usable hosts = 2^(32 − prefix) − 2. The subnet always loses two addresses: the network identifier (first) and the broadcast address (last). For example, a /24 gives 2^8 − 2 = 254 usable hosts."
              }
            }
          ]
        }
      </script>
    </main>
    <Footer lang={lang} />
  </div>

  <style is:global>
    .guide-table tbody tr {
      cursor: pointer;
      transition: background-color var(--transition-fast);
    }
    .guide-table tbody tr:hover {
      background-color: rgba(66, 133, 244, 0.08) !important;
    }
    .guide-table tbody tr td:first-child {
      font-weight: bold;
      color: var(--accent-network);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .guide-table tbody tr td:first-child::after {
      content: "⚡ Use";
      font-size: 0.7rem;
      font-family: var(--font-sans);
      opacity: 0;
      background-color: var(--accent-network);
      color: white;
      padding: 2px 6px;
      border-radius: 4px;
      transition: opacity var(--transition-fast);
    }
    .guide-table tbody tr:hover td:first-child::after {
      opacity: 1;
    }
  </style>

  <script>
    function initCidrCheatSheet() {
      const filterInput = document.getElementById('cidr-filter') as HTMLInputElement;
      const tableRows = document.querySelectorAll('.guide-table tbody tr');

      if (!filterInput) return;

      filterInput.addEventListener('input', () => {
        const query = filterInput.value.toLowerCase().trim();
        tableRows.forEach(row => {
          const text = row.textContent?.toLowerCase() || '';
          if (text.includes(query)) {
            (row as HTMLElement).style.display = '';
          } else {
            (row as HTMLElement).style.display = 'none';
          }
        });
      });

      tableRows.forEach(row => {
        (row as HTMLElement).onclick = () => {
          const firstCell = row.querySelector('td');
          if (!firstCell) return;
          const cidrText = firstCell.childNodes[0].textContent?.trim() || '';
          const cidrVal = parseInt(cidrText.replace('/', ''), 10);
          if (isNaN(cidrVal)) return;

          // Choose appropriate RFC 1918 base IP depending on size
          let defaultIp = '192.168.1.0';
          if (cidrVal <= 15) {
            defaultIp = '10.0.0.0';
          } else if (cidrVal <= 23) {
            defaultIp = '172.16.0.0';
          }

          window.location.href = `/?ip=${defaultIp}&cidr=${cidrVal}`;
        };
      });
    }

    document.addEventListener('astro:page-load', initCidrCheatSheet);
    initCidrCheatSheet();
  </script>
</Layout>
