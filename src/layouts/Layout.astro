---
import { ClientRouter } from "astro:transitions";
import {
  getHrefLangAlternates,
  languages,
  type SupportedLanguage,
} from "../utils/i18n";
import PrivacySettings from "../components/PrivacySettings.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  lang?: SupportedLanguage;
  noindex?: boolean;
}

const {
  lang = (Astro.currentLocale as SupportedLanguage) || "en",
  title = "Online IP Subnet Calculator & CIDR Calculator | DevSubnet",
  description = "Free online IP subnet calculator and CIDR calculator online. Calculate network ranges, subnet masks, broadcast addresses, usable hosts, and cloud VPC reservations for AWS, Azure, and GCP instantly.",
  canonicalUrl = Astro.url.href,
  noindex = false,
} = Astro.props;

const hreflangLinks = getHrefLangAlternates(Astro.url.pathname);
const currentLangInfo = languages[lang] || languages.en;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Critical Local Font Preloads (Zero CDN Latency, Zero Layout Shift) -->
    <link
      rel="preload"
      href="/fonts/inter-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/outfit-latin-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Resilient Non-blocking Google Analytics & Telemetry (Safe from Ad-blocker Rejections) -->
    <script is:inline>
      try {
        const consent = localStorage.getItem("devsubnet-analytics-consent");
        if (consent === "false") {
          window['ga-disable-G-F2T4WC5Y9V'] = true;
        } else {
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            try {
              window.dataLayer.push(arguments);
            } catch (e) {
              // Silently suppress telemetry exceptions
            }
          }
          window.gtag = gtag;

          function initAnalytics() {
            try {
              const gaScript = document.createElement("script");
              gaScript.async = true;
              gaScript.defer = true;
              gaScript.src = "https://www.googletagmanager.com/gtag/js?id=G-F2T4WC5Y9V";
              gaScript.onerror = function () {
                // Gracefully swallow ad-blocker (uBlock, Brave, Pi-hole) net::ERR_BLOCKED_BY_CLIENT
              };
              document.head.appendChild(gaScript);

              gtag("js", new Date());
              gtag("config", "G-F2T4WC5Y9V", {
                transport_url: window.location.origin + "/api/collect"
              });
            } catch (e) {
              // Silently swallow analytics init errors
            }
          }

          // Perf Fix C: Defer until after load event, then yield to idle time
          window.addEventListener('load', function() {
            if ("requestIdleCallback" in window) {
              requestIdleCallback(initAnalytics, { timeout: 4000 });
            } else {
              setTimeout(initAnalytics, 2000);
            }
          }, { once: true });
        }
      } catch (e) {
        // Telemetry fail-safe
      }
    </script>

    <!-- PWA Offline Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') {
          navigator.serviceWorker.getRegistrations().then(regs => {
            for (let r of regs) r.unregister();
          });
          if ('caches' in window) {
            caches.keys().then(keys => keys.forEach(k => caches.delete(k)));
          }
        } else {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js')
              .then(reg => console.log('PWA Service Worker registered:', reg.scope))
              .catch(err => console.error('PWA Service Worker registration failed:', err));
          });
        }
      }
    </script>

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0d111c" />
    <meta name="generator" content={Astro.generator} />

    <!-- Multi-Language Hreflang Tags for International SEO -->
    {
      hreflangLinks.map((item) => (
        <link rel="alternate" hreflang={item.lang} href={item.href} />
      ))
    }

    <!-- Favicon & Web App Icons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="devsubnet.com" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="devsubnet.com" />
    <meta property="og:locale" content={currentLangInfo.locale} />
    <meta property="og:image" content={`${Astro.url.origin}/og-image.png`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content={`${Astro.url.origin}/og-image.png`}
    />

    <!-- Anti-Flash Theme Script (runs inline & on astro:after-swap) -->
    <script is:inline>
      function applyTheme() {
        const theme =
          localStorage.getItem("devsubnet-theme") ||
          (window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark");
        document.documentElement.setAttribute("data-theme", theme);
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <!-- WebApplication / SoftwareApplication Schema JSON-LD for Rich Results -->
    {!noindex && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebApplication",
          name: "DevSubnet - Online IP Subnet Calculator & CIDR Calculator",
          url: "https://devsubnet.com/",
          inLanguage: lang,
          applicationCategory: "UtilitiesApplication",
          applicationSubCategory: "Networking & Cloud Infrastructure",
          operatingSystem:
            "All (Web Browser, Linux, macOS, Windows, iOS, Android)",
          browserRequirements:
            "Requires JavaScript. Compatible with all modern browsers.",
          description: description,
          author: {
            "@type": "Organization",
            name: "DevSubnet",
            url: "https://devsubnet.com/",
          },
          publisher: {
            "@type": "Organization",
            name: "DevSubnet",
            url: "https://devsubnet.com/",
          },
          offers: {
            "@type": "Offer",
            price: "0",
            priceCurrency: "USD",
            availability: "https://schema.org/InStock",
          },
          aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: "4.9",
            ratingCount: "148",
            bestRating: "5",
            worstRating: "1",
          },
          featureList: [
            "Online IP subnet calculator & CIDR calculator online",
            "IPv4 & IPv6 subnet calculation with binary bitwise visualization",
            "IP CIDR calculator with slash notation to subnet mask converter",
            "Cloud-aware reserved IP calculation for AWS VPC, Azure VNet, and GCP",
            "Visual Subnet Splitter with live partition tree",
            "Terraform cidrsubnet() planner and HCL exporter",
            "Kubernetes CIDR calculator (Cilium, Calico, AWS VPC CNI, Azure CNI)",
            "VLSM hierarchical subnet segmenter",
            "Subnet overlap conflict detector",
            "CIDR supernetting and route aggregation",
            "Complete CIDR cheat sheet reference",
          ],
        })}
      />
    )}
  </head>
  <body>
    <!-- Background Decor Blobs -->
    <div class="bg-decor" aria-hidden="true">
      <div class="bg-blob bg-blob-1"></div>
      <div class="bg-blob bg-blob-2"></div>
      <div class="bg-blob bg-blob-3"></div>
      <div class="bg-blob bg-blob-4"></div>
    </div>

    <slot />
    <PrivacySettings />
  </body>
</html>
